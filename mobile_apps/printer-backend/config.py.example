# ============================================================
# config.py — HN 云打印配置文件（模板）
# 使用前复制为 config.py 并填入真实值
#   cp config.py.example config.py
# config.py 已排除在 git 外，不会提交到仓库。
# ============================================================

# -------- 微信小程序配置 --------
# 从小程序管理后台获取
WECHAT_APPID = "你的微信小程序 AppID"
WECHAT_APPSECRET = "你的微信小程序 AppSecret"

# -------- 服务器密钥（用于签名登录 token）--------
SECRET_KEY = "生成一个随机字符串，例如 python -c 'import secrets; print(secrets.token_hex(16))'"

# -------- 管理员 OpenID 列表（用于权限控制）--------
# 这些 openid 对应的用户为管理员，可查看全员打印排行榜
ADMIN_OPENIDS = [
    "你的微信 openid",
]
# 超级管理员 openid（唯一，可创建 admin 类型的许可密钥）
SUPER_ADMIN_OPENID = "你的微信 openid"

# -------- 打印机客户端配置 --------
# 本地测试时使用 http://127.0.0.1:5000
# 部署到云服务器后改为你的域名，例如:
#   CLOUD_API_URL = "https://print.your-domain.com"
#   WEBSOCKET_URL = "https://print.your-domain.com"
PUBLIC_BASE_URL = "http://127.0.0.1:5000"
CLOUD_API_URL = "http://127.0.0.1:5000"
WEBSOCKET_URL = "http://127.0.0.1:5000"
# 客户端认证 token
TOKEN = "生成一个随机字符串，与本地打印工具 print_config.json 的 cloud_token 保持一致"
# Windows 打印机名称（与控制面板中显示的完全一致）
PRINTER_NAME = ""

# -------- 安装包分发：COS 下载码（2026-11）--------
# 背景：桶不再是公有读 —— 客户端要更新，先拿超管创建的 8 位下载码换一枚单次令牌，
# 服务端再 302 到 COS 预签名地址。普通用户一律走 GitHub Release（免费、不限量）。
# 这里填**只读**子账号（策略只给 cos:GetObject），绝不填有写权限的主账号密钥。
# 不填 = 加速通道不可用：/api/dl/grant 返回 503，客户端自动回退 GitHub（缺配置不会崩）。
UPDATE_COS_SECRET_ID = ""
UPDATE_COS_SECRET_KEY = ""
UPDATE_COS_BUCKET = "hn-printer-updates-1324480550"
UPDATE_COS_REGION = "ap-guangzhou"
UPDATE_COS_URL_TTL = 180                      # 预签名有效期（秒）；70 MB 安装包 180s 够用

UPDATE_OBJECT_TEMPLATE = "h_n-printer_setup_{version}.exe"   # COS 对象名模板
UPDATE_DL_BASE_URL = "https://hn-space.cn"                   # /dl/<token> 的对外前缀
UPDATE_DL_DAILY_QUOTA = 30                    # 加速通道每日放行次数，超出只放行 GitHub
UPDATE_GITHUB_RELEASE_URL = "https://github.com/huonanwholovecomputer/h_n-printer/releases/latest"
