/**app.wxss** — Apple Liquid Glass Design System for HN 云打印 */

/* ============================================================
   1. Design Tokens — Liquid Glass (iOS 26+) color & spacing system
   ============================================================ */

page {
  /* iOS system colors */
  --blue: #007AFF;
  --blue-light: #409CFF;
  --blue-dark: #0055CC;
  --green: #34C759;
  --orange: #FF9500;
  --red: #FF3B30;
  --pink: #FF2D55;
  --purple: #AF52DE;
  --gray: #8E8E93;
  --gray2: #AEAEB2;
  --gray3: #C7C7CC;
  --gray4: #D1D1D6;
  --gray5: #E5E5EA;
  --gray6: #F2F2F7;

  /* Semantic colors — soft gradient background (liquid glass "sampling" surface) */
  --bg-primary: #F2F2F7;
  --bg-primary-gradient: linear-gradient(175deg, #F8F8FC 0%, #EDEDF3 40%, #E8E8F0 100%);
  --bg-card: #FFFFFF;
  --bg-elevated: #F2F2F7;
  --text-primary: #000000;
  --text-secondary: #3C3C43;
  --text-tertiary: #8E8E93;
  --text-quaternary: #C7C7CC;
  --separator: rgba(60, 60, 67, 0.10);
  --separator-strong: rgba(60, 60, 67, 0.15);

  /* ═══ Liquid Glass Material Tokens ═══ */
  /* 平衡点：既能让背景过渡透过，卡片在浅色背景上也有足够辨识度 */
  --glass-light:   rgba(255, 255, 255, 0.35);
  --glass-regular: rgba(255, 255, 255, 0.58);
  --glass-heavy:   rgba(255, 255, 255, 0.76);
  /* Rim highlight — 顶部内高光模拟玻璃折射（浅/深色分别取值） */
  --glass-rim:        inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  --glass-rim-strong: inset 0 1.5rpx 0 rgba(255, 255, 255, 0.95);
  /* Glass shadow — 外阴影模拟悬浮深度（增强后卡片层次更分明） */
  --glass-shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.08), 0 0 0 0.5rpx rgba(0, 0, 0, 0.04);
  --glass-shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.10), 0 0 0 0.5rpx rgba(0, 0, 0, 0.05);
  --glass-shadow-lg: 0 8rpx 30rpx rgba(0, 0, 0, 0.12), 0 0 0 1rpx rgba(0, 0, 0, 0.04);
  /* Glass border — 极细描边勾勒玻璃轮廓 */
  --glass-border: 0.5rpx solid rgba(255, 255, 255, 0.4);
  --glass-border-dark: 0.5rpx solid rgba(60, 60, 67, 0.07);

  /* Legacy shadow tokens (still used in some components) */
  --shadow-sm: 0 1rpx 4rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);

  /* Typography scale */
  --font-system: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text",
    "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  --font-mono: "SF Mono", "Menlo", "Monaco", "Courier New", monospace;

  /* Spacing scale */
  --space-xs: 8rpx;
  --space-sm: 12rpx;
  --space-md: 16rpx;
  --space-lg: 20rpx;
  --space-xl: 24rpx;
  --space-2xl: 32rpx;

  /* Radii — slightly larger for Liquid Glass aesthetic */
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 22rpx;
  --radius-xl: 28rpx;

  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  font-family: var(--font-system);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* ============================================================
   2. Typography
   ============================================================ */

/* Display — large titles */
.display-large {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
}
.display-medium {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.01em;
}

/* Title */
.title-large {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.25;
  letter-spacing: 0;
}
.title-medium {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

/* Body */
.body-regular {
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
}
.body-small {
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.45;
  color: var(--text-tertiary);
}

/* Caption */
.caption {
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
  color: var(--text-tertiary);
}
.caption-mono {
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

/* ============================================================
   3. Interactive Feedback — Apple's instant touch-down response
   ============================================================ */

/* Scale-down on press (instant, no delay) */
.tap-active {
  transform: scale(0.97);
  /* 按下瞬时缩小（禁用过渡），松手后由各按钮基类的 transform transition 平滑恢复。
     与 .stepper-hover 同理：避免 setData 重置 hover 状态导致缩小动画播放到一半被中断。 */
  transition: none;
}

/* 生成密钥按钮按压缩放（原 wxml hover-class="generate-hover" 指向未定义类，
   按下无任何反馈；补上与 tap-active 一致的"按下瞬时缩小"行为） */
.generate-hover {
  transform: scale(0.97);
  transition: none;
}

/* Subtle highlight (for list items) */
.tap-highlight {
  background-color: rgba(0, 0, 0, 0.04);
  transition: background-color 0.1s ease;
}

/* ============================================================
   4. Cards — Liquid Glass containers (iOS 26 style)
   ============================================================ */

/* Glass card — solid color surface, no backdrop sampling needed */
.glass-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  width: 100%;
  box-sizing: border-box;
}

.glass-card-elevated {
  background: var(--bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--glass-shadow-md), var(--glass-rim);
  border: 1rpx solid var(--separator-strong);
  width: 100%;
  box-sizing: border-box;
}

/* Legacy card aliases — remapped to solid color */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  width: 100%;
  box-sizing: border-box;
  transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}

.card-elevated {
  background: var(--bg-elevated);
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: var(--glass-shadow-md), var(--glass-rim);
  border: 1rpx solid var(--separator-strong);
  width: 100%;
  box-sizing: border-box;
  transition: background 0.4s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}

/* Card entrance — layout expand (ease-out) + visual spring in (overshoot), dual animation */
@keyframes cardExpand {
  from {
    max-height: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
  }
  to {
    max-height: 2000rpx;
    margin-bottom: 12rpx;
    padding-top: 20rpx;
    padding-bottom: 20rpx;
  }
}
/* 统一入场：向上淡入（元素从下方滑入 + 淡入） */
@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.card-entering {
  animation:
    cardExpand 0.35s 0.25s ease-out both,
    cardFadeIn 0.5s 0.25s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}
/* 页面首次入场：仅向上淡入（去掉 cardExpand 的 max-height 占位展开，避免卡片"下滑"占位动画） */
.card-entering-fade {
  animation: cardFadeIn 0.5s 0.25s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* Card remove — fade out + collapse in one go */
@keyframes cardRemove {
  0% {
    max-height: 2000rpx;
    margin-bottom: 12rpx;
    padding-top: 20rpx;
    padding-bottom: 20rpx;
    opacity: 1;
    transform: scale(1);
  }
  30% {
    max-height: 2000rpx;
    margin-bottom: 12rpx;
    padding-top: 20rpx;
    padding-bottom: 20rpx;
    opacity: 0;
    transform: scale(0.95);
  }
  100% {
    max-height: 0;
    margin-bottom: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    transform: scale(0.95);
  }
}
.card-removing {
  animation: cardRemove 0.55s ease forwards;
  pointer-events: none;
}

/* ============================================================
   5. Section Headers — iOS-style with accent bar
   ============================================================ */

.section-header {
  display: flex;
  align-items: center;
  padding: var(--space-lg) var(--space-sm) var(--space-md);
  gap: var(--space-sm);
}

.section-header-bar {
  width: 6rpx;
  height: 28rpx;
  background-color: var(--blue);
  border-radius: 3rpx;
}

.section-header-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.section-header-badge {
  margin-left: var(--space-sm);
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
  background-color: var(--blue);
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
/* Entrance — 向上淡入（与全页入场统一；延迟由 JS 层 badgeCount 控制） */
.section-header-badge.entering {
  animation: badgeEnter 0.3s ease-out both;
  opacity: 0;
  transform: translateY(16rpx);
}
@keyframes badgeEnter {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
/* Bounce — already visible, just pulse */
.section-header-badge.bouncing {
  animation: badgeBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes badgeBounce {
  0%   { transform: scale(1); }
  40%  { transform: scale(1.35); }
  100% { transform: scale(1); }
}
/* Exit — shrink to nothing */
.section-header-badge.exiting {
  animation: badgeExit 0.25s ease forwards;
}
@keyframes badgeExit {
  0%   { transform: scale(1); opacity: 1; }
  100% { transform: scale(0); opacity: 0; }
}

/* ============================================================
   6. Buttons — Apple Liquid Glass system
   Glass effect simulated via:
   - Semi-transparent gradient bg (no backdrop-filter in mini-program)
   - Bright inset top border → "light catching the glass edge"
   - Subtle shadow underneath → depth
   - Press: scale(0.97) + glass brightens
   ============================================================ */

/* ── Glass Mixin Tokens ── */
/* These are conceptual; applied inline since WXSS has no @mixin */

/* Primary — tinted liquid glass (blue) */
.btn-primary {
  width: 100%;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.90) 0%,
    rgba(0, 110, 230, 0.95) 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 26rpx 0;
  text-align: center;
  border: none;
  letter-spacing: -0.01em;
  /* Glass depth — rim highlight + lens shadow */
  box-shadow:
    0 4rpx 16rpx rgba(0, 122, 255, 0.28),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.40),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.08);
  transition: transform 0.06s cubic-bezier(0.4, 0, 0.2, 1),
              box-shadow 0.06s ease,
              filter 0.06s ease;
}
.btn-primary:active {
  transform: scale(0.97);
  filter: brightness(1.12);
  box-shadow:
    0 2rpx 8rpx rgba(0, 122, 255, 0.22),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.50);
}
.btn-primary[disabled] {
  opacity: 0.35;
  transform: none;
  filter: none;
}

/* Secondary — clear glass */
.btn-secondary {
  width: 100%;
  background: var(--glass-regular);
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid rgba(0, 122, 255, 0.18);
  border-radius: var(--radius-md);
  padding: 22rpx 0;
  text-align: center;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  transition: transform 0.06s cubic-bezier(0.4, 0, 0.2, 1),
              background-color 0.06s ease,
              box-shadow 0.06s ease;
}
.btn-secondary:active {
  transform: scale(0.97);
  background: rgba(0, 122, 255, 0.10);
  box-shadow:
    0 1rpx 4rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.95);
}

/* Destructive — red-tinted glass */
.btn-destructive {
  width: 100%;
  background: var(--glass-regular);
  color: var(--red);
  font-size: 28rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 59, 48, 0.18);
  border-radius: var(--radius-md);
  padding: 22rpx 0;
  text-align: center;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.85);
  transition: transform 0.06s cubic-bezier(0.4, 0, 0.2, 1),
              background-color 0.06s ease;
}
.btn-destructive:active {
  transform: scale(0.97);
  background: rgba(255, 59, 48, 0.10);
}

/* Small glass chip */
.btn-small {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--blue);
  background: rgba(0, 122, 255, 0.07);
  border-radius: var(--radius-sm);
  padding: 10rpx 28rpx;
  border: 1rpx solid rgba(0, 122, 255, 0.12);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  transition: transform 0.06s cubic-bezier(0.4, 0, 0.2, 1),
              background-color 0.06s ease;
}
.btn-small:active {
  transform: scale(0.95);
  background: rgba(0, 122, 255, 0.14);
}

/* ============================================================
   7. Status Badges — iOS-style compact pills
   ============================================================ */

.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  letter-spacing: 0.02em;
}
.badge-queued    { background-color: #FFF3E0; color: #E65100; }
.badge-printing  { background-color: #E3F2FD; color: #1565C0; }
.badge-sent      { background-color: #E8F5E9; color: #2E7D32; }
.badge-delivered { background-color: #E8F5E9; color: #1B5E20; }
.badge-failed    { background-color: #FFEBEE; color: #C62828; }
.badge-canceled  { background-color: var(--gray6); color: var(--gray); }

/* ============================================================
   8. Dividers & Separators
   ============================================================ */

.divider {
  height: 1rpx;
  background-color: var(--separator);
  margin: var(--space-md) 0;
}
.divider-thick {
  height: 8rpx;
  background-color: var(--bg-primary);
  margin: 0;
}

/* ============================================================
   9. Modal / Sheet — Liquid Glass backdrop + spring card
   ============================================================ */
   /* NOTE: backdrop-filter is intentionally omitted here because
      WeChat's mini-program compositor cannot reliably sample
      backdrop from GPU layers that use CSS transform (e.g. the
      custom scroll engine's translateY). The uneven-blur symptom
      (top half blur ≠ bottom half blur) is caused by partial
      layer capture. A higher-opacity solid background provides
      a uniform, reliable dimming effect instead. */

.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background-color: rgba(255, 255, 255, 0.45);
  backdrop-filter: saturate(200%) blur(44px);
  -webkit-backdrop-filter: saturate(200%) blur(44px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.modal-sheet {
  width: 540rpx;
  background-color: var(--bg-card);
  color: var(--text-primary);
  border-radius: var(--radius-xl);
  padding: 48rpx 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: sheetSpringIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-shadow: var(--shadow-lg);
}

/* Modal footer — two buttons side by side */
.modal-buttons {
  display: flex;
  width: 100%;
  gap: 24rpx;
  margin-top: 32rpx;
}
.modal-half-btn {
  flex: 1;
  width: auto;
  padding: 22rpx 0;
  font-size: 26rpx;
}

@keyframes sheetSpringIn {
  from {
    opacity: 0;
    transform: translateY(60rpx) scale(0.94);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

/* Modal close animation — mask fades, sheet shrinks */
.modal-mask.modal-closing {
  animation: fadeOut 0.18s ease forwards;
}
@keyframes fadeOut {
  from { opacity: 1; }
  to   { opacity: 0; }
}
.modal-mask.modal-closing .modal-sheet {
  animation: sheetSpringOut 0.18s ease forwards;
}
@keyframes sheetSpringOut {
  from {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  to {
    opacity: 0;
    transform: translateY(20rpx) scale(0.96);
  }
}

/* ============================================================
   10. Form Elements — iOS-style inputs & steppers
   ============================================================ */

/* Stepper (iOS-style [+]/[-]) */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-sm);
  background: var(--glass-regular);
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: var(--glass-border-dark);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  transition: transform 0.06s ease, background-color 0.06s ease, box-shadow 0.06s ease;
}
.stepper-btn:active {
  transform: scale(0.93);
  background: rgba(0, 0, 0, 0.06);
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.05);
}
.stepper-hover {
  transform: scale(0.9) !important;
  background: rgba(0, 0, 0, 0.04) !important;
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.04) !important;
  /* 关键：按下时瞬时缩小（禁用过渡），松手后基类 transition 0.06s 平滑恢复。
     解决"短按缩小动画只走一半就被打断"——缩小永远完整，反馈即时。 */
  transition: none !important;
}
.stepper-btn.stepper-disabled {
  color: var(--gray3);
}

.stepper-input {
  flex: 1;
  height: 64rpx;
  margin: 0 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  font-family: var(--font-mono);
  color: var(--text-primary);
  background-color: var(--bg-card);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--separator);
}

/* 禁用态：阻止键盘弹起但保持外观不变 */
.stepper-input[disabled] {
  opacity: 1;
  color: var(--text-primary);
  -webkit-text-fill-color: var(--text-primary);
}

/* Text input — iOS style */
.input-ios {
  flex: 1;
  height: 72rpx;
  background-color: var(--gray6);
  border: 1rpx solid transparent;
  border-radius: var(--radius-sm);
  padding: 0 var(--space-lg);
  font-size: 28rpx;
  color: var(--text-primary);
  font-family: var(--font-system);
  transition: border-color 0.2s ease, background-color 0.2s ease;
}
.input-ios::placeholder {
  color: var(--text-quaternary);
}

/* ============================================================
   11. Empty State
   ============================================================ */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-state-icon {
  width: 120rpx;
  height: 120rpx;
  background-color: rgba(0, 122, 255, 0.06);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-bottom: var(--space-xl);
}

.empty-state-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--space-xs);
}

.empty-state-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* ============================================================
   12. Scroll physics — shared root
   ============================================================ */

.page-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-primary-gradient);
  min-height: 0;
  position: relative;
  z-index: 1;
}

/* ═══════════════ 背景遮罩层 ═══════════════ */
/* 固定在视口底层，实体色 + 渐变叠层 opacity 交叉淡入淡出 */
.theme-bg-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 0;
  background-color: #F2F2F7;
  pointer-events: none;
  transition: background-color 0.45s ease;
}
/* 浅色渐变叠层 — 浅色模式可见，深色模式淡出 */
.theme-bg-layer::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(175deg, #F8F8FC 0%, #EDEDF3 40%, #E8E8F0 100%);
  opacity: 1;
  transition: opacity 0.45s ease;
}
/* 深色渐变叠层 — 浅色模式隐藏，深色模式淡入 */
.theme-bg-layer::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(175deg, #222226 0%, #1C1C1E 40%, #18181C 100%);
  opacity: 0;
  transition: opacity 0.45s ease;
}
/* 切换到深色：交换两个叠层的透明度 */
.theme-bg-layer.bg-dark::before { opacity: 0; }
.theme-bg-layer.bg-dark::after  { opacity: 1; }

.theme-bg-layer.bg-dark {
  background-color: #1C1C1E;
}

/* 确保导航栏在遮罩层之上 */
.weui-navigation-bar {
  position: relative;
  z-index: 2;
}

.scroller {
  flex: 1;
  overflow: hidden;
  position: relative;
  min-height: 0;
}

.scroll-content {
  will-change: transform;
}

/* ============================================================
   13. Dark Mode — Liquid Glass dark materials
   ============================================================ */

/* 深色模式：覆盖浅色变量 */
.theme-dark {
  /* Semantic colors — dark */
  --bg-primary: #1C1C1E;
  --bg-primary-gradient: linear-gradient(175deg, #222226 0%, #1C1C1E 40%, #18181C 100%);
  --bg-card: #2C2C2E;
  --bg-elevated: #1C1C1E;
  --text-primary: #FFFFFF;
  --text-secondary: #EBEBF5;
  --text-tertiary: #98989D;
  --text-quaternary: #636366;
  --separator: rgba(84, 84, 88, 0.40);
  --separator-strong: rgba(84, 84, 88, 0.55);
  --shadow-sm: 0 1rpx 4rpx rgba(0, 0, 0, 0.2);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
  --shadow-lg: 0 8rpx 32rpx rgba(0, 0, 0, 0.4);

  /* ── Dark Liquid Glass Materials ── */
  --glass-regular: rgba(255, 255, 255, 0.08);
  --glass-heavy:  rgba(255, 255, 255, 0.12);
  --glass-light:  rgba(255, 255, 255, 0.04);
  --glass-rim:     inset 0 1rpx 0 rgba(255, 255, 255, 0.07);
  --glass-rim-strong: inset 0 1rpx 0 rgba(255, 255, 255, 0.10);
  --glass-shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.30), 0 0 0 0.5rpx rgba(255, 255, 255, 0.04);
  --glass-shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.35), 0 0 0 0.5rpx rgba(255, 255, 255, 0.05);
  --glass-shadow-lg: 0 8rpx 30rpx rgba(0, 0, 0, 0.42), 0 0 0 1rpx rgba(255, 255, 255, 0.05);
  --glass-border: 0.5rpx solid rgba(255, 255, 255, 0.07);
  --glass-border-dark: 0.5rpx solid rgba(84, 84, 88, 0.22);

  /* Raw grays — iOS dark mode equivalents, prevents white flash on :active/hover */
  --gray: #98989D;
  --gray2: #636366;
  --gray3: #545458;
  --gray4: #48484A;
  --gray5: #3A3A3C;
  --gray6: #2C2C2E;
}

/* 深色模式：导航栏 — 深色玻璃 + 浅色文字 */
.theme-dark .weui-navigation-bar {
  color: rgba(255, 255, 255, 0.9);
}
.theme-dark .weui-navigation-bar__inner {
  background: rgba(28, 28, 30, 0.88);
  box-shadow: inset 0 -1rpx 0 rgba(255, 255, 255, 0.08);
}
.theme-dark .weui-navigation-bar__btn_goback {
  background-color: rgba(255, 255, 255, 0.85);
}

/* 注：tab bar 使用固定配色,不随主题变化,详见 custom-tab-bar/index.wxss */

/* 深色模式：卡片适配 — 使用固定色变量（--bg-card / --bg-elevated），自动适配深浅色 */
.theme-dark .file-card {
  background: var(--glass-regular);
  transition: background 0.4s ease, box-shadow 0.4s ease;
}

/* 深色模式：modal — 弹窗在 page-root 外，theme-dark 直接挂在 modal-mask 上 */
.modal-mask.theme-dark .modal-sheet {
  background-color: var(--bg-card);
}
.modal-mask.theme-dark {
  background-color: rgba(0, 0, 0, 0.55);
}

/* 深色模式：输入框 — 保持暗色固体（输入框不是导航层，不应使用玻璃） */
.theme-dark .input-ios,
.theme-dark .stepper-input,
.theme-dark .redeem-input,
.theme-dark .control-input,
.theme-dark .range-line-input {
  background-color: #2C2C2E;
  color: var(--text-primary);
  border-color: rgba(84, 84, 88, 0.5);
}

/* 深色模式：灰色背景区域（file-card 由 glass tokens 处理，无需覆盖） */

/* 深色模式：section header bar */
.theme-dark .section-bar,
.theme-dark .section-header-bar {
  background-color: var(--blue-light);
}

/* 深色模式：次级按钮 — 压暗底色 + 调暗高光 */
.theme-dark .btn-secondary {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(84, 84, 88, 0.20);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}
.theme-dark .btn-secondary:active {
  box-shadow:
    0 1rpx 4rpx rgba(0, 0, 0, 0.12),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}
.theme-dark .btn-destructive {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.25);
}

.theme-dark .stepper-btn {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.25);
  color: var(--text-primary);
}

.theme-dark .stepper-btn.stepper-disabled {
  color: var(--text-quaternary);
}

/* 深色模式：empty state */
.theme-dark .empty-state-icon {
  background-color: rgba(0, 122, 255, 0.12);
}

/* 深色模式：page analysis bar — glass */
.theme-dark .page-analysis-bar {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.35);
}

/* 深色模式：picker */
.theme-dark .picker-trigger {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.30);
}

.theme-dark .picker-sheet {
  background: var(--glass-heavy);
}

/* 深色模式：badge backgrounds (keep readability) */
.theme-dark .badge-queued    { background-color: rgba(255, 243, 224, 0.25); }
.theme-dark .badge-printing  { background-color: rgba(227, 242, 253, 0.25); }
.theme-dark .badge-sent      { background-color: rgba(232, 245, 233, 0.25); }
.theme-dark .badge-failed    { background-color: rgba(255, 235, 238, 0.25); }
.theme-dark .badge-canceled  { background-color: rgba(245, 245, 245, 0.15); }

/* 深色模式：订单状态色（文字+背景） */
.theme-dark .status-queued { background-color: rgba(255, 179, 77, 0.15); color: #FFB74D; }
.theme-dark .status-printing { background-color: rgba(100, 181, 246, 0.15); color: #64B5F6; }
.theme-dark .status-accepted { background-color: rgba(100, 181, 246, 0.15); color: #64B5F6; }
.theme-dark .status-offline_unknown { background-color: rgba(255, 213, 79, 0.15); color: #FFD54F; }
.theme-dark .status-sent { background-color: rgba(129, 199, 132, 0.15); color: #81C784; }
.theme-dark .status-failed { background-color: rgba(229, 115, 115, 0.15); color: #E57373; }
.theme-dark .status-abandoned { background-color: rgba(186, 104, 200, 0.15); color: #BA68C8; }
.theme-dark .status-reserved { background-color: rgba(255, 213, 79, 0.15); color: #FFD54F; }
.theme-dark .status-rejected { background-color: rgba(255, 179, 77, 0.15); color: #FFB74D; }
.theme-dark .status-canceled { background-color: rgba(174, 174, 178, 0.15); color: #AEAEB2; }
.theme-dark .status-delivered { background-color: rgba(129, 199, 132, 0.15); color: #81C784; }

/* 深色模式：key drawer locked */
.theme-dark .key-card-wrap.key-drawer-locked .key-card {
  background: var(--bg-card);
  opacity: 0.55;
}

/* 深色模式：detail file row — glass */
.theme-dark .detail-file-row {
  background: var(--glass-regular);
}

/* 深色模式：user license detail — glass */
.theme-dark .user-license-detail {
  background: var(--glass-regular);
}

/* 深色模式：admin badge */
.theme-dark .admin-badge {
  background-color: rgba(0, 122, 255, 0.15);
}

/* 深色模式：page-size controls */
.theme-dark .page-size-selector,
.theme-dark .page-btn,
.theme-dark .page-num {
  background: var(--glass-regular);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
}

.theme-dark .page-size-dropdown {
  background: rgba(44, 44, 46, 0.72);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.4), var(--glass-rim);
}

/* 深色模式：picker option hover */
.theme-dark .picker-option:active {
  background: rgba(0, 122, 255, 0.12);
}

/* 深色模式：key-type-toggle — 用 --gray5 提亮滑轨，与页面背景(#1C1C1E)区分 */
.theme-dark .key-type-toggle {
  background-color: var(--gray5);
}

/* ═══════════════ Theme Toggle Button ═══════════════ */

.theme-toggle-btn {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 6px);
  right: 16px;
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: saturate(180%) blur(12px);
  -webkit-backdrop-filter: saturate(180%) blur(12px);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7),
    0 0 0 0.5rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  /* 扩大隐式触摸区域 */
  padding: 12rpx;
  /* 松手回弹 + 深浅过渡 */
  transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1),
              background-color 0.45s ease,
              box-shadow 0.45s ease;
}

/* 按压瞬间：立即缩到位（0s 过渡保证短按也能触发） */
.theme-toggle-btn.tp-pressing {
  transform: scale(0.78);
  transition: transform 0s;
}

.theme-toggle-btn.theme-dark {
  background: rgba(26, 26, 28, 0.50);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.40),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12),
    0 0 0 0.5rpx rgba(255, 255, 255, 0.08);
}

/* ═══════════════ Scroll To Top Button ═══════════════ */

.scroll-top-btn {
  position: absolute;
  bottom: calc(100rpx + env(safe-area-inset-bottom) + 12rpx);
  right: 16px;
  width: 60rpx;
  height: 60rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.22);
  backdrop-filter: saturate(180%) blur(12px);
  -webkit-backdrop-filter: saturate(180%) blur(12px);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7),
    0 0 0 0.5rpx rgba(0, 0, 0, 0.06);
  z-index: 10;
  opacity: 0;
  transform: scale(0.8);
  pointer-events: none;
  transition: opacity 0.3s ease, transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.scroll-top-btn.scroll-top-visible {
  opacity: 1;
  transform: scale(1);
  pointer-events: auto;
}

.scroll-top-btn:active {
  transform: scale(0.88);
}

.scroll-top-btn.scroll-top-visible:active {
  transform: scale(0.88);
}

.theme-dark .scroll-top-btn {
  background: rgba(26, 26, 28, 0.50);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.40),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12),
    0 0 0 0.5rpx rgba(255, 255, 255, 0.08);
}

/* 返回顶部箭头（双短线拼成 ^ 形） */
.scroll-top-arrow {
  position: relative;
  width: 28rpx;
  height: 22rpx;
  margin-top: 6rpx;
}
.arrow-bar {
  position: absolute;
  left: 50%;
  top: 0;
  width: 4rpx;
  height: 20rpx;
  border-radius: 2rpx;
  background: #8E8E93;
  transform-origin: 50% 0%;
}
.arrow-left {
  transform: translateX(-50%) rotate(-35deg);
}
.arrow-right {
  transform: translateX(-50%) rotate(35deg);
}

.theme-dark .arrow-bar {
  background: #98989D;
}

/* ============================================================
   13b. Dark Mode — 按钮/控件微调（glass tokens 已处理主体，仅补细调）
   ============================================================ */

/* ── 危险按钮：暗色描边 ── */
.theme-dark .btn-destructive {
  border-color: rgba(255, 59, 48, 0.25);
}
.theme-dark .btn-destructive:active {
  background: rgba(255, 59, 48, 0.12);
}

/* ── 小玻璃按钮 ── */
.theme-dark .btn-small {
  background: rgba(0, 122, 255, 0.12);
}

/* ── 文件删除按钮 ── */
.theme-dark .file-remove {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.25);
}

/* ── 添加文件按钮 ── */
.theme-dark .add-file-btn {
  background: var(--glass-regular);
  border-color: rgba(0, 122, 255, 0.18);
}

/* ── 玻璃数值标签 ── */
.theme-dark .param-value-glass {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.25);
}

/* ── 删除全部按钮 ── */
.theme-dark .delete-all-btn {
  background: var(--glass-regular);
  border-color: rgba(255, 59, 48, 0.20);
}
.theme-dark .delete-all-btn:active {
  background: rgba(255, 59, 48, 0.12);
}

/* ── 留存保存按钮（主色玻璃） ── */
.theme-dark .retention-save-btn {
  box-shadow:
    0 2rpx 10rpx rgba(0, 122, 255, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.08);
}
.theme-dark .retention-save-btn:active {
  box-shadow:
    0 1rpx 4rpx rgba(0, 122, 255, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.12);
}

/* ── iOS 开关滑块：降低白色亮度 ── */
.theme-dark .switch-thumb {
  background: linear-gradient(180deg,
    rgba(220, 220, 225, 0.95) 0%,
    rgba(200, 200, 208, 0.9) 100%);
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.3),
    0 1rpx 3rpx rgba(0, 0, 0, 0.2);
}

/* ── 主按钮玻璃高光减弱 ── */
.theme-dark .btn-primary {
  box-shadow:
    0 4rpx 16rpx rgba(0, 122, 255, 0.2),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.12),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.12);
}
.theme-dark .btn-primary:active {
  box-shadow:
    0 2rpx 8rpx rgba(0, 122, 255, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.15);
}

/* ── 生成按钮 ── */
.theme-dark .generate-btn {
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
}

/* ── 许可密钥输入/粘贴按钮 ── */
.theme-dark .redeem-paste-btn {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(0, 122, 255, 0.2);
}

/* ── 添加文件按钮按下态 ── */
.theme-dark .add-file-btn:active {
  background-color: rgba(0, 122, 255, 0.15);
}

/* ============================================================
   14. Animation curves — Apple's spring equivalents
   ============================================================ */

/* Quick spring (buttons, small transitions) */
@keyframes springQuick {
  from { transform: scale(0.9); opacity: 0; }
  60%  { transform: scale(1.02); }
  to   { transform: scale(1); opacity: 1; }
}

/* Page preload — invisible until entrance animation kicks in */
.page-init {
  opacity: 0;
  pointer-events: none;
}

/* ═══════════════ Page Transition Animations ═══════════════ */
/* 所有页面共享：tab 切换 + 子页面导航统一使用 */
.page-fade-in {
  animation: pageFadeIn 0.3s 0.01s ease both;
}
@keyframes pageFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 入场：从右滑入 */
.page-enter-right {
  animation: pageEnterRight 0.3s 0.06s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
@keyframes pageEnterRight {
  from { opacity: 0; transform: translateX(260rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

/* 入场：从左滑入 */
.page-enter-left {
  animation: pageEnterLeft 0.3s 0.06s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
@keyframes pageEnterLeft {
  from { opacity: 0; transform: translateX(-260rpx); }
  to   { opacity: 1; transform: translateX(0); }
}

/* 退出：左滑淡出 */
.page-exit-left {
  animation: pageExitLeft 0.22s ease-in both;
}
@keyframes pageExitLeft {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(-260rpx); }
}

/* 退出：右滑淡出 */
.page-exit-right {
  animation: pageExitRight 0.22s ease-in both;
}
@keyframes pageExitRight {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(260rpx); }
}

/* Card preload — invisible until card-entering animation triggers */
.card-preload {
  opacity: 0;
}

/* Smooth fade+slide (list items) */
@keyframes fadeSlideIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Status dot pulse */
@keyframes statusPulse {
  0%   { box-shadow: 0 0 0 0 rgba(0, 122, 255, 0.4); }
  70%  { box-shadow: 0 0 0 10rpx rgba(0, 122, 255, 0); }
  100% { box-shadow: 0 0 0 0 rgba(0, 122, 255, 0); }
}
