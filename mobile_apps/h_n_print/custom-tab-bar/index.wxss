/* Apple Liquid Glass Custom Tab Bar — 低透明度 + 适度模糊 + 层次感 */

/* ── Tab Bar ── */
.tab-bar {
  position: fixed;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  left: 80rpx;
  right: 80rpx;
  height: 110rpx;
  display: flex;
  /* 固定配色，不随主题变化，深色/浅色下都自然的玻璃效果 */
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: saturate(180%) blur(14px);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  border-radius: 40rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.20),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.04),
    0 0 0 0.5rpx rgba(0, 0, 0, 0.04);
  z-index: 9999;
}

.tab-bar.border-hidden {
  border-top-color: transparent;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 0 8rpx;
}

/* Touch-down feedback */
.tab-hover {
  opacity: 0.6;
}
.tab-hover .tab-icon {
  animation: iconBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes iconBounce {
  0%   { transform: scale(1); }
  35%  { transform: scale(0.78); }
  100% { transform: scale(1); }
}

/* Icon container */
.tab-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
  transition: background-color 0.2s ease;
}

.icon-active {
  background-color: rgba(0, 122, 255, 0.08);
}

.tab-icon {
  width: 50rpx;
  height: 50rpx;
  opacity: 0.5;
  transition: opacity 0.2s ease;
}

.icon-active .tab-icon,
.tab-item.active .tab-icon {
  opacity: 1;
}

/* Label text */
.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--tab-text, #8E8E93);
  letter-spacing: 0.01em;
  transition: color 0.2s ease;
}

.text-active {
  color: var(--tab-text-active, #007AFF);
  font-weight: 600;
}
