/* Apple Liquid Glass Custom Tab Bar — 低透明度 + 适度模糊 + 层次感 */

/* ── Tab Bar ── */
.tab-bar {
  position: fixed;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  left: 80rpx;
  right: 80rpx;
  height: 90rpx;
  display: flex;
  /* 半透明基底：足够透光，又能看清玻璃存在 */
  background: var(--glass-regular);
  /* Apple 风格：适度模糊 + 饱和度提升，让背景色渗出但不过度融糊 */
  backdrop-filter: saturate(180%) blur(12px);
  -webkit-backdrop-filter: saturate(180%) blur(12px);
  border-radius: 30rpx;
  /* 多层阴影模拟玻璃深度：
     1. 外投影 — 悬浮感
     2. 顶部内高光 — 玻璃边缘折射亮线
     3. 底部内阴影 — 玻璃厚度感
     4. 极细外描边 — 玻璃轮廓 */
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.7),
    inset 0 -1rpx 0 rgba(0, 0, 0, 0.04),
    0 0 0 0.5rpx rgba(0, 0, 0, 0.06);
  z-index: 9999;
}

.tab-bar.border-hidden {
  border-top-color: transparent;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 8rpx 0 4rpx;
}

/* Touch-down feedback */
.tab-hover {
  opacity: 0.6;
}
.tab-hover .tab-icon {
  animation: iconBounce 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes iconBounce {
  0%   { transform: scale(1); }
  35%  { transform: scale(0.78); }
  100% { transform: scale(1); }
}

/* Icon container */
.tab-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 2rpx;
  transition: background-color 0.2s ease;
}

.icon-active {
  background-color: rgba(0, 122, 255, 0.08);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.5;
  transition: opacity 0.2s ease;
}

.icon-active .tab-icon,
.tab-item.active .tab-icon {
  opacity: 1;
}

/* Label text */
.tab-text {
  font-size: 18rpx;
  font-weight: 500;
  color: #8E8E93;
  letter-spacing: 0.01em;
  transition: color 0.2s ease;
}

.text-active {
  color: #007AFF;
  font-weight: 600;
}
