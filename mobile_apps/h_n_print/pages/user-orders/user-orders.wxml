<!--user-orders.wxml — 查看指定用户/来源的订单列表-->
<page-meta></page-meta>
<navigation-bar title="{{pageTitle}}" back="{{true}}" color="{{isDarkMode ? 'white' : 'black'}}" background="transparent" extClass="{{isDarkMode ? 'theme-dark' : ''}}"></navigation-bar>
<view class="theme-bg-layer {{isDarkMode ? 'bg-dark' : ''}}"></view>
<wxs module="scroll" src="../../utils/scroll.wxs"></wxs>
<view class="page-root {{pageSlide}} {{pageExit}} {{isDarkMode ? 'theme-dark' : ''}}">

<view class="scroller"
      prop="{{scrollConfig}}"
      change:prop="{{scroll.onConfig}}"
      cmd="{{scrollCmd}}"
      change:cmd="{{scroll.onCmd}}"
      bindtouchstart="{{scroll.touchstart}}"
      bindtouchmove="{{scroll.touchmove}}"
      bindtouchend="{{scroll.touchend}}"
      bindtouchcancel="{{scroll.touchend}}">
  <view class="scroll-content">
    <view class="container">

    <!-- 被查看用户卡片（管理入口跳转后显示，与“我”页面顶部卡片一致） -->
    <view wx:if="{{userDetail}}" class="user-card-wrap">
      <view class="user-card">
        <view class="user-card-avatar">
          <image wx:if="{{userDetail.avatar_url}}" class="user-card-avatar-img" src="{{userDetail.avatar_url}}" mode="aspectFill" />
          <text wx:else class="user-card-avatar-char">{{userDetail.avatarChar}}</text>
        </view>
        <view class="user-card-info">
          <text class="user-card-nickname">{{userDetail.nickname || '未知用户'}}</text>
          <text class="user-card-role">{{userDetail.is_super ? '超级管理员' : (userDetail.role === 'admin' ? '管理员' : (userDetail.role === 'user' ? '普通用户' : '访客'))}}</text>
        </view>
        <!-- 许可密钥徽章：点击向下展开详情 -->
        <view wx:if="{{userDetail.license_info}}" class="license-badge {{userDetail.role === 'admin' || userDetail.license_info.type === 'admin' ? 'license-badge-admin' : (userDetail.license_info.expired ? 'license-badge-expired' : 'license-badge-temp')}}"
              bindtap="onToggleLicenseDetail" hover-class="tap-active">
          <text class="license-badge-key">{{userDetail.license_info.key}}</text>
          <text class="license-badge-validity">{{userDetail.role === 'admin' || userDetail.license_info.type === 'admin' ? '永久' : (userDetail.license_info.expired ? '已过期' : '临时授权')}}</text>
        </view>
      </view>
      <!-- 许可密钥详情（展开态） -->
      <view wx:if="{{userDetail.license_info}}" class="license-detail {{showLicenseDetail ? 'license-detail-expanded' : ''}}">
        <view class="detail-divider"></view>
        <view class="detail-row">
          <text class="detail-label">当前状态</text>
          <text class="detail-value {{userDetail.role === 'admin' || userDetail.license_info.type === 'admin' ? 'license-status-permanent' : (userDetail.license_info.expired ? 'license-status-expired' : 'license-status-ok')}}">{{userDetail.role === 'admin' || userDetail.license_info.type === 'admin' ? '永久' : (userDetail.license_info.expired ? '已过期' : '有效')}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">许可密钥</text>
          <text class="detail-value license-key-value">{{userDetail.license_info.key}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">密钥类型</text>
          <text class="detail-value">{{userDetail.license_info.type === 'admin' ? '管理员许可' : '临时许可'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">授权人</text>
          <text class="detail-value">{{userDetail.license_info.creator_nickname || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">创建时间</text>
          <text class="detail-value">{{userDetail.license_info.created_at || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">使用时间</text>
          <text class="detail-value">{{userDetail.license_info.used_at || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">到期时间</text>
          <text class="detail-value">{{userDetail.license_info.expires_at || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">有效时长</text>
          <text class="detail-value">{{userDetail.license_info.validity_minutes ? userDetail.license_info.validity_minutes + ' 分钟' : '—'}}</text>
        </view>
      </view>
    </view>

    <!-- 订单区域（滚动定位锚点） -->
    <view class="orders-section">

    <!-- 加载中 -->
    <view wx:if="{{loading}}" class="status-box">
      <text class="status-text">加载中...</text>
    </view>

    <!-- 加载失败 / 网络错误 -->
    <view wx:elif="{{loadError}}" class="status-box">
      <text class="status-text">{{loadError}}</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{orders.length === 0}}" class="empty-state">
      <view class="empty-illustration">
        <text class="empty-icon">📋</text>
      </view>
      <text class="empty-title">暂无任务</text>
      <text class="empty-desc">{{sourceFilter === 'local' ? '还没有本地打印任务记录' : '该用户还没有发起过打印任务'}}</text>
    </view>

    <!-- 订单列表 -->
    <view wx:else>
      <!-- 分页控制栏（顶部） -->
      <view class="pagination-bar pagination-top" wx:if="{{totalPages > 0}}">
        <view class="page-size-selector" bindtap="onTogglePageSizePicker">
          <text class="page-size-text">{{perPage}}条/页</text>
          <text class="page-size-arrow {{showPageSizePicker ? 'arrow-up' : ''}}">▼</text>
          <!-- 下拉选项（常驻节点切 class，0.2s 过渡双向生效；对齐 APP） -->
          <view class="page-size-dropdown {{showPageSizePicker ? 'dropdown-show' : ''}}">
            <view wx:for="{{pageOptions}}" wx:key="*this"
                  class="page-size-option {{perPage === item ? 'option-active' : ''}}"
                  catchtap="onSelectPageSize" data-size="{{item}}">
              {{item}} 条/页
            </view>
          </view>
        </view>
        <view class="page-nav">
          <view class="page-btn {{currentPage <= 1 ? 'page-btn-disabled' : ''}}"
                bindtap="onPrevPage" hover-class="tap-active">‹</view>
          <block wx:for="{{pageNumbers}}" wx:key="index">
            <view wx:if="{{item === '...'}}" class="page-ellipsis">…</view>
            <view wx:else
                  class="page-num {{currentPage === item ? 'page-num-active' : ''}}"
                  bindtap="onPageChange" data-page="{{item}}" hover-class="tap-active">{{item}}</view>
          </block>
          <view class="page-btn {{currentPage >= totalPages ? 'page-btn-disabled' : ''}}"
                bindtap="onNextPage" hover-class="tap-active">›</view>
        </view>
      </view>

      <!-- 总览信息 -->
      <view class="orders-summary" wx:if="{{totalOrders > 0}}">
        <text class="summary-text">共 {{totalOrders}} 个订单，当前第 {{currentPage}}/{{totalPages}} 页</text>
      </view>

      <!-- 任务卡片列表 -->
      <view wx:for="{{orders}}" wx:key="id"
            class="order-card {{expandedOrders[item.id] ? 'order-expanded' : ''}}"
            bindtap="onOrderTap" data-id="{{item.id}}">
        <!-- 收缩态：一行摘要 -->
        <view class="order-card-header">
          <view class="order-card-main">
            <text class="order-filename">{{item.order_number || ('#' + item.id)}}</text>
            <text class="order-source-tag {{item.source === 'local' ? 'tag-local' : 'tag-cloud'}}">{{item.source === 'local' ? '🖨 本地' : '☁ 云端'}}</text>
            <text class="order-status status-{{item.status}}">{{statusMap[item.status] || item.status}}</text>
          </view>
          <text class="order-number-label">{{item.file_summary || item.file}}</text>
          <view wx:if="{{item.isExcel}}" class="order-card-meta">
            <text class="order-card-stat">📄 不适用</text>
            <text class="order-card-stat">📋 不适用</text>
          </view>
          <view wx:else class="order-card-meta">
            <text class="order-card-stat">📄 {{item.total_pages || (item.page_count * item.copies)}} 页</text>
            <text class="order-card-stat">📋 {{item.total_copies || item.copies}} 份</text>
          </view>
          <view class="order-card-footer">
            <text class="order-created">{{item.created_at}}</text>
            <text class="order-arrow {{expandedOrders[item.id] ? 'arrow-up' : ''}}">›</text>
          </view>
        </view>

        <!-- 展开态：详细信息 -->
        <view class="order-card-detail {{expandedOrders[item.id] ? 'detail-expanded' : ''}}">
          <view class="detail-divider"></view>

          <!-- 打印信息 -->
          <view class="detail-section">
            <view class="detail-section-title">打印信息</view>
            <view class="detail-row">
              <text class="detail-label">接单设备</text>
              <text class="detail-value">{{item.received_label || '—'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">提交时间</text>
              <text class="detail-value">{{item.created_at}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">开始打印</text>
              <text class="detail-value">{{item.print_started_at || '—'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">合计页数</text>
              <text class="detail-value">{{item.isExcel ? '不适用' : (item.total_pages || (item.page_count * item.copies)) + ' 页'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">合计份数</text>
              <text class="detail-value">{{item.isExcel ? '不适用' : (item.total_copies || item.copies) + ' 份'}}</text>
            </view>
          </view>

          <!-- 临时许可密钥（订单消费的密钥） -->
          <view wx:if="{{item.license_info}}" class="detail-section">
            <view class="detail-section-title">临时许可密钥</view>
            <view class="detail-row">
              <text class="detail-label">密钥</text>
              <text class="detail-value license-key-value">{{item.license_info.key}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">使用时间</text>
              <text class="detail-value">{{item.license_info.used_at || '—'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">到期时间</text>
              <text class="detail-value">{{item.license_info.expires_at || '—'}}</text>
            </view>
          </view>

          <!-- 文件列表 -->
          <view wx:if="{{item.files && item.files.length > 0}}" class="detail-section">
            <view class="detail-section-title">文件列表 ({{item.files.length}})</view>
            <view wx:for="{{item.files}}" wx:for-item="f" wx:key="id" class="detail-file-row">
              <view class="detail-file-info">
                <text class="detail-file-name">{{f.original_name || f.file_name}}</text>
                <view class="detail-file-tags">
                  <text wx:if="{{f.file_type}}" class="file-type-tag">{{f.file_type}}</text>
                  <text wx:if="{{f.sizeDisplay}}" class="file-size-tag">{{f.sizeDisplay}}</text>
                </view>
              </view>
              <view class="detail-file-right">
                <text class="detail-file-copies">{{f.copies}} 份 × {{f.page_count}} 页</text>
                <text class="detail-file-range">{{f.duplex === 'on' ? '双面' : '单面'}}</text>
                <text wx:if="{{f.page_range}}" class="detail-file-range">范围: {{f.page_range}}</text>
                <text wx:if="{{(f.status === 'rejected' || f.status === 'failed') && f.reject_reason}}" class="file-reject-reason">{{f.reject_reason}}</text>
              </view>
            </view>
          </view>

          <!-- 附加服务 -->
          <view wx:if="{{item.urgency !== '低' || item.cover_page > 0 || item.delivery_enabled}}" class="detail-section">
            <view class="detail-section-title">附加服务</view>
            <view wx:if="{{item.urgency && item.urgency !== '低'}}" class="detail-row">
              <text class="detail-label">加急</text>
              <text class="detail-value">{{item.urgency === '高' ? '🚀 高' : '⚡ 中'}}<text wx:if="{{item.urgency_price > 0}}"> + ¥{{item.urgency_price}}</text></text>
            </view>
            <view wx:if="{{item.cover_page > 0}}" class="detail-row">
              <text class="detail-label">首页</text>
              <text class="detail-value">{{item.cover_page}} 页<text wx:if="{{item.cover_page_price > 0}}"> · ¥{{item.cover_page_price}}/页</text></text>
            </view>
            <view wx:if="{{item.delivery_enabled}}" class="detail-row">
              <text class="detail-label">派送</text>
              <text class="detail-value">{{item.delivery_location || '未指定地点'}}<text wx:if="{{item.delivery_percentage > 0}}"> · 加收 {{item.delivery_percentage}}%</text></text>
            </view>
          </view>

          <!-- 备注 -->
          <view wx:if="{{item.remark}}" class="detail-section">
            <view class="detail-section-title">备注</view>
            <view class="detail-row remark-row">
              <text class="detail-value remark-text">{{item.remark}}</text>
            </view>
          </view>

          <!-- 价格 -->
          <view class="detail-section">
            <view class="detail-row detail-price-row">
              <text class="detail-label">合计价格</text>
              <text class="detail-price-value status-{{item.status}}{{item.is_admin_print && item.status === 'sent' ? ' is-self-sent' : ''}}">¥{{item.totalPriceDisplay}}</text>
            </view>
          </view>

          <!-- 操作按钮（仅本人订单可取消，且含预约单到点前：scheduled/downloading/waiting）
               后端 openid 校验：管理员查看他人订单时隐藏按钮，避免"点了报无权操作" -->
          <view class="detail-actions">
            <button wx:if="{{item.openid === selfOpenid && (item.status === 'queued' || item.status === 'printing' || item.status === 'waiting' || item.status === 'downloading' || item.status === 'scheduled')}}"
                    class="btn-cancel-sm" catchtap="onDetailCancelOrder" data-id="{{item.id}}">取消任务</button>
          </view>
        </view>
      </view>

      <!-- 底部分页控制栏 -->
      <view class="pagination-bar pagination-bottom" wx:if="{{totalPages > 1}}">
        <view class="page-nav">
          <view class="page-btn {{currentPage <= 1 ? 'page-btn-disabled' : ''}}"
                bindtap="onPrevPage" hover-class="tap-active">‹</view>
          <block wx:for="{{pageNumbers}}" wx:key="index">
            <view wx:if="{{item === '...'}}" class="page-ellipsis">…</view>
            <view wx:else
                  class="page-num {{currentPage === item ? 'page-num-active' : ''}}"
                  bindtap="onPageChange" data-page="{{item}}" hover-class="tap-active">{{item}}</view>
          </block>
          <view class="page-btn {{currentPage >= totalPages ? 'page-btn-disabled' : ''}}"
                bindtap="onNextPage" hover-class="tap-active">›</view>
        </view>
      </view>

      <!-- 最后一页提示 -->
      <view wx:if="{{currentPage >= totalPages && totalPages > 0}}" class="end-hint">
        <text class="end-hint-text">-- 没有更多内容啦 --</text>
      </view>
    </view>
    </view>
    </view>
  </view>
</view>
</view>
