/** authorized-users.wxss — Apple-style authorized users list **/

/* ── Root & Container ── */
.scrollarea {
  height: 100vh;
  background-color: var(--bg-primary);
}

.container {
  padding: 20rpx 32rpx;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── Status / Empty ── */
.status-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.status-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-illustration {
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: center;
  line-height: 1.6;
  max-width: 480rpx;
}

/* ── Summary ── */
.list-summary {
  margin-bottom: 16rpx;
}

.summary-text {
  font-size: 22rpx;
  color: var(--text-quaternary);
}

/* ═══════════════ User Cards ═══════════════ */

.user-list {
  display: flex;
  flex-direction: column;
}

.user-card-item {
  background: var(--glass-regular);
  border-radius: var(--radius-lg);
  padding: 0 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: var(--glass-border-dark);
  transition: transform 0.12s ease;
  overflow: hidden;
}

.user-card-main {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

/* Avatar circle */
.user-avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--blue), #40a9ff);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.user-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-avatar-char {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

/* Center info */
.user-card-center {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.user-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-card-id {
  font-size: 20rpx;
  color: var(--text-quaternary);
  font-family: var(--font-mono);
}

/* 密钥类型 + 状态标签 */
.user-card-tags {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 2rpx 0;
}

.key-type-tag,
.status-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 3rpx 12rpx;
  border-radius: 10rpx;
}

.tag-admin {
  color: var(--blue);
  background-color: rgba(0, 122, 255, 0.08);
}

.tag-temp {
  color: #FF9500;
  background-color: rgba(255, 149, 0, 0.10);
}

.tag-both {
  color: #7B1FA2;
  background-color: rgba(123, 31, 162, 0.08);
}

.status-permanent { color: #2E7D32; background-color: rgba(46, 125, 50, 0.08); }
.status-active    { color: var(--blue); background-color: rgba(0, 122, 255, 0.08); }
.status-expired   { color: #E65100; background-color: rgba(230, 81, 0, 0.08); }
.status-removed   { color: var(--text-quaternary); background-color: rgba(142, 142, 147, 0.10); }

/* Right stats */
.user-card-right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  margin-left: 16rpx;
}

.user-stat {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.user-stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--blue);
  font-family: var(--font-mono);
}

.user-stat-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.user-card-last {
  font-size: 18rpx;
  color: var(--text-quaternary);
  font-family: var(--font-mono);
}

.role-btn-arrow {
  font-size: 32rpx;
  color: var(--text-quaternary);
  margin-top: 2rpx;
}

/* ── 密钥记录展开 ── */
.records-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-top: 1rpx solid var(--separator);
}

.records-toggle-text {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

.records-toggle-arrow {
  font-size: 28rpx;
  color: var(--text-quaternary);
  transition: transform 0.25s ease;
  display: inline-block;
}

.records-toggle-arrow.arrow-up {
  transform: rotate(90deg);
  color: var(--blue);
}

.records-panel {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.32s ease, opacity 0.25s ease;
}

.records-expanded {
  max-height: 3000rpx;
  opacity: 1;
  padding-bottom: 8rpx;
}

.records-empty {
  font-size: 22rpx;
  color: var(--text-quaternary);
  text-align: center;
  padding: 20rpx 0;
}

.record-row {
  background-color: var(--gray6);
  border-radius: var(--radius-sm);
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}

.record-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.record-key {
  font-family: var(--font-mono);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.record-type,
.record-status {
  font-size: 16rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.record-status {
  color: var(--text-tertiary);
  background-color: rgba(142, 142, 147, 0.10);
}

.record-line {
  display: flex;
  justify-content: space-between;
  padding: 3rpx 0;
}

.record-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.record-value {
  font-size: 20rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

/* ═══════════════ Dark Mode ═══════════════ */
.theme-dark .record-row {
  background: var(--glass-regular);
}
