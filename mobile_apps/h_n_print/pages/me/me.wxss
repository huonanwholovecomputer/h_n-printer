/** Apple-style Me Page Styles **/

/* ── Root & Container ── */
.page-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: transparent;
  min-height: 0;
}

/* 深浅切换过渡：所有在深色模式下变色的元素 */
.page-root,
.page-root .user-card-wrap,
.page-root .user-card,
.page-root .license-card,
.page-root .storage-card,
.page-root .user-item,
.page-root .role-btn,
.page-root .order-card,
.page-root .key-card,
.page-root .license-section,
.page-root .storage-section,
.page-root .users-section,
.page-root .orders-section,
.page-root .page-num,
.page-root .page-btn,
.page-root .page-size-selector,
.page-root .stepper-btn,
.page-root .key-type-toggle,
.page-root .key-type-option,
.page-root .btn-secondary,
.page-root .input-ios,
.page-root .stepper-input,
.page-root .generate-btn,
.page-root .retention-save-btn,
.page-root .retention-stepper-btn,
.page-root .retention-stepper-input,
.page-root .redeem-input,
.page-root .control-input,
.page-root .range-line-input,
.page-root .detail-file-row,
.page-root .admin-card,
.page-root .user-license-detail,
.page-root .security-summary-card,
.page-root .role-btn {
  transition: background 0.45s ease, color 0.35s ease, border-color 0.45s ease, box-shadow 0.45s ease, transform 0.12s ease;
}

/* page-root 下所有文字自动获得颜色过渡（继承 CSS 变量变值后的渐变） */
.page-root text,
.page-root input {
  transition: color 0.35s ease;
}


/* 初始隐藏态：防止页面首次渲染时闪烁 */
.page-init {
  opacity: 0;
  pointer-events: none;
}

/* 入场：从右滑入 + 淡入（强 Ease-Out：先快后慢） */
.page-enter-right {
  animation: enterRight 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes enterRight {
  from { opacity: 0; transform: translateX(260rpx); }
  to   { opacity: 1; transform: translateX(0); }
}
.page-fade-in {
  animation: fadeIn 0.25s ease-out both;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

/* 退出动画（强 Ease-Out：先快后慢） */
.page-exit-left {
  animation: exitLeft 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes exitLeft {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(-260rpx); }
}
.page-exit-right {
  animation: exitRight 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes exitRight {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(260rpx); }
}

.scroller {
  flex: 1;
  overflow: hidden;
  position: relative;
  min-height: 0;
}

.scroll-content {
  /* will-change: transform 会导致微信渲染器预分配固定尺寸 GPU 层，
     动态添加子元素后层不扩展，内容被截断。依赖浏览器自动合成。 */
}

.container {
  padding: 20rpx 32rpx;
  padding-bottom: 48rpx;  /* 底部留白；tabBar 遮挡由滚动范围 _tabOverlayPx 显式处理，不再用大 padding 兜底 */
  box-sizing: border-box;
}

/* ═══════════════ User Profile Card ═══════════════ */

.user-card-wrap {
  margin-bottom: 20rpx;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--separator);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  overflow: hidden;
  transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
}

/* 卡片本身不再承担容器背景（容器统一圆角/边框/阴影） */
.user-card-wrap .user-card {
  background: transparent;
  border: none;
  box-shadow: none;
  border-radius: 0;
  margin-bottom: 0;
}

.user-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  transition: background-color 0.4s ease, color 0.35s ease, box-shadow 0.4s ease;
}

.avatar-btn {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: transparent;
  flex-shrink: 0;
  line-height: 1;
  overflow: hidden;
}
.avatar-btn:active {
  opacity: 0.7;
}

.avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background-color: var(--gray5);
}

.user-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}
.nickname-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  max-width: 300rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.nickname-edit-icon {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 隐藏的原生昵称输入：触发微信自动填充但不显示 */
.hidden-nickname-input {
  position: fixed;
  left: -9999px;
  opacity: 0;
  pointer-events: none;
  width: 1rpx;
  height: 1rpx;
}

.uid {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 500;
}

/* ── 许可密钥徽章（用户卡片右侧）── */
.license-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: var(--radius-sm);
  gap: 2rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.license-badge-temp {
  background: rgba(255, 149, 0, 0.08);
  border: 1rpx solid rgba(255, 149, 0, 0.25);
}
.license-badge-admin {
  background: rgba(0, 122, 255, 0.08);
  border: 1rpx solid rgba(0, 122, 255, 0.25);
}

.license-badge-expired {
  background: rgba(142, 142, 147, 0.10);
  border: 1rpx solid rgba(142, 142, 147, 0.25);
}
.license-badge-key {
  font-family: var(--font-mono);
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}
.license-badge-validity {
  font-size: 18rpx;
  font-weight: 500;
}
.license-badge-temp .license-badge-validity {
  color: #FF9500;
}
.license-badge-admin .license-badge-validity {
  color: var(--blue);
}

.license-badge-expired .license-badge-validity {
  color: var(--text-quaternary);
}

/* ── 许可密钥详情（点击徽章向下展开）── */
.license-detail {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  padding: 0 28rpx;
  transition: max-height 0.32s ease, opacity 0.25s ease;
}

.license-detail-expanded {
  max-height: 800rpx;
  opacity: 1;
  padding: 0 28rpx 24rpx;
}

.license-detail .detail-divider {
  margin: 8rpx 0;
}

.license-detail .detail-row {
  padding: 9rpx 0;
}

.license-key-value {
  font-family: var(--font-mono);
  font-weight: 600;
  color: var(--blue);
  letter-spacing: 1rpx;
}

.license-status-ok {
  color: #2E7D32;
  font-weight: 600;
}

.license-status-permanent {
  color: var(--blue);
  font-weight: 600;
}

.license-status-expired {
  color: var(--red);
  font-weight: 600;
}

/* ═══════════════ Section Headers ═══════════════ */

.section-title {
  display: flex;
  align-items: center;
  padding: 16rpx 0 16rpx 8rpx;
  gap: 12rpx;
}

.section-bar {
  width: 6rpx;
  height: 26rpx;
  background-color: var(--blue);
  border-radius: 3rpx;
}

.section-title text:first-of-type {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.order-count {
  margin-left: 10rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background-color: var(--blue);
  padding: 3rpx 14rpx;
  border-radius: 20rpx;
}

/* ═══════════════ Role Action Buttons ═══════════════ */

.role-actions {
  margin-bottom: 20rpx;
}

.role-btn {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border-left: 6rpx solid var(--green);
  /* transform 短过渡保证按压回弹迅速；背景/边框/阴影由外层 .page-root .role-btn 控制。 */
  transition: transform 0.12s ease, box-shadow 0.25s ease;
  will-change: transform;
}
.role-btn-pressing {
  transform: scale(0.96);
  background-color: var(--gray6);
  transition: none;
}

.role-btn-icon {
  font-size: 36rpx;
  margin-right: 18rpx;
}

.role-btn-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.role-btn-arrow {
  font-size: 32rpx;
  color: var(--text-quaternary);
}

/* ═══════════════ Cards (generic) ═══════════════ */

.license-section, .users-section, .storage-section, .orders-section {
  margin-bottom: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

/* ── 管理员区域折叠过渡（避免 role 异步加载后卡片突然插入导致布局突变）── */
.admin-collapsible {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  margin-bottom: 0;
  pointer-events: none;
  transition: max-height 0.5s cubic-bezier(0.22, 0.61, 0.36, 1),
              opacity 0.35s ease,
              margin-bottom 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.admin-collapsible.admin-expanded {
  max-height: 3100rpx;
  opacity: 1;
  margin-bottom: 20rpx;
  padding-bottom: 12rpx;
  pointer-events: auto;
}

.license-card, .storage-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  text-align: left;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  transition: background-color 0.4s ease, color 0.35s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}

/* ═══════════════ License Key Generator ═══════════════ */

.license-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 14rpx;
  display: block;
}

.license-stepper {
  margin-bottom: 20rpx;
}

.key-type-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.key-type-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.key-type-toggle {
  position: relative;
  display: flex;
  width: 340rpx;
  background-color: var(--gray6);
  border-radius: 18rpx;
  padding: 4rpx;
  overflow: hidden;
}

.key-type-slider {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: calc(50% - 4rpx);
  height: calc(100% - 8rpx);
  border-radius: 15rpx;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.88) 0%,
    rgba(0, 105, 220, 0.94) 100%);
  box-shadow:
    0 2rpx 8rpx rgba(0, 122, 255, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 0;
}

.key-type-slider.slider-right {
  transform: translateX(100%);
}

.key-type-slider.dragging {
  transition: none;
}

.key-type-option {
  width: 50%;
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 0;
  font-size: 22rpx;
  color: var(--text-secondary);
  border-radius: 15rpx;
  text-align: center;
  white-space: nowrap;
  box-sizing: border-box;
  transition: color 0.25s ease;
}

.key-type-option.opt-active {
  color: #fff;
  font-weight: 600;
}

.generate-btn {
  width: 375rpx;   /* 50% 屏幕宽度，显式固定（避免微信 button 默认宽度限制） */
  margin-left: auto;
  margin-right: auto;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.88) 0%,
    rgba(0, 105, 220, 0.94) 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 20rpx 0;
  border: none;
  box-shadow:
    0 2rpx 10rpx rgba(0, 122, 255, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: transform 0.06s ease, box-shadow 0.06s ease, filter 0.06s ease;
}
.generate-btn:active {
  transform: scale(0.97);
  filter: brightness(1.1);
}
.generate-btn[disabled] {
  opacity: 0.4;
}

/* ═══════════════ License Key Cards（与 admin-card 同构）═══════════════ */

.key-card-wrap {
  position: relative;
  margin-top: 14rpx;
  margin-bottom: 12rpx;
}

/* 入场动画：向下展开 + 回弹 */
@keyframes keySlideIn {
  from { opacity: 0; transform: translateY(-20rpx); max-height: 0; margin-bottom: 0; }
  to   { opacity: 1; transform: translateY(0);      max-height: 300rpx; margin-bottom: 12rpx; }
}
.key-entering {
  animation: keySlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  overflow: hidden;
}

/* 离场动画：上移 + 淡出 */
@keyframes keySlideOut {
  from { opacity: 1; transform: translateY(0);      max-height: 300rpx; margin-bottom: 12rpx; }
  to   { opacity: 0; transform: translateY(-20rpx); max-height: 0;        margin-bottom: 0; }
}
.key-exiting {
  animation: keySlideOut 0.3s ease-in both;
  overflow: hidden;
}

/* Delete button behind card */
.key-delete {
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 140rpx;
  background: linear-gradient(160deg, #FF5E5B 0%, #E8302B 100%);
  color: #fff;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  z-index: 0;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.10),
              0 2rpx 8rpx rgba(232,48,43,0.25);
  transition: opacity 0.15s ease, transform 0.06s ease;
}
/* 右滑归位时加速淡出 */
.key-card-wrap.quick-fade .key-delete {
  transition: opacity 0.05s ease;
}
.key-delete:active {
  background: linear-gradient(160deg, #E8302B 0%, #C82020 100%);
  transform: scale(0.95);
}

/* Key card body */
.key-card {
  position: relative;
  z-index: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 22rpx;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  transition: background-color 0.4s ease, color 0.35s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.key-card.no-transition {
  transition: none;
}

.key-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.key-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.key-right {
  margin-left: 16rpx;
}

.key-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 6rpx;
}

.key-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--blue);
  font-family: var(--font-mono);
  letter-spacing: 5rpx;
}

.key-countdown {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--orange);
  font-family: var(--font-mono);
}

.countdown-expired {
  color: var(--text-quaternary) !important;
}

/* Key actions */
.key-actions {
  display: flex;
  justify-content: flex-end;
}

.copy-btn {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--blue);
  background-color: rgba(0, 122, 255, 0.08);
  border-radius: var(--radius-sm);
  padding: 10rpx 32rpx;
  margin: 0;
  border: none;
  /* 按下由 tap-active 瞬时缩小，松手此过渡平滑恢复 */
  transition: transform 0.06s ease;
}
.copy-btn:active {
  background-color: rgba(0, 122, 255, 0.15);
}
.copy-btn-disabled {
  color: var(--text-quaternary) !important;
  background-color: var(--gray6) !important;
}
.btn-waiting {
  color: var(--text-tertiary) !important;
  background-color: var(--gray6) !important;
}
.btn-end-task {
  color: var(--red) !important;
  background-color: rgba(255, 59, 48, 0.08) !important;
}
.btn-confirm-admin {
  color: var(--green) !important;
  background-color: rgba(52, 199, 89, 0.08) !important;
}

/* Expired state */
.key-card-wrap.key-drawer-expired .key-value { color: var(--text-quaternary); }

/* User info in key drawer */
.key-user-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background-color: rgba(52, 199, 89, 0.06);
  border-radius: var(--radius-sm);
}

.key-user-avatar {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
}

.key-user-name {
  font-size: 24rpx;
  color: var(--green);
  font-weight: 600;
}

/* 结算按钮：靠右对齐（仅已使用且关联订单的密钥显示） */
.key-user-info .key-settle-btn {
  margin-left: auto;
}

/* ═══════════════ Guest: Redeem Key ═══════════════ */

.redeem-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-bottom: 18rpx;
  display: block;
}

.redeem-input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.redeem-input {
  flex: 1;
  height: 68rpx;
  background-color: var(--gray6);
  border-radius: var(--radius-sm);
  padding: 0 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  font-family: var(--font-mono);
  text-transform: uppercase;
}

/* 粘贴按钮（输入框右侧） */
.redeem-paste-btn {
  flex-shrink: 0;
  height: 68rpx;
  background-color: var(--gray6);
  color: var(--blue);
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--radius-sm);
  padding: 0 22rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 122, 255, 0.2);
}
.redeem-paste-btn:active {
  background-color: rgba(0, 122, 255, 0.08);
}

/* 验证按钮（输入框下方，居中，1/4屏幕宽） */
.redeem-btn {
  width: 50%;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.88) 0%,
    rgba(0, 105, 220, 0.94) 100%);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 18rpx 0;
  margin: 0 auto;
  border: none;
  box-shadow:
    0 2rpx 10rpx rgba(0, 122, 255, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: transform 0.06s ease, filter 0.06s ease;
}
.redeem-btn:active {
  transform: scale(0.97);
  filter: brightness(1.1);
}

/* ═══════════════ License Active (user) ═══════════════ */

.license-active {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 32rpx 28rpx;
  gap: 8rpx;
}

.license-status-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.license-status-icon {
  font-size: 36rpx;
}

.license-status-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--green);
}

.temp-countdown {
  font-size: 22rpx;
  color: var(--blue);
  font-family: var(--font-mono);
  margin-left: 50rpx;
}

/* ═══════════════ Storage Stats ═══════════════ */

.storage-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.storage-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.storage-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.retention-title {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 6rpx;
}

.retention-forever-hint {
  font-size: 20rpx;
  color: var(--orange);
  display: block;
  margin-bottom: 10rpx;
}

.retention-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.retention-stepper {
  display: flex;
  align-items: center;
}

.retention-stepper-btn {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: var(--glass-regular);
  border: var(--glass-border-dark);
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  transition: transform 0.06s ease, background-color 0.06s ease, box-shadow 0.06s ease;
}
.retention-stepper-btn:active {
  /* 经典短按问题修复：hover-class 在按下极短时来不及触发缩小过渡，
     改用 :active 伪类即时缩小（按下即生效，无 hover 时机依赖）。
     配合上方 transition: transform 0.06s 产生平滑缩放。 */
  transform: scale(0.9);
  background: rgba(0, 0, 0, 0.06);
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.06);
}
.retention-stepper-btn.stepper-disabled {
  color: var(--text-quaternary);
}

.retention-stepper-input {
  width: 72rpx;
  height: 52rpx;
  margin: 0 6rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  background-color: var(--bg-card);
  border: 1rpx solid transparent;
  border-radius: 12rpx;
  box-sizing: border-box;
  font-family: var(--font-mono);
}

/* 禁用态：阻止键盘弹起但保持外观不变 */
.retention-stepper-input[disabled] {
  opacity: 1;
  color: var(--text-primary);
  -webkit-text-fill-color: var(--text-primary);
}

.retention-unit {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.retention-save-btn {
  width: 375rpx;   /* 50% 屏幕宽度，显式固定（避免微信 button 默认宽度限制） */
  margin: 0 auto;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.88) 0%,
    rgba(0, 105, 220, 0.94) 100%);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 16rpx 0;
  margin: 0;
  border: none;
  box-shadow:
    0 2rpx 10rpx rgba(0, 122, 255, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
  transition: transform 0.06s ease, box-shadow 0.06s ease, filter 0.06s ease;
}
.retention-save-btn:active {
  transform: scale(0.97);
  filter: brightness(1.1);
  box-shadow:
    0 1rpx 4rpx rgba(0, 122, 255, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
}

/* ---- 防滥用设置：二级卡片 ---- */
.security-summary-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  /* transform 单独给短过渡，保证按压反馈迅速；
     背景/边框/阴影的过渡由外层 .page-root .security-summary-card 统一控制。 */
  transition: transform 0.12s ease, box-shadow 0.25s ease;
  will-change: transform;
}
/* 使用专用 pressing 类替代通用 tap-active，把背景色和缩放都集中到 hover-class，
   避免 :active 与 hover-class 触发时机不一致导致动画「闪」或短按不生效。 */
.security-summary-pressing {
  transform: scale(0.96);
  background-color: var(--gray6);
  transition: none;
}
.security-summary-active {
  box-shadow: var(--glass-shadow-md), var(--glass-rim);
}

.security-summary-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.security-summary-icon {
  font-size: 36rpx;
}

.security-summary-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.security-summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.security-summary-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.security-summary-arrow {
  font-size: 32rpx;
  color: var(--text-quaternary);
  transition: transform 0.25s ease;
  display: inline-block;
}

.security-detail {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  margin-top: 0;
  transition: max-height 0.3s ease, opacity 0.25s ease, margin-top 0.3s ease;
}
.security-detail-expanded {
  max-height: 2200rpx;
  opacity: 1;
  margin-top: 16rpx;
}

.security-detail-card {
  margin: 0;
}

.security-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.security-label-wrap {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.security-label {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.security-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 2rpx;
}

.security-stepper {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

/* 大数值（配额 MB 等）需要更宽输入框，容纳 6 位数（max 102400） */
.security-input {
  width: 108rpx;
}

/* 固定单位宽度：各条目单位长度不一（MB/小时/次/分/条/分/次/时），
   若让单位按内容自适应宽度，每行 [−][数值][+] 步进器的总宽会随单位漂移，
   导致加减按钮列左右错位。给单位固定宽后，每行步进器总宽一致，
   加减按钮列严格对齐。
   text-align: right：单位靠容器右缘（行尾）对齐，与 [+] 按钮拉开距离，
   避免单位文字紧贴按钮；同时单位文本右缘整齐。 */
.security-stepper .retention-unit {
  width: 80rpx;
  flex-shrink: 0;
  text-align: right;
  white-space: nowrap;
}

.delete-all-btn {
  width: 375rpx;   /* 50% 屏幕宽度，显式固定（避免微信 button 默认宽度限制） */
  margin-left: auto;
  margin-right: auto;
  margin-top: 12rpx;
  background: rgba(255, 59, 48, 0.06);
  color: var(--red);
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid rgba(255, 59, 48, 0.18);
  border-radius: var(--radius-md);
  padding: 14rpx 0;
  margin-top: 12rpx;
  box-shadow: none;
  transition: transform 0.06s ease, background-color 0.06s ease;
}
.delete-all-btn:active {
  transform: scale(0.97);
  background: rgba(255, 59, 48, 0.14);
}

/* ═══════════════ User List ═══════════════ */

.user-item {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 22rpx 28rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  transition: background-color 0.4s ease, color 0.35s ease, box-shadow 0.4s ease, border-color 0.4s ease;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: var(--gray5);
  margin-right: 18rpx;
}

.user-nickname {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  display: block;
  margin-bottom: 4rpx;
}

.user-licensed-at {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.user-license-key {
  font-size: 20rpx;
  color: var(--blue);
  font-family: var(--font-mono);
  margin-bottom: 2rpx;
}

/* ── User license detail card ── */
.user-license-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 28rpx;
}

.user-license-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-license-detail {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 18rpx;
  background-color: var(--gray6);
  border-radius: var(--radius-sm);
}

.license-detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.license-detail-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.license-detail-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.license-key-value {
  font-family: var(--font-mono);
  color: var(--blue);
  font-weight: 700;
  letter-spacing: 3rpx;
}

/* ═══════════════ Admin List (Super Admin) ═══════════════ */

.admin-card-wrap {
  position: relative;
  margin-bottom: 12rpx;
}

/* 离场动画：上移 + 淡出（与许可密钥 keySlideOut 一致） */
@keyframes adminSlideOut {
  from { opacity: 1; transform: translateY(0);     max-height: 200rpx; margin-bottom: 12rpx; }
  to   { opacity: 0; transform: translateY(-20rpx); max-height: 0;       margin-bottom: 0; }
}
.admin-exiting {
  animation: adminSlideOut 0.3s ease-in both;
  overflow: hidden;
}

.admin-delete {
  position: absolute;
  top: 0; right: 0; bottom: 0;
  width: 140rpx;
  background: linear-gradient(160deg, #FF5E5B 0%, #E8302B 100%);
  color: #fff;
  border-radius: var(--radius-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  z-index: 0;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.10),
              0 2rpx 8rpx rgba(232, 48, 43, 0.25);
  transition: opacity 0.15s ease, transform 0.06s ease;
}
.admin-delete:active {
  background: linear-gradient(160deg, #E8302B 0%, #C82020 100%);
  transform: scale(0.95);
}

/* Shared delete icon */
.delete-icon {
  font-size: 30rpx;
  line-height: 1;
}

.admin-card {
  position: relative;
  z-index: 1;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 22rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  transition: background-color 0.4s ease, color 0.35s ease, transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}
.admin-card.no-transition {
  transition: none;
}

.admin-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}
.admin-avatar-placeholder {
  background-color: var(--gray5);
}

.admin-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.admin-name {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.admin-badge {
  font-size: 20rpx;
  color: var(--blue);
  background-color: rgba(0, 122, 255, 0.08);
  border-radius: 10rpx;
  padding: 3rpx 12rpx;
  font-weight: 600;
}

/* ── 已临时授权的普通用户：卡片副信息 ── */
.temp-user-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
}

.temp-user-key {
  font-family: var(--font-mono);
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.temp-user-status {
  font-size: 18rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.temp-user-active {
  color: #2E7D32;
  background-color: rgba(46, 125, 50, 0.08);
}

.temp-user-expired {
  color: #E65100;
  background-color: rgba(230, 81, 0, 0.08);
}

/* ═══════════════ Order Cards ═══════════════ */

.status-box {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 0;
}

.status-text {
  font-size: 26rpx;
  color: var(--text-tertiary);
}

.order-card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 24rpx 28rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: 1rpx solid var(--separator);
  transition: background-color 0.4s ease, color 0.35s ease, box-shadow 0.4s ease, transform 0.06s ease;
}

.order-card:active {
  background-color: var(--gray6);
}

.order-expanded {
  box-shadow: var(--glass-shadow-md), var(--glass-rim);
}

.order-card-header {
  /* collapsed view container */
}

.order-card-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.order-filename {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
  letter-spacing: -0.01em;
}

.order-number-label {
  font-family: var(--font-mono);
  font-size: 20rpx;
  font-weight: 600;
  color: var(--blue);
  background: rgba(0, 122, 255, 0.06);
  border-radius: 6rpx;
  padding: 4rpx 14rpx;
  display: inline-block;
  margin-top: -4rpx;
  margin-bottom: 12rpx;
  letter-spacing: 0.02em;
}

/* ── Status tags ── */
.order-status {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
}

/* v24.1：管理员自行打印订单徽标 */
.order-self-print-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
  background-color: rgba(30, 102, 245, 0.10);
  color: #1e66f5;
  margin-left: 8rpx;
}

/* v5.17：订单来源类型标签（云端 / 本地） */
.order-source-tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  white-space: nowrap;
  margin-left: 8rpx;
}
.order-source-tag.tag-local { background-color: rgba(22, 163, 74, 0.12); color: #16a34a; }
.order-source-tag.tag-cloud { background-color: rgba(0, 122, 255, 0.12); color: #007AFF; }

.status-queued    { background-color: #FFF3E0; color: #E65100; }
.status-printing  { background-color: #E3F2FD; color: #1565C0; }
.status-accepted  { background-color: #E3F2FD; color: #1565C0; }
.status-offline_unknown { background-color: #FFF8E1; color: #F57F17; }
.status-sent      { background-color: #E8F5E9; color: #2E7D32; }
.status-failed    { background-color: #FFEBEE; color: #C62828; }
.status-abandoned { background-color: #F3E5F5; color: #7B1FA2; }
.status-reserved  { background-color: #FFF8E1; color: #F57F17; }
.status-rejected  { background-color: #FFF3E0; color: #E65100; }
.status-canceled  { background-color: #F5F5F5; color: #9E9E9E; }
.status-scheduled    { background-color: #FFF8E1; color: #F57F17; }
.status-downloading  { background-color: #E3F2FD; color: #1565C0; }
.status-waiting      { background-color: #FFF3E0; color: #E65100; }
.status-delivered { background-color: #E8F5E9; color: #2E7D32; }

.order-card-meta {
  display: flex;
  gap: 24rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 2rpx;
  margin-bottom: 10rpx;
}

.order-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-created {
  font-size: 20rpx;
  color: var(--text-quaternary);
  font-family: var(--font-mono);
}

.order-arrow {
  font-size: 28rpx;
  color: var(--text-quaternary);
  transition: transform 0.25s ease;
  display: inline-block;
}

.arrow-up {
  transform: rotate(90deg);
  color: var(--blue);
}

/* ═══════════════ Order Detail (Expanded) ═══════════════ */

.order-card-detail {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transition: max-height 0.3s ease, opacity 0.25s ease;
}
.order-card-detail.detail-expanded {
  max-height: 2000rpx;
  opacity: 1;
}

.detail-divider {
  height: 1rpx;
  background-color: var(--separator);
  margin: 16rpx 0;
}

.detail-section {
  margin-bottom: 20rpx;
}

.detail-section-title {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.detail-label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.detail-value {
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
}

/* 价格行 — 视觉突出 */
.detail-price-row {
  padding: 16rpx 0 8rpx;
}
.detail-price-value {
  font-size: 28rpx;
  font-weight: 700;
  font-family: var(--font-mono);
}
/* 合计价格跟随订单状态色（复用 status-* 主题色），去掉状态类的底色 */
.detail-price-value.status-queued,
.detail-price-value.status-printing,
.detail-price-value.status-accepted,
.detail-price-value.status-offline_unknown,
.detail-price-value.status-sent,
.detail-price-value.status-failed,
.detail-price-value.status-abandoned,
.detail-price-value.status-reserved,
.detail-price-value.status-rejected,
.detail-price-value.status-canceled,
.detail-price-value.status-scheduled,
.detail-price-value.status-downloading,
.detail-price-value.status-waiting,
.detail-price-value.status-delivered {
  background-color: transparent;
}
/* v4.4：自打订单已完成（sent）→ 金额用「自打」标记同色（蓝），自打不计入收益，避免绿色误导；
   其他状态（失败/等待/放弃等）仍用状态色突出 */
.detail-price-value.is-self-sent { color: #1e66f5 !important; }

/* File rows in detail */
.detail-file-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  background-color: var(--gray6);
  border-radius: var(--radius-sm);
  padding: 16rpx 18rpx;
  margin-bottom: 8rpx;
}

.detail-file-info {
  flex: 1;
  min-width: 0;
  margin-right: 14rpx;
}

.detail-file-name {
  display: block;
  font-size: 24rpx;
  color: var(--text-primary);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 6rpx;
}

.detail-file-tags {
  display: flex;
  gap: 8rpx;
}

.file-type-tag {
  font-size: 18rpx;
  color: var(--blue);
  background-color: rgba(0, 122, 255, 0.08);
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.file-size-tag {
  font-size: 18rpx;
  color: var(--text-tertiary);
}

.detail-file-right {
  flex-shrink: 0;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.detail-file-copies {
  font-size: 22rpx;
  color: var(--text-secondary);
  font-weight: 500;
}

.detail-file-range {
  font-size: 18rpx;
  color: var(--orange);
}

/* Reject reason text */
.file-reject-reason {
  display: block;
  font-size: 18rpx;
  color: var(--red);
  margin-top: 6rpx;
  line-height: 1.4;
  text-align: right;
  word-break: break-all;
}

/* Cancel order button */
.btn-cancel-sm {
  width: 100%;
  background-color: transparent;
  color: var(--red);
  border: 2rpx solid var(--red);
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  padding: 16rpx 0;
}
.btn-cancel-sm:active {
  background-color: rgba(255, 59, 48, 0.06);
}

/* ═══════════════ Pagination Bar ═══════════════ */

.orders-pagination-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  margin-bottom: 10rpx;
}

.pagination-bottom {
  margin-top: 20rpx;
  justify-content: center;
}

/* ── Page Size Selector ── */
.page-size-selector {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  background-color: var(--bg-card);
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-sm);
  font-size: 22rpx;
  color: var(--text-secondary);
  z-index: 101;
}

.page-size-selector:active {
  background-color: var(--gray6);
}

.page-size-text {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.page-size-arrow {
  font-size: 16rpx;
  transition: transform 0.2s ease;
  display: inline-block;
}

.page-size-arrow.arrow-up {
  transform: rotate(180deg);
}

.page-size-dropdown {
  position: fixed;
  min-width: 160rpx;
  /* 已移至 page-root 外（fixed），逃出 translateY 变换层，backdrop-filter 可正常采样 */
  background-color: rgba(255, 255, 255, 0.82);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-radius: var(--radius-sm);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  z-index: 900;
  opacity: 0;
  transform: translateY(-8rpx);
  pointer-events: none;
  transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.45s ease, box-shadow 0.45s ease;
  overflow: hidden;
}

.page-size-dropdown.dropdown-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.page-size-option {
  padding: 18rpx 24rpx;
  font-size: 24rpx;
  color: var(--text-primary);
  transition: color 0.35s ease, background-color 0.45s ease;
}

.page-size-option:active {
  background-color: var(--gray6);
}

.page-size-option.option-active {
  color: var(--blue);
  font-weight: 600;
  background-color: rgba(0, 122, 255, 0.06);
}

/* ── Page Navigation ── */
.page-nav {
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.page-btn, .page-num {
  min-width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: 24rpx;
  color: var(--text-secondary);
  background-color: var(--bg-card);
  box-shadow: var(--shadow-sm);
}

.page-btn:active, .page-num:active {
  background-color: var(--gray6);
}

.page-btn-disabled {
  color: var(--text-quaternary) !important;
  pointer-events: none;
}

.page-num-active {
  background-color: var(--blue) !important;
  color: #fff !important;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.3);
}

.page-ellipsis {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-quaternary);
}

/* ── End hint ── */
.end-hint {
  display: flex;
  justify-content: center;
  padding: 30rpx 0 50rpx;
}

.end-hint-text {
  font-size: 22rpx;
  color: var(--text-quaternary);
}

/* ═══════════════ Dark Mode ═══════════════ */
.theme-dark .role-btn:active,
.theme-dark .security-summary-pressing {
  background: rgba(255, 255, 255, 0.06);
}
.theme-dark .order-card:active {
  background: rgba(255, 255, 255, 0.04);
}
.theme-dark .key-user-info {
  background: rgba(52, 199, 89, 0.10);
}
.theme-dark .retention-stepper-btn:active {
  background: rgba(255, 255, 255, 0.10);
}
.theme-dark .retention-stepper-input {
  background: #2C2C2E;
  border-color: rgba(84, 84, 88, 0.30);
}
.theme-dark .redeem-input {
  background: rgba(255, 255, 255, 0.08);
  border-color: rgba(84, 84, 88, 0.30);
  color: var(--text-primary);
}
.theme-dark .redeem-paste-btn {
  background: var(--glass-regular);
  border-color: rgba(0, 122, 255, 0.20);
}
.theme-dark .delete-all-btn {
  background: rgba(255, 59, 48, 0.08);
  border-color: rgba(255, 59, 48, 0.15);
  color: #FF6B6B;
}
.theme-dark .delete-all-btn:active {
  background: rgba(255, 59, 48, 0.16);
}
.theme-dark .copy-btn {
  background: rgba(0, 122, 255, 0.12);
  color: var(--blue-light);
}
.theme-dark .copy-btn:active {
  background: rgba(0, 122, 255, 0.18);
}
.theme-dark .btn-waiting {
  background: rgba(255, 255, 255, 0.05) !important;
  color: var(--text-quaternary) !important;
}
.theme-dark .btn-end-task {
  background: rgba(255, 59, 48, 0.12) !important;
}
.theme-dark .btn-confirm-admin {
  background: rgba(52, 199, 89, 0.12) !important;
}
.theme-dark .btn-cancel-sm:active {
  background: rgba(255, 59, 48, 0.10);
}
.theme-dark .detail-divider {
  background-color: rgba(84, 84, 88, 0.35);
}
.theme-dark .page-size-option:active {
  background: rgba(255, 255, 255, 0.06);
}
.theme-dark .page-size-option.option-active {
  background: rgba(0, 122, 255, 0.12);
}
.theme-dark .file-type-tag {
  background: rgba(0, 122, 255, 0.12);
}
.theme-dark .storage-divider {
  background-color: rgba(84, 84, 88, 0.30);
}

/* 深色模式：密钥类型滑轨加亮 */
.theme-dark .key-type-slider {
  background: linear-gradient(180deg,
    rgba(64, 156, 255, 0.92) 0%,
    rgba(30, 130, 240, 0.96) 100%);
  box-shadow:
    0 2rpx 10rpx rgba(64, 156, 255, 0.35),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.25);
}

/* ==================== 账号绑定入口（管理功能在独立页面） ==================== */

.role-btn-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}
.role-btn-text-wrap .role-btn-text {
  flex: none;
}
.role-btn-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.4;
}

