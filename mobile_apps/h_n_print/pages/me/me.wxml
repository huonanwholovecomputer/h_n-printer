<!--me.wxml-->
<page-meta root-background-color="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" background-color="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" background-color-top="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" background-color-bottom="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" page-style="--tab-highlight:{{isDarkMode ? 'rgba(255,255,255,0.12)' : 'rgba(255,255,255,0.7)'}};--tab-bg:{{isDarkMode ? 'rgba(26,26,28,0.50)' : 'var(--glass-regular)'}};--tab-text:{{isDarkMode ? '#98989D' : '#8E8E93'}};--tab-text-active:{{isDarkMode ? '#409CFF' : '#007AFF'}}"></page-meta>
<navigation-bar title="我" back="{{false}}" color="{{isDarkMode ? 'white' : 'black'}}" background="transparent" extClass="{{isDarkMode ? 'theme-dark' : ''}}"></navigation-bar>

<wxs module="scroll" src="../../utils/scroll.wxs"></wxs>

<!-- theme-bg-layer 在 page-root 外，始终可见，确保淡入淡出间隙不露原生白色背景 -->
<view class="theme-bg-layer {{isDarkMode ? 'bg-dark' : ''}}"></view>

<!-- 深色模式切换按钮（page-root 外，避免与原生 type="nickname" 输入层冲突） -->
<view class="theme-toggle-btn {{isDarkMode ? 'theme-dark' : ''}}" style="top: {{navBarBtnTop}}px;" bindtap="onToggleTheme" hover-class="tp-pressing" hover-stay-time="0">
  <text>{{themeMode === 'auto' ? '🌓' : (themeMode === 'dark' ? '🌙' : '☀️')}}</text>
</view>

<view class="page-root {{pageSlide}} {{pageExit}} {{isDarkMode ? 'theme-dark' : ''}}">
  <!-- 返回顶部按钮（右下角） -->
  <view class="scroll-top-btn {{showScrollTop ? 'scroll-top-visible' : ''}}" bindtap="onScrollToTop" hover-class="tap-active">
    <view class="scroll-top-arrow">
      <view class="arrow-bar arrow-left"></view>
      <view class="arrow-bar arrow-right"></view>
    </view>
  </view>
  <!-- 自定义滚动容器：负责橡皮筋回弹物理（与首页一致） -->
  <view
    class="scroller"
    prop="{{scrollConfig}}"
    change:prop="{{scroll.onConfig}}"
    cmd="{{scrollCmd}}"
    change:cmd="{{scroll.onCmd}}"
    bindtouchstart="{{scroll.touchstart}}"
    bindtouchmove="{{scroll.touchmove}}"
    bindtouchend="{{scroll.touchend}}"
    bindtouchcancel="{{scroll.touchend}}"
  >
    <view class="scroll-content">
      <view class="container">

    <!-- 用户信息卡片（右侧许可密钥徽章可点击展开详情） -->
    <view class="user-card-wrap">
      <view class="user-card ">
        <view class="avatar-btn" bindtap="onChooseAvatar" hover-class="avatar-hover">
          <image class="avatar" src="{{avatarUrl || '/images/default-avatar.png'}}" mode="aspectFill"></image>
        </view>
        <view class="user-info">
          <view class="nickname-row" bindtap="onTapNickname" hover-class="tap-active">
            <text class="nickname-text">{{nickname || '点击设置昵称'}}</text>
            <text class="nickname-edit-icon">✎</text>
          </view>
          <text class="uid">{{isSuperAdmin ? '超级管理员' : (userRole === 'admin' ? '管理员' : (userRole === 'user' ? '普通用户' : '访客'))}}</text>
          <!-- 隐藏的原生 type="nickname" 输入，触发微信内置昵称自动填充 -->
          <input class="hidden-nickname-input" type="nickname" focus="{{focusWechatNickname}}" bindinput="onHiddenNicknameInput" bindblur="onHiddenNicknameBlur" />
        </view>
        <!-- 许可密钥徽章（临时授权或通过密钥升级的管理员）：点击向下展开详情 -->
        <view wx:if="{{licenseInfo}}" class="license-badge {{userRole === 'admin' || licenseInfo.type === 'admin' ? 'license-badge-admin' : (licenseInfo.expired ? 'license-badge-expired' : 'license-badge-temp')}}"
              bindtap="onToggleLicenseDetail" hover-class="tap-active">
          <text class="license-badge-key">{{licenseInfo.key}}</text>
          <text class="license-badge-validity">{{userRole === 'admin' || licenseInfo.type === 'admin' ? '永久' : (licenseInfo.expired ? '已过期' : (tempCountdownText || '--'))}}</text>
        </view>
      </view>
      <!-- 许可密钥详情（展开态：创建/使用/到期时间） -->
      <view wx:if="{{licenseInfo}}" class="license-detail {{showLicenseDetail ? 'license-detail-expanded' : ''}}">
        <view class="detail-divider"></view>
        <view class="detail-row">
          <text class="detail-label">当前状态</text>
          <text class="detail-value {{userRole === 'admin' || licenseInfo.type === 'admin' ? 'license-status-permanent' : (licenseInfo.expired ? 'license-status-expired' : 'license-status-ok')}}">{{userRole === 'admin' || licenseInfo.type === 'admin' ? '永久' : (licenseInfo.expired ? '已过期' : '有效')}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">许可密钥</text>
          <text class="detail-value license-key-value">{{licenseInfo.key}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">密钥类型</text>
          <text class="detail-value">{{licenseInfo.type === 'admin' ? '管理员许可' : '临时许可'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">授权人</text>
          <text class="detail-value">{{licenseInfo.creator_nickname || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">创建时间</text>
          <text class="detail-value">{{licenseInfo.created_at || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">使用时间</text>
          <text class="detail-value">{{licenseInfo.used_at || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">到期时间</text>
          <text class="detail-value">{{licenseInfo.expires_at || '—'}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">有效时长</text>
          <text class="detail-value">{{licenseInfo.validity_minutes ? licenseInfo.validity_minutes + ' 分钟' : '—'}}</text>
        </view>
      </view>
    </view>

    <!-- 管理员：生成许可密钥 -->
    <view class="license-section admin-collapsible {{userRole === 'admin' ? 'admin-expanded' : ''}}">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>生成许可密钥</text>
        <text wx:if="{{activeKeys.length > 0}}" class="order-count">{{activeKeys.length}}</text>
      </view>
      <view class="license-card">
        <text class="license-label">有效时间（分钟）</text>
        <view class="stepper license-stepper">
          <view class="stepper-btn {{minusDisabled ? 'stepper-disabled' : ''}}" catchtap="onLicenseMinutesMinus" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">−</view>
          <input class="stepper-input" type="number" value="{{licenseMinutes}}" disabled />
          <view class="stepper-btn {{plusDisabled ? 'stepper-disabled' : ''}}" catchtap="onLicenseMinutesPlus" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">+</view>
        </view>
        <!-- 超级管理员：许可密钥类型选择 -->
        <view wx:if="{{isSuperAdmin}}" class="key-type-row">
          <text class="key-type-label">密钥类型</text>
          <view class="key-type-toggle" data-seg="keytype" data-index="0"
                bindtouchstart="onSegTouchStart" bindtouchmove="onSegTouchMove" bindtouchend="onSegTouchEnd" bindtouchcancel="onSegTouchEnd">
            <view class="key-type-slider {{keyType === 'admin' ? 'slider-right' : ''}} {{segDrag['keytype-0'] >= 0 ? 'dragging' : ''}}"
                  style="{{segDrag['keytype-0'] >= 0 ? ('transform: translateX(' + segDrag['keytype-0'] + '%);') : ''}}"></view>
            <view class="key-type-option {{keyType === 'temp' ? 'opt-active' : ''}}" bindtap="onSelectKeyType" data-type="temp" hover-class="tap-active">临时许可</view>
            <view class="key-type-option {{keyType === 'admin' ? 'opt-active' : ''}}" bindtap="onSelectKeyType" data-type="admin" hover-class="tap-active">管理员许可</view>
          </view>
        </view>
        <button class="generate-btn" bindtap="onGenerateKey" hover-class="generate-hover" loading="{{generating}}" disabled="{{generating}}">生成许可密钥</button>
      </view>

      <!-- 活跃密钥列表（与管理员卡片同构：扁平 wrap + 滑出删除） -->
      <view wx:for="{{activeKeys}}" wx:key="key"
            class="key-card-wrap {{item.entering ? 'key-entering' : ''}} {{item.exiting ? 'key-exiting' : ''}} {{item.deleteQuickFade ? 'quick-fade' : ''}} {{item.expired && item.status === 'unused' ? 'key-drawer-expired' : ''}}">
        <!-- 右侧删除按钮（绝对定位，左滑时露出；已使用密钥删除后归档，授权记录保留在历史授权用户中） -->
        <view class="key-delete" catchtap="onRevokeKey" data-idx="{{index}}"
              style="opacity: {{item.deleteOpacity}}">
          <text class="delete-icon">🗑</text>
          <text>{{item.status === 'unused' ? '作废' : '删除'}}</text>
        </view>
        <!-- 卡片本体：可左滑 -->
        <view class="key-card {{item.swipeTransition === false ? 'no-transition' : ''}}"
              style="transform: translateX({{item.swipeX}}px);{{item.swipeTransition === false ? 'transition: none;' : (item.swipeTransition === true ? 'transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);' : '')}}"
              bindtouchstart="onKeyTouchStart"
              bindtouchmove="onKeyTouchMove"
              bindtouchend="onKeyTouchEnd"
              bindtouchcancel="onKeyTouchEnd"
              data-idx="{{index}}">
          <view class="key-row">
            <view class="key-left">
              <text class="key-label">{{item.type === 'admin' ? '管理员密钥' : '许可密钥'}}</text>
              <text class="key-value">{{item.key}}</text>
            </view>
            <view class="key-right">
              <text wx:if="{{item.status === 'unused'}}" class="key-countdown {{item.expired ? 'countdown-expired' : ''}}">{{item.countdownText}}</text>
              <text wx:else class="key-countdown">已使用</text>
            </view>
          </view>
          <view wx:if="{{item.status !== 'unused'}}" class="key-user-info">
            <image wx:if="{{item.used_by_avatar_url}}" class="key-user-avatar" src="{{item.used_by_avatar_url}}" mode="aspectFill" />
            <text class="key-user-name">{{item.used_by_nickname}}</text>
            <button wx:if="{{item.order_id}}" class="copy-btn key-settle-btn" bindtap="onEndPrintTask" data-idx="{{index}}" hover-class="tap-active">结算</button>
          </view>
          <view class="key-actions">
            <button wx:if="{{item.status === 'unused' && !item.expired}}" class="copy-btn" bindtap="onCopyKey" data-idx="{{index}}" hover-class="tap-active">复制</button>
            <button wx:elif="{{item.status === 'unused' && item.expired}}" class="copy-btn copy-btn-disabled">已过期</button>
            <button wx:elif="{{item.status === 'used_waiting' && item.type === 'admin'}}" class="copy-btn btn-confirm-admin" bindtap="onConfirmAdminKey" data-idx="{{index}}" hover-class="tap-active">确认并关闭</button>
            <button wx:elif="{{item.status === 'used_waiting' && item.type !== 'admin'}}" class="copy-btn btn-waiting" disabled>等待任务中</button>
          </view>
        </view>
      </view>
    </view>

    <!-- 账号绑定入口（管理功能收进独立页面，不在首页常驻展示） -->
    <view class="role-actions" style="animation-delay: 0.06s">
      <view class="role-btn user-btn" bindtap="onGoBindPage" hover-class="role-btn-pressing" hover-start-time="0" hover-stay-time="100">
        <text class="role-btn-icon">🔗</text>
        <view class="role-btn-text-wrap">
          <text class="role-btn-text">账号绑定（APP）</text>
          <text class="role-btn-desc">{{bindDeviceCount > 0 ? '已绑定 ' + bindDeviceCount + ' 台设备' : '管理微信小程序与 APP 的账号绑定'}}</text>
        </view>
        <text class="role-btn-arrow">›</text>
      </view>
    </view>

    <!-- 访客：验证许可密钥 -->
    <view wx:if="{{userRole === 'guest'}}" class="license-section">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>验证许可密钥</text>
      </view>
      <view class="license-card">
        <text class="redeem-desc">请输入管理员提供的许可密钥以获取打印权限</text>
        <view class="redeem-input-row">
          <input class="redeem-input" type="text" value="{{redeemKey}}" bindinput="onRedeemKeyInput" placeholder="请输入8位密钥" maxlength="8" />
          <button class="redeem-paste-btn" bindtap="onPasteKey" hover-class="tap-active">粘贴</button>
        </view>
        <button class="redeem-btn" bindtap="onRedeemKey" loading="{{redeeming}}" disabled="{{redeeming}}" hover-class="tap-active">验证</button>
      </view>
    </view>

    <!-- 普通用户 / 临时授权：已获得许可 -->
    <view wx:if="{{userRole === 'user'}}" class="license-section">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>打印许可</text>
      </view>
      <view class="license-card user-license-card">
        <view class="user-license-header">
          <text class="license-status-icon">✅</text>
          <text class="license-status-text">您已获得打印许可</text>
        </view>
        <view wx:if="{{licenseInfo}}" class="user-license-detail">
          <view class="license-detail-row">
            <text class="license-detail-label">许可密钥</text>
            <text class="license-detail-value license-key-value">{{licenseInfo.key}}</text>
          </view>
          <view class="license-detail-row">
            <text class="license-detail-label">授权人</text>
            <text class="license-detail-value">{{licenseInfo.creator_nickname}}</text>
          </view>
        </view>
        <text wx:if="{{tempCountdownText}}" class="temp-countdown">{{tempCountdownText}}</text>
      </view>
    </view>

    <!-- 管理员：存储统计 -->
    <view class="storage-section admin-collapsible {{userRole === 'admin' && storageStats ? 'admin-expanded' : ''}}" style="animation-delay: 0.08s">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>服务器存储</text>
      </view>
      <view class="storage-card">
        <view class="storage-row">
          <text class="storage-label">📄 缓存文件</text>
          <text class="storage-value">{{storageStats.total_files}} 个</text>
        </view>
        <view class="storage-row">
          <text class="storage-label">💾 占用空间</text>
          <text class="storage-value">{{storageStats.total_size_display}}</text>
        </view>
        <!-- 保留时间设置 -->
        <view class="storage-divider"></view>
        <text class="retention-title">文件保留时间</text>
        <text wx:if="{{retentionDays === 0 && retentionHours === 0}}" class="retention-forever-hint">当前为「永不过期」</text>
        <view class="retention-row">
          <view class="retention-stepper">
            <view class="retention-stepper-btn {{retentionDays <= 0 ? 'stepper-disabled' : ''}}" catchtap="onRetentionDaysMinus" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">−</view>
            <input class="retention-stepper-input" type="number" value="{{retentionDays}}" disabled />
            <view class="retention-stepper-btn" catchtap="onRetentionDaysPlus" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">+</view>
          </view>
          <text class="retention-unit">天</text>
          <view class="retention-stepper">
            <view class="retention-stepper-btn {{retentionHours <= 0 ? 'stepper-disabled' : ''}}" catchtap="onRetentionHoursMinus" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">−</view>
            <input class="retention-stepper-input" type="number" value="{{retentionHours}}" disabled />
            <view class="retention-stepper-btn" catchtap="onRetentionHoursPlus" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">+</view>
          </view>
          <text class="retention-unit">小时</text>
        </view>
        <button class="retention-save-btn" bindtap="onSaveRetention" loading="{{savingRetention}}" disabled="{{savingRetention}}" hover-class="tap-active">保存设置</button>
        <button class="delete-all-btn" bindtap="onDeleteAllFiles" loading="{{deletingAllFiles}}" disabled="{{deletingAllFiles}}" hover-class="tap-active">⚠️ 删除全部缓存文件</button>
      </view>
    </view>

    <!-- 管理员：防滥用设置（DDoS 防护阈值） -->
    <view class="security-section admin-collapsible {{userRole === 'admin' && securityConfig ? 'admin-expanded' : ''}}" style="animation-delay: 0.10s">
      <!-- 一级卡片：点击展开/收起所有设置项 -->
      <view class="security-summary-card {{securityExpanded ? 'security-summary-active' : ''}}" bindtap="onToggleSecurity" hover-class="security-summary-pressing" hover-start-time="0" hover-stay-time="100">
        <view class="security-summary-left">
          <text class="security-summary-icon">🛡️</text>
          <view class="security-summary-text">
            <text class="security-summary-title">防滥用设置</text>
            <text class="security-summary-desc">点击管理 DDoS 防护阈值</text>
          </view>
        </view>
        <text class="security-summary-arrow {{securityExpanded ? 'arrow-up' : ''}}">›</text>
      </view>
      <!-- 二级设置面板 -->
      <view class="security-detail {{securityExpanded ? 'security-detail-expanded' : ''}}">
        <view class="storage-card security-detail-card">
          <text class="retention-title">以下阈值保存后立即生效（0 表示关闭对应检查）</text>
          <block wx:for="{{securityItems}}" wx:key="key">
            <view class="security-row">
              <view class="security-label-wrap">
                <text class="security-label">{{item.label}}</text>
                <text class="security-hint">{{item.hint}}</text>
              </view>
              <view class="security-stepper">
                <view class="retention-stepper-btn {{item.value <= item.min ? 'stepper-disabled' : ''}}" catchtap="onSecurityMinus" data-key="{{item.key}}" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">−</view>
                <input class="retention-stepper-input security-input" type="number" value="{{item.value}}" data-key="{{item.key}}" bindinput="onSecurityInput" />
                <view class="retention-stepper-btn {{item.value >= item.max ? 'stepper-disabled' : ''}}" catchtap="onSecurityPlus" data-key="{{item.key}}" hover-class="stepper-hover" hover-start-time="0" hover-stay-time="80" hover-stop-propagation="true">+</view>
                <text class="retention-unit">{{item.unit}}</text>
              </view>
            </view>
          </block>
          <button class="retention-save-btn" bindtap="onSaveSecurity" loading="{{savingSecurity}}" disabled="{{savingSecurity}}" hover-class="tap-active">保存防滥用设置</button>
        </view>
      </view>
    </view>

    <!-- 管理员/超级管理员：历史授权用户 -->
    <view class="role-actions admin-collapsible {{userRole === 'admin' ? 'admin-expanded' : ''}}" style="animation-delay: 0.14s">
      <view class="role-btn user-btn" bindtap="onGoAuthorizedUsers" hover-class="role-btn-pressing" hover-start-time="0" hover-stay-time="100">
        <text class="role-btn-icon">👥</text>
        <text class="role-btn-text">历史授权用户</text>
        <text class="role-btn-arrow">›</text>
      </view>
    </view>

    <!-- 管理员/超级管理员：本地打印任务 -->
    <view class="role-actions admin-collapsible {{userRole === 'admin' || isSuperAdmin ? 'admin-expanded' : ''}}" style="animation-delay: 0.16s">
      <view class="role-btn user-btn" bindtap="onGoLocalOrders" hover-class="role-btn-pressing" hover-start-time="0" hover-stay-time="100">
        <text class="role-btn-icon">🖨️</text>
        <text class="role-btn-text">本地打印任务</text>
        <text class="role-btn-arrow">›</text>
      </view>
    </view>

    <!-- 超级管理员：管理员列表 -->
    <view wx:if="{{isSuperAdmin}}" class="license-section" style="animation-delay: 0.18s">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>管理管理员</text>
        <text wx:if="{{admins.length > 0}}" class="order-count">{{admins.length}}</text>
      </view>
      <view wx:if="{{admins.length === 0 && !adminsLoading}}" class="license-card">
        <text class="redeem-desc" style="text-align:center;margin:0;">暂无其他管理员</text>
      </view>
      <view wx:for="{{admins}}" wx:key="openid" class="admin-card-wrap {{item._exiting ? 'admin-exiting' : ''}}">
        <!-- 右侧删除按钮 -->
        <view class="admin-delete" catchtap="onRemoveAdmin" data-openid="{{item.openid}}"
              style="opacity: {{adminDeleteOpacity[item.openid] || 0}}">
          <text class="delete-icon">🗑</text>
          <text>移除</text>
        </view>
        <!-- 卡片本体：可左滑 -->
        <view class="admin-card {{adminSwipeTransition[item.openid] === false ? 'no-transition' : ''}}"
              style="transform: translateX({{adminSwipeX[item.openid] || 0}}px);{{adminSwipeTransition[item.openid] === false ? 'transition: none;' : (adminSwipeTransition[item.openid] === true ? 'transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);' : '')}}"
              bindtouchstart="onAdminTouchStart"
              bindtouchmove="onAdminTouchMove"
              bindtouchend="onAdminTouchEnd"
              bindtouchcancel="onAdminTouchEnd"
              data-openid="{{item.openid}}">
          <image class="admin-avatar" src="{{item.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="admin-info">
            <text class="admin-name">{{item.nickname}}</text>
            <text wx:if="{{item.is_super}}" class="admin-badge">超级管理员</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 管理员/超级管理员：已临时授权的普通用户（位于管理管理员下方；管理员同样位置） -->
    <view wx:if="{{userRole === 'admin'}}" class="license-section" style="animation-delay: 0.20s">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>已临时授权的普通用户</text>
        <text wx:if="{{tempUsers.length > 0}}" class="order-count">{{tempUsers.length}}</text>
      </view>
      <view wx:if="{{tempUsers.length === 0 && !tempUsersLoading}}" class="license-card">
        <text class="redeem-desc" style="text-align:center;margin:0;">暂无已临时授权的普通用户</text>
      </view>
      <view wx:for="{{tempUsers}}" wx:key="openid" class="admin-card-wrap {{item._exiting ? 'admin-exiting' : ''}}">
        <!-- 右侧删除按钮（左滑移除） -->
        <view class="admin-delete" catchtap="onRemoveTempUser" data-openid="{{item.openid}}"
              style="opacity: {{tempUserDeleteOpacity[item.openid] || 0}}">
          <text class="delete-icon">🗑</text>
          <text>移除</text>
        </view>
        <!-- 卡片本体：可左滑（仅移除，无点击跳转） -->
        <view class="admin-card {{tempUserSwipeTransition[item.openid] === false ? 'no-transition' : ''}}"
              style="transform: translateX({{tempUserSwipeX[item.openid] || 0}}px);{{tempUserSwipeTransition[item.openid] === false ? 'transition: none;' : (tempUserSwipeTransition[item.openid] === true ? 'transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);' : '')}}"
              bindtouchstart="onTempUserTouchStart"
              bindtouchmove="onTempUserTouchMove"
              bindtouchend="onTempUserTouchEnd"
              bindtouchcancel="onTempUserTouchEnd"
              data-openid="{{item.openid}}">
          <image class="admin-avatar" src="{{item.avatar_url || '/images/default-avatar.png'}}" mode="aspectFill" />
          <view class="admin-info">
            <text class="admin-name">{{item.nickname}}</text>
            <view class="temp-user-sub">
              <text class="temp-user-key">{{item.license_key}}</text>
              <text class="temp-user-status {{item.status === 'active' ? 'temp-user-active' : 'temp-user-expired'}}">{{item.status === 'active' ? '授权中' : '已过期'}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 我的打印任务 -->
    <view class="orders-section " style="animation-delay: 0.1s">
      <view class="section-title">
        <view class="section-bar"></view>
        <text>我的打印任务</text>
        <text wx:if="{{orders.length > 0}}" class="order-count">{{ordersTotal || orders.length}}</text>
      </view>

      <!-- 加载中 -->
      <view wx:if="{{loading}}" class="status-box">
        <text class="status-text">加载中...</text>
      </view>

      <!-- 加载失败 / 网络错误 -->
      <view wx:elif="{{loadError}}" class="status-box">
        <text class="status-text">{{loadError}}</text>
      </view>

      <!-- 空状态 -->
      <view wx:elif="{{orders.length === 0}}" class="empty-state">
        <view class="empty-illustration">
          <text class="empty-icon">📋</text>
        </view>
        <text class="empty-title">暂无任务</text>
        <text class="empty-desc">快去打印你的第一份文件吧</text>
      </view>

      <!-- 分页控制栏（顶部） -->
      <view class="orders-pagination-bar" wx:if="{{ordersTotalPages > 0}}">
        <view class="page-size-selector" bindtap="onToggleOrdersPageSize">
          <text class="page-size-text">{{ordersPerPage}}条/页</text>
          <text class="page-size-arrow {{showPageSizePicker ? 'arrow-up' : ''}}">▼</text>
        </view>
        <view class="page-nav">
          <view class="page-btn {{ordersCurrentPage <= 1 ? 'page-btn-disabled' : ''}}"
                bindtap="onOrdersPrevPage" hover-class="tap-active">‹</view>
          <block wx:for="{{ordersPageNumbers}}" wx:key="index">
            <view wx:if="{{item === '...'}}" class="page-ellipsis">…</view>
            <view wx:else
                  class="page-num {{ordersCurrentPage === item ? 'page-num-active' : ''}}"
                  bindtap="onOrdersPageChange" data-page="{{item}}" hover-class="tap-active">{{item}}</view>
          </block>
          <view class="page-btn {{ordersCurrentPage >= ordersTotalPages ? 'page-btn-disabled' : ''}}"
                bindtap="onOrdersNextPage" hover-class="tap-active">›</view>
        </view>
      </view>

      <!-- 任务列表 -->
      <view wx:for="{{orders}}" wx:key="id"
            class="order-card {{expandedOrders[item.id] ? 'order-expanded' : ''}}"
            bindtap="onOrderTap" data-id="{{item.id}}">
        <!-- 收缩态：一行摘要 -->
        <view class="order-card-header">
          <view class="order-card-main">
            <text class="order-filename">{{item.order_number || ('#' + item.id)}}</text>
            <text class="order-source-tag {{item.source === 'local' ? 'tag-local' : 'tag-cloud'}}">{{item.source === 'local' ? '🖨 本地' : '☁ 云端'}}</text>
            <text class="order-status status-{{item.status}} {{item.isExcel && item.status === 'sent' ? 'status-delivered' : ''}}">{{item.isExcel && item.status === 'sent' ? '已送达' : (statusMap[item.status] || item.status)}}</text>
            <text wx:if="{{item.is_admin_print}}" class="order-self-print-badge">👤自打</text>
          </view>
          <text class="order-number-label">{{item.file_summary || item.file}}</text>
          <view wx:if="{{item.isExcel}}" class="order-card-meta">
            <text class="order-card-stat">📄 不适用</text>
            <text class="order-card-stat">📋 不适用</text>
          </view>
          <view wx:else class="order-card-meta">
            <text class="order-card-stat">📄 {{item.total_pages || (item.page_count * item.copies)}} 页</text>
            <text class="order-card-stat">📋 {{item.total_copies || item.copies}} 份</text>
          </view>
          <view class="order-card-footer">
            <text class="order-created">{{item.created_at}}</text>
            <text class="order-arrow {{expandedOrders[item.id] ? 'arrow-up' : ''}}">›</text>
          </view>
        </view>

        <!-- 展开态：详细信息 -->
        <view class="order-card-detail {{expandedOrders[item.id] ? 'detail-expanded' : ''}}">
          <view class="detail-divider"></view>

          <!-- 打印信息 -->
          <view class="detail-section">
            <view class="detail-section-title">打印信息</view>
            <view class="detail-row">
              <text class="detail-label">提交时间</text>
              <text class="detail-value">{{item.created_at}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">合计页数</text>
              <text class="detail-value">{{item.isExcel ? '不适用' : (item.total_pages || (item.page_count * item.copies)) + ' 页'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">合计份数</text>
              <text class="detail-value">{{item.isExcel ? '不适用' : (item.total_copies || item.copies) + ' 份'}}</text>
            </view>
          </view>

          <!-- 临时许可密钥（订单消费的密钥） -->
          <view wx:if="{{item.license_info}}" class="detail-section">
            <view class="detail-section-title">临时许可密钥</view>
            <view class="detail-row">
              <text class="detail-label">密钥</text>
              <text class="detail-value license-key-value">{{item.license_info.key}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">使用时间</text>
              <text class="detail-value">{{item.license_info.used_at || '—'}}</text>
            </view>
            <view class="detail-row">
              <text class="detail-label">到期时间</text>
              <text class="detail-value">{{item.license_info.expires_at || '—'}}</text>
            </view>
          </view>

          <!-- 文件列表 -->
          <view wx:if="{{item.files && item.files.length > 0}}" class="detail-section">
            <view class="detail-section-title">文件列表 ({{item.files.length}})</view>
            <view wx:for="{{item.files}}" wx:for-item="f" wx:key="id" class="detail-file-row">
              <view class="detail-file-info">
                <text class="detail-file-name">{{f.original_name || f.file_name}}</text>
                <view class="detail-file-tags">
                  <text wx:if="{{f.file_type}}" class="file-type-tag">{{f.file_type}}</text>
                  <text wx:if="{{f.sizeDisplay}}" class="file-size-tag">{{f.sizeDisplay}}</text>
                </view>
              </view>
              <view class="detail-file-right">
                <text class="detail-file-copies">{{f.copies}} 份 × {{f.page_count}} 页</text>
                <text class="detail-file-range">{{f.duplex === 'on' ? '双面' : '单面'}}</text>
                <text wx:if="{{f.page_range}}" class="detail-file-range">范围: {{f.page_range}}</text>
                <text wx:if="{{(f.status === 'rejected' || f.status === 'failed') && f.reject_reason}}" class="file-reject-reason">{{f.reject_reason}}</text>
              </view>
            </view>
          </view>

          <!-- 附加服务 -->
          <view wx:if="{{item.urgency !== '低' || item.cover_page > 0 || item.delivery_enabled}}" class="detail-section">
            <view class="detail-section-title">附加服务</view>
            <view wx:if="{{item.urgency && item.urgency !== '低'}}" class="detail-row">
              <text class="detail-label">加急</text>
              <text class="detail-value">{{item.urgency === '高' ? '🚀 高' : '⚡ 中'}}<text wx:if="{{item.urgency_price > 0}}"> + ¥{{item.urgency_price}}</text></text>
            </view>
            <view wx:if="{{item.cover_page > 0}}" class="detail-row">
              <text class="detail-label">首页</text>
              <text class="detail-value">{{item.cover_page}} 页<text wx:if="{{item.cover_page_price > 0}}"> · ¥{{item.cover_page_price}}/页</text></text>
            </view>
            <view wx:if="{{item.delivery_enabled}}" class="detail-row">
              <text class="detail-label">派送</text>
              <text class="detail-value">{{item.delivery_location || '未指定地点'}}<text wx:if="{{item.delivery_percentage > 0}}"> · 加收 {{item.delivery_percentage}}%</text></text>
            </view>
          </view>

          <!-- 价格 -->
          <view class="detail-section">
            <view class="detail-row detail-price-row">
              <text class="detail-label">合计价格</text>
              <text class="detail-price-value status-{{item.status}}">¥{{item.totalPriceDisplay}}</text>
            </view>
          </view>

          <!-- 操作按钮 -->
          <view class="detail-actions">
            <button wx:if="{{item.status === 'queued' || item.status === 'printing'}}"
                    class="btn-cancel-sm" catchtap="onDetailCancelOrder" data-id="{{item.id}}">取消任务</button>
          </view>
        </view>
      </view>

      <!-- 底部分页 + 结束提示 -->
      <view class="orders-pagination-bar pagination-bottom" wx:if="{{ordersTotalPages > 1}}">
        <view class="page-nav">
          <view class="page-btn {{ordersCurrentPage <= 1 ? 'page-btn-disabled' : ''}}"
                bindtap="onOrdersPrevPage" hover-class="tap-active">‹</view>
          <block wx:for="{{ordersPageNumbers}}" wx:key="index">
            <view wx:if="{{item === '...'}}" class="page-ellipsis">…</view>
            <view wx:else
                  class="page-num {{ordersCurrentPage === item ? 'page-num-active' : ''}}"
                  bindtap="onOrdersPageChange" data-page="{{item}}" hover-class="tap-active">{{item}}</view>
          </block>
          <view class="page-btn {{ordersCurrentPage >= ordersTotalPages ? 'page-btn-disabled' : ''}}"
                bindtap="onOrdersNextPage" hover-class="tap-active">›</view>
        </view>
      </view>

      <view wx:if="{{ordersCurrentPage >= ordersTotalPages && ordersTotalPages > 0 && orders.length > 0}}" class="end-hint">
        <text class="end-hint-text">-- 没有更多内容啦 --</text>
      </view>

    </view>
    </view>
  </view>
</view>
</view>

  <!-- 昵称选择弹窗 -->
  <view wx:if="{{showNicknamePicker}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" catchtap="onCancelNicknamePicker">
    <view class="modal-sheet" catchtap="noop">
      <text class="title-medium" style="margin-bottom: 24rpx;">设置昵称</text>
      <button class="btn-primary" bindtap="onChooseWechatNickname" hover-class="tap-active" style="margin-bottom: 16rpx;">📱 使用微信昵称</button>
      <button class="btn-secondary" bindtap="onChooseCustomNickname" hover-class="tap-active">✏️ 使用自定义昵称</button>
      <view class="modal-buttons">
        <button class="btn-secondary modal-half-btn" bindtap="onCancelNicknamePicker" hover-class="tap-active">取消</button>
      </view>
    </view>
  </view>

  <!-- 分页下拉（page-root 外，position:fixed 逃出 translateY 变换层，保证 backdrop-filter 采样正常） -->
  <view class="{{isDarkMode ? 'theme-dark' : ''}}">
    <view class="page-size-dropdown {{showPageSizePicker ? 'dropdown-show' : ''}}" style="left: {{pageSizeDropdownLeft}}px; top: {{pageSizeDropdownTop}}px;">
      <view wx:for="{{pageOptions}}" wx:key="*this"
            class="page-size-option {{ordersPerPage === item ? 'option-active' : ''}}"
            catchtap="onSelectOrdersPageSize" data-size="{{item}}">
        {{item}} 条/页
      </view>
    </view>
  </view>

  <!-- 自定义昵称输入弹窗 -->
  <view wx:if="{{showNicknameInput}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" catchtap="onCancelCustomNickname">
    <view class="modal-sheet" catchtap="noop">
      <text class="title-medium" style="margin-bottom: 16rpx;">输入昵称</text>
      <input class="input-ios" type="text" value="{{customNickname}}" placeholder="请输入昵称" bindinput="onCustomNicknameInput" maxlength="20" style="margin-bottom: 24rpx;" />
      <view class="modal-buttons">
        <button class="btn-secondary modal-half-btn" bindtap="onCancelCustomNickname" hover-class="tap-active">取消</button>
        <button class="btn-primary modal-half-btn" bindtap="onSaveCustomNickname" hover-class="tap-active">保存</button>
      </view>
    </view>
  </view>

  <!-- 通用确认弹窗（在 page-root 外，position:fixed 锚定真实视口） -->
  <view wx:if="{{showConfirmModal}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" catchtap="onCancelConfirm">
    <view class="modal-sheet" catchtap="noop">
      <view class="modal-icon-wrap" style="background-color: rgba(255, 59, 48, 0.1); color: {{confirmModalConfirmColor || '#ff4d4f'}};">!</view>
      <text class="title-medium" style="margin-bottom: 8rpx;">{{confirmModalTitle}}</text>
      <text class="body-small">{{confirmModalContent}}</text>
      <view class="modal-buttons">
        <button class="btn-secondary modal-half-btn" bindtap="onCancelConfirm" hover-class="tap-active">取消</button>
        <button class="btn-primary modal-half-btn" style="background-color: {{confirmModalConfirmColor || '#ff4d4f'}};" bindtap="onConfirmModal" hover-class="tap-active">{{confirmModalConfirmText}}</button>
      </view>
    </view>
  </view>
