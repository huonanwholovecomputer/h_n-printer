/* myfile-detail.wxss — 「文件详情卡」的样式（2026-11-13 起）
   为什么要单独一个文件：这张卡（预览 swiper + shimmer 骨架 + 6 行 kv + 弹窗外壳）
   同时挂在「我」页的行内展开区、订单卡片的文件详情弹窗、以及「管理 → 某人的任务」页面；
   WXSS 是页面级的，两个页面都得 @import 这一份，别再各写一遍（改一处漏一处就是两套观感）。 */
/* 2026-11-13 用户要求 1「加上展开和收起动画」：
   外层只负责裁切与高度过渡，高度由 JS 量出真实值写进 style（内容高度随字段行数变化，
   CSS 里没法写死）；内层才是那张灰底小卡，它的 padding/圆角不受动画影响。 */
.myfile-detail {
  overflow: hidden;
  transition: height 240ms cubic-bezier(0.22, 0.61, 0.36, 1), opacity 180ms ease;
}
.myfile-detail-card {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 16rpx;
  background: rgba(120, 120, 128, 0.08);
}
.myfile-preview-wrap {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  border-radius: 12rpx;
  overflow: hidden;
}
/* 2026-11-13 用户要求 3「支持多页面」：原来是单张 <image>，现在一页一个 swiper-item；
   高度固定 420rpx，纵横比不同的 PDF 页/照片不会把卡片撑高到看不见下面的字段。 */
.myfile-preview-swiper {
  width: 100%;
  height: 420rpx;
  border-radius: 12rpx;
  background: rgba(120, 120, 128, 0.10);
}
.myfile-preview {
  display: block;
  width: 100%;
  height: 420rpx;
  border-radius: 12rpx;
  background: rgba(120, 120, 128, 0.10);
  /* 用户要求 1：真图加载完 220ms 淡入，把下面的骨架自然盖掉（零 JS 状态机） */
  opacity: 0;
  transition: opacity 220ms ease;
}
.myfile-preview-loaded {
  opacity: 1;
}
/* 加载骨架：三条横扫的渐变条 + 一行小字。灰度跟着主题变量走，深色下不刺眼。 */
.myfile-preview-skeleton {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(120, 120, 128, 0.10);
}
.myfile-preview-skeleton.page {
  position: static;
  width: 100%;
  height: 420rpx;
}
.myfile-skeleton-bar {
  width: 52%;
  height: 16rpx;
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, rgba(120, 120, 128, 0.14) 25%, rgba(120, 120, 128, 0.32) 37%, rgba(120, 120, 128, 0.14) 63%);
  background-size: 400% 100%;
  animation: myfileShimmer 1.25s ease-in-out infinite;
}
.myfile-skeleton-bar.short {
  width: 32%;
}
.myfile-skeleton-tip {
  margin-top: 22rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}
@keyframes myfileShimmer {
  0% { background-position: 100% 0; }
  100% { background-position: 0 0; }
}
/* 页码角标：多页时才显示（点图可全屏，双指缩放） */
.myfile-preview-pager {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 19rpx;
  line-height: 1.6;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.45);
}
.myfile-preview-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 180rpx;
  border-radius: 12rpx;
  background: rgba(120, 120, 128, 0.10);
}
.myfile-preview-icon {
  font-size: 52rpx;
}
.myfile-preview-tip {
  margin-top: 8rpx;
  padding: 0 20rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-align: center;
}
.myfile-kv {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 10rpx;
}
.myfile-k {
  flex: none;
  font-size: 21rpx;
  color: var(--text-tertiary);
}
.myfile-v {
  flex: 1;
  margin-left: 20rpx;
  font-size: 21rpx;
  color: var(--text-primary);
  text-align: right;
  word-break: break-all;
}

/* ==================== 订单卡片里的文件详情弹窗（2026-11-13） ==================== */
.filedetail-sheet {
  width: 660rpx;
  max-width: calc(100vw - 48rpx);
  box-sizing: border-box;
  max-height: 80vh;
}
.filedetail-body {
  width: 100%;
  box-sizing: border-box;
}
.filedetail-name {
  display: block;
  margin: 8rpx 0 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  word-break: break-all;
}
