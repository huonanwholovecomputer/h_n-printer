<!-- Apple-style Index Page — 提交打印 -->
<page-meta root-background-color="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" background-color="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" background-color-top="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" background-color-bottom="{{isDarkMode ? '#1C1C1E' : '#F2F2F7'}}" page-style="--tab-highlight:{{isDarkMode ? 'rgba(255,255,255,0.12)' : 'rgba(255,255,255,0.7)'}};--tab-bg:{{isDarkMode ? 'rgba(26,26,28,0.50)' : 'var(--glass-regular)'}};--tab-text:{{isDarkMode ? '#98989D' : '#8E8E93'}};--tab-text-active:{{isDarkMode ? '#409CFF' : '#007AFF'}}"></page-meta>
<navigation-bar title="提交打印" back="{{false}}" color="{{isDarkMode ? 'white' : 'black'}}" background="transparent" extClass="{{isDarkMode ? 'theme-dark' : ''}}"></navigation-bar>

<wxs module="scroll" src="../../utils/scroll.wxs"></wxs>

<!-- theme-bg-layer 在 page-root 外，始终可见，确保淡入淡出间隙不露原生白色背景 -->
<view class="theme-bg-layer {{isDarkMode ? 'bg-dark' : ''}} {{themeSwitching ? 'theme-switching' : ''}}"></view>

<view class="page-root {{pageSlide}} {{pageExit}} {{isDarkMode ? 'theme-dark' : ''}} {{themeSwitching ? 'theme-switching' : ''}}">
  <view
    class="scroller"
    prop="{{scrollConfig}}"
    change:prop="{{scroll.onConfig}}"
    bindtouchstart="{{scroll.touchstart}}"
    bindtouchmove="{{scroll.touchmove}}"
    bindtouchend="{{scroll.touchend}}"
    bindtouchcancel="{{scroll.touchend}}"
  >
    <view class="scroll-content">
      <view class="container">

        <!-- Logo + Status -->
        <view class="header-area {{entranceDone ? '' : (entered.logo ? 'entrance-play' : 'card-preload')}}">
          <view class="logo-wrap" style="transform-origin: center top;">
            <!-- bindload：widthFix 图片在解码完成前高度为 0，首测会漏掉整块页头 ⇒ 解码后补测 -->
            <image class="logo" src="/images/HN_print.png" mode="widthFix" style="width: 320rpx;" bindload="onLogoLoad" />
          </view>
        </view>

        <!-- Printer Status -->
        <view class="status-bar {{entranceDone ? '' : (entered.statusBar ? 'entrance-play' : 'card-preload')}} {{printerActive ? 'status-active' : 'status-inactive'}}">
          <view class="status-dot"></view>
          <text class="status-text">{{printerActive ? '打印机在线' : '打印机离线'}}</text>
        </view>

        <!-- 可接单设备选择（2026-12 多设备接单：选择向哪台设备发送打印任务；离线设备也允许选择，任务排队等其上线） -->
        <view wx:if="{{claimingDevices.length > 0}}" class="card device-select-card {{entranceDone ? '' : (entered.statusBar ? 'entrance-play' : 'card-preload')}}">
          <view class="section-header inline-header">
            <view class="section-header-bar"></view>
            <text class="section-header-title">选择接单设备</text>
          </view>
          <view class="device-list">
            <view
              wx:for="{{claimingDevices}}"
              wx:key="client_id"
              class="device-item {{selectedDeviceId === item.client_id ? 'device-item-on' : ''}}"
              bindtap="onSelectDevice"
              data-id="{{item.client_id}}"
              hover-class="device-hover"
              hover-start-time="0"
              hover-stay-time="80"
            >
              <view class="device-dot {{item.online ? 'device-dot-on' : 'device-dot-off'}}"></view>
              <text class="device-label">{{item.label}}</text>
              <!-- 需人工翻纸 + 攒批状态合成**一个**胶囊（2026-10-27 用户要求：接单设备条高度不一致，
                   必须缩到一行）。旧写法「🖐 需人工翻纸」+「攒批未开」+「开启攒批」+「在线」四个块
                   在 375px 上放不下 ⇒ flex-wrap 换行，列表里每条高度都不一样（有的两行有的三行）。
                   判据不变：攒批只对「无自动双面器」的机型渲染（auto_duplex === false，三端同一条），
                   stack_mode 三态：true=攒批中（醒目）/ false=攒批未开（弱化灰）/ null=从未上报
                   → 只显示「需人工翻纸」。三个胶囊互斥出现，行内宽度因此恒定。 -->
              <block wx:if="{{item.auto_duplex === false}}">
                <text wx:if="{{item.stack_mode === true}}" class="device-state device-state-stack">🖐 攒批中</text>
                <text wx:elif="{{item.stack_mode === false}}" class="device-state device-state-stack-off">🖐 攒批未开</text>
                <text wx:else class="device-state device-state-manual">🖐 需人工翻纸</text>
                <!-- 远程开关：仅管理员/超管渲染（普通用户看不到可点控件，也不留空壳）；
                     离线 / 服务端判「当前不可切换」→ 灰显禁用，点击只弹提示（catchtap 防冒泡选中设备） -->
                <view
                  wx:if="{{userRole === 'admin' || userRole === 'super_admin'}}"
                  class="device-stack-btn {{(item.online === false || item.stack_can_toggle === false || stackTogglingId === item.client_id) ? 'device-stack-btn-disabled' : ''}}"
                  hover-class="{{(item.online === false || item.stack_can_toggle === false || stackTogglingId === item.client_id) ? 'none' : 'device-hover'}}"
                  catchtap="onToggleStackMode"
                  data-index="{{index}}"
                >{{item.stack_mode === true ? '关闭攒批' : '开启攒批'}}</view>
              </block>
              <text class="device-state {{item.online ? 'device-state-on' : 'device-state-off'}}">{{item.online ? '在线' : '离线'}}</text>
            </view>
          </view>
        </view>

        <!-- File List Section -->
        <view class="card file-section {{entranceDone ? '' : (entered.fileSection ? 'entrance-play' : 'card-preload')}}">
          <view class="section-header inline-header">
            <view class="section-header-bar"></view>
            <text class="section-header-title">打印文件</text>
            <text wx:if="{{badgeCount > 0 || badgeExiting}}" class="section-header-badge {{badgeEntering ? 'entering' : ''}} {{badgeBouncing ? 'bouncing' : ''}} {{badgeExiting ? 'exiting' : ''}}">{{badgeCount || 1}}</text>
          </view>

          <!-- File Cards（有界原生滚动：避免卡片堆高撑破外层 transform GPU 层的微信布局上限）-->
          <!-- bindscroll：把内层列表的边界状态（贴顶/贴底）同步给 WXS 引擎，用于「内层滚到边 → 外层接管」的滚动接力 -->
          <scroll-view class="file-list-scroll" scroll-y enhanced show-scrollbar="{{false}}" style="height: {{fileListHeight}}px;" bindscroll="onFileListScroll">
          <view
            wx:for="{{selectedFiles}}"
            wx:key="_uid"
            class="file-card {{item.entering ? 'card-entering' : ''}} {{item.removing ? 'card-removing' : ''}}"
          >
            <!-- Header: name + preview + remove -->
            <view class="file-card-top">
              <view class="file-name-area" bindtap="onPreviewFile" data-index="{{index}}">
                <text class="file-name">{{item.name}}</text>
                <text class="file-size">{{item.sizeDisplay}} KB</text>
              </view>
              <!-- 预览：图片/PDF/Word/Excel 走微信原生能力，txt/csv/md 本地读取自绘（零后端依赖） -->
              <view class="file-preview-btn" bindtap="onPreviewFile" data-index="{{index}}" hover-class="tap-active">预览</view>
              <view class="file-remove" bindtap="onRemoveFile" data-index="{{index}}" hover-class="tap-active">✕</view>
            </view>

            <!-- Upload Status -->
            <view class="file-status-area">
              <block wx:if="{{item.uploading}}">
                <view class="upload-row">
                  <text class="status-label uploading">上传中…</text>
                  <text class="upload-pct">{{item.progress}}%</text>
                </view>
                <view class="progress-track">
                  <view class="progress-fill" style="width: {{item.progress}}%;"></view>
                </view>
              </block>
              <block wx:elif="{{item.failed}}">
                <view class="file-retry-row">
                  <text class="status-label failed">上传失败</text>
                  <text class="file-retry-btn" bindtap="onRetryUpload" data-index="{{index}}" hover-class="tap-active" style="color:#FF9500; font-size:24rpx; margin-left:16rpx; padding:4rpx 16rpx; border:1rpx solid #FF9500; border-radius:8rpx;">重试</text>
                </view>
              </block>
              <block wx:elif="{{item.fileId && item.excelWarning}}">
                <text class="status-label warn">该文件类型不支持自动打印，请联系管理员</text>
              </block>
              <block wx:elif="{{item.fileId && item.unsupportedFormat}}">
                <text class="status-label warn">该文件格式不支持自动打印，请联系管理员</text>
              </block>
              <block wx:elif="{{item.fileId}}">
                <text class="status-label done">已上传</text>
                <!-- 页数分析进度（非图片/Excel 文件）-->
                <view wx:if="{{!item.isImage && !item.excelWarning && !item.unsupportedFormat && item.pageCountStatus === 'analyzing'}}" class="page-analysis-bar">
                  <view class="analysis-dot-pulse"></view>
                  <text class="analysis-text">正在分析页数，本地打印工具转换中…</text>
                </view>
                <view wx:elif="{{!item.isImage && !item.excelWarning && !item.unsupportedFormat && item.pageCountStatus === 'offline'}}" class="page-analysis-bar offline">
                  <text class="analysis-dot-warn">⚠</text>
                  <text class="analysis-text">本地打印工具离线，无法返回总页数</text>
                </view>
                <view wx:elif="{{!item.isImage && !item.excelWarning && !item.unsupportedFormat && item.pageCountStatus === 'confirmed' && item.pageCount > 0}}" class="page-analysis-bar confirmed">
                  <text class="analysis-dot-done">✓</text>
                  <text class="analysis-text">共 {{item.pageCount}} 页</text>
                </view>
              </block>
            </view>

            <!-- Per-file controls（上传中即显示，保证卡片高度按类型恒定；excel/不支持格式无控件区） -->
            <view wx:if="{{!item.excelWarning && !item.unsupportedFormat}}" class="file-controls">

              <!-- Copies stepper -->
              <view class="control-row">
                <text class="control-label">份数</text>
                <view class="stepper">
                  <view class="stepper-btn {{item.copies <= 1 ? 'stepper-disabled' : ''}}" bindtap="onFileCopiesMinus" data-index="{{index}}" hover-class="tap-active">−</view>
                  <input class="stepper-input" type="number" value="{{item.copies}}" disabled />
                  <view class="stepper-btn" bindtap="onFileCopiesPlus" data-index="{{index}}" hover-class="tap-active">+</view>
                </view>
              </view>

              <!-- 图片方向（仅图片显示：自动/横向/竖向，对应本地工具三模式渲染） -->
              <view wx:if="{{item.isImage}}" class="control-row">
                <text class="control-label">方向</text>
                <view class="img-ori-toggle" data-seg="ori" data-index="{{index}}"
                      bindtouchstart="onSegTouchStart" bindtouchmove="onSegTouchMove" bindtouchend="onSegTouchEnd" bindtouchcancel="onSegTouchEnd">
                  <view class="img-ori-slider {{item.imageOrientation === 'landscape' ? 'slider-landscape' : ''}} {{item.imageOrientation === 'portrait' ? 'slider-portrait' : ''}} {{segDrag['ori-' + index] >= 0 ? 'dragging' : ''}}"
                        style="{{segDrag['ori-' + index] >= 0 ? ('transform: translateX(' + segDrag['ori-' + index] + '%);') : ''}}"></view>
                  <view class="img-ori-opt {{item.imageOrientation === 'auto' || !item.imageOrientation ? 'opt-active' : ''}}" bindtap="onFileImageOrientation" data-index="{{index}}" data-value="auto">自动</view>
                  <view class="img-ori-opt {{item.imageOrientation === 'landscape' ? 'opt-active' : ''}}" bindtap="onFileImageOrientation" data-index="{{index}}" data-value="landscape">横向</view>
                  <view class="img-ori-opt {{item.imageOrientation === 'portrait' ? 'opt-active' : ''}}" bindtap="onFileImageOrientation" data-index="{{index}}" data-value="portrait">竖向</view>
                </view>
              </view>

              <!-- Page range（图片/整份1页隐藏；页数未知→警告+多行输入；页数已知→网格摘要按钮）
                   黄色警告始终渲染：页数确认后收起(淡出+上移)过渡，避免突变
                   ⚠ 输入区与选择器**互斥渲染**：收起/显示都多带一个 !item.rangeEditing。
                   原因：微信 <input> 在 focus 时是**原生组件**（渲染在 WebView 之上，不受父级
                   max-height/overflow/opacity 裁剪）。用户在范围输入框里打字时页数恰好返回，
                   若此时就把输入区收成 0 高、同时放出「全部页」摘要按钮，原生输入框会留在原地
                   压住摘要按钮（2026-10-21 现场截图：占位符与「全部页」重叠）。
                   rangeEditing 只由真正的 bindfocus/bindblur 维护 ⇒ 只要还在焦点里，输入区就
                   不收起、摘要也不出现，两者永远不会同时在屏上。 -->
              <view wx:if="{{!item.isImage && item.pageCount !== 1}}" class="control-row range-control-multi">
                <text class="control-label">范围</text>
                <view class="range-lines-wrap">
                  <view class="range-unknown-warn {{(item.pageCountStatus === 'confirmed' && item.pageCount > 0) ? 'range-warn-collapsed' : ''}}">⚠ 文档页数未知，若页数范围错误，该任务会直接记为"被打回"</view>
                  <!-- 页数未知：多行输入（占位符随行号变化，新增行带弹出动画；页数确认后收起淡出）
                       max-height 内联按行数匹配，保证收起过渡平滑 -->
                  <view class="range-inputs-state {{(item.pageCountStatus === 'confirmed' && item.pageCount > 0 && !item.rangeEditing) ? 'state-collapsed' : ''}}" style="max-height: {{(item.rangeLines.length) * 100 + 20}}rpx;">
                    <view wx:for="{{item.rangeLines}}" wx:for-item="line" wx:for-index="li" wx:key="li" class="range-line-row {{line.entering ? 'range-line-entering' : ''}}">
                      <input
                        class="input-ios range-line-input {{line.error ? 'range-input-err' : ''}}"
                        type="text"
                        value="{{line.value}}"
                        focus="{{item.rangeFocusLine === li}}"
                        placeholder="请输入第{{li + 1}}个页面范围(如1-5或7)"
                        bindinput="onRangeLineInput"
                        bindfocus="onRangeLineFocus"
                        bindblur="onRangeLineBlur"
                        data-file-index="{{index}}"
                        data-line-index="{{li}}"
                      />
                      <text wx:if="{{line.error}}" class="range-err-msg range-line-err">{{line.error}}</text>
                    </view>
                  </view>
                  <!-- 页数已知：点击弹数字网格选择（用户还停在输入框里时先不显示，见上） -->
                  <block wx:if="{{item.pageCountStatus === 'confirmed' && item.pageCount > 0 && !item.rangeEditing}}">
                    <view class="range-summary-trigger" bindtap="onOpenRangePicker" data-index="{{index}}" hover-class="tap-active">
                      <text class="range-summary-text {{item.pageRange ? '' : 'range-summary-all'}}">{{item.pageRange ? '已选 ' + item.pageRange : '全部页'}}</text>
                      <text class="range-summary-arrow">›</text>
                    </view>
                  </block>
                </view>
              </view>

              <!-- Duplex toggle（图片/整份1页隐藏；有效选择1页 → 模式行收起淡出，提交强制单面） -->
              <view wx:if="{{!item.isImage && item.pageCount !== 1}}" class="control-row mode-row {{item.singlePage ? 'mode-row-collapsed' : ''}}">
                <text class="control-label">模式</text>
                <view class="duplex-toggle" data-seg="duplex" data-index="{{index}}"
                      bindtouchstart="onSegTouchStart" bindtouchmove="onSegTouchMove" bindtouchend="onSegTouchEnd" bindtouchcancel="onSegTouchEnd">
                  <view class="duplex-slider {{item.duplex === 'on' ? 'slider-right' : ''}} {{segDrag['duplex-' + index] >= 0 ? 'dragging' : ''}}"
                        style="{{segDrag['duplex-' + index] >= 0 ? ('transform: translateX(' + segDrag['duplex-' + index] + '%);') : ''}}"></view>
                  <view class="duplex-opt {{item.duplex === 'off' ? 'opt-active' : ''}}" bindtap="onFileDuplexChange" data-index="{{index}}" data-value="off">单面</view>
                  <view class="duplex-opt {{item.duplex === 'on' ? 'opt-active' : ''}}" bindtap="onFileDuplexChange" data-index="{{index}}" data-value="on">双面</view>
                </view>
              </view>
            </view>
          </view>
          </scroll-view>

          <!-- Add file button -->
          <button class="add-file-btn {{btnPulse ? 'pulsing' : ''}}" bindtap="onChooseFile" hover-class="tap-active">
            <text class="add-icon">+</text>
            <text>{{selectedFiles.length ? '添加文件' : '选择打印文件'}}</text>
          </button>
        </view>

        <!-- v5: 附加服务参数 -->
        <view class="card ext-params-card {{entranceDone ? '' : (entered.extParams ? 'entrance-play' : 'card-preload')}}">
          <view class="section-header inline-header">
            <view class="section-header-bar"></view>
            <text class="section-header-title">附加服务</text>
          </view>

          <!-- 打印首页（普通用户必选，锁定开启） -->
          <view class="param-row">
            <text class="param-label">打印首页</text>
            <text wx:if="{{userRole === 'user'}}" class="cover-required-tag">必选</text>
            <view class="ios-switch {{coverPage ? 'switch-on' : ''}} {{swDrag['cover'] >= 0 ? 'sw-dragging' : ''}}" data-sw="cover" bindtap="onToggleCoverPage"
                  bindtouchstart="onSwTouchStart" bindtouchmove="onSwTouchMove" bindtouchend="onSwTouchEnd" bindtouchcancel="onSwTouchEnd">
              <view class="switch-thumb" style="{{swDrag['cover'] >= 0 ? ('--sw-px:' + swDrag['cover'] + 'px;') : ''}}"></view>
            </view>
            <text wx:if="{{coverPriceVisible || coverPriceExiting}}" class="cover-price-tag {{coverPriceEntering ? 'entering' : ''}} {{coverPriceExiting ? 'exiting' : ''}}">¥{{coverPagePrice}}</text>
          </view>

          <!-- 紧急程度 -->
          <view class="param-row">
            <text class="param-label">优先级</text>
            <view class="picker-trigger" bindtap="onToggleUrgencyPicker">
              <text class="{{urgency === '高' ? 'urgency-high' : urgency === '中' ? 'urgency-mid' : ''}}">{{urgency}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </view>
          <view class="picker-sheet {{showUrgencyPicker ? 'picker-expanded' : ''}}">
            <view wx:for="{{urgencyOptions}}" wx:key="*this" class="picker-option {{urgency === item ? 'picker-selected' : ''}}" bindtap="onSelectUrgency" data-urg="{{item}}">
              <text>{{item}}</text>
              <text class="picker-pct">¥{{urgencyPrices[item]}}</text>
            </view>
          </view>

          <!-- 派送开关 -->
          <view class="param-row">
            <text class="param-label">派送</text>
            <view class="ios-switch {{deliveryEnabled ? 'switch-on' : ''}} {{swDrag['delivery'] >= 0 ? 'sw-dragging' : ''}}" data-sw="delivery" bindtap="onToggleDelivery"
                  bindtouchstart="onSwTouchStart" bindtouchmove="onSwTouchMove" bindtouchend="onSwTouchEnd" bindtouchcancel="onSwTouchEnd">
              <view class="switch-thumb" style="{{swDrag['delivery'] >= 0 ? ('--sw-px:' + swDrag['delivery'] + 'px;') : ''}}"></view>
            </view>
          </view>

          <!-- 派送地点（派送开启时显示）-->
          <view class="delivery-collapse {{deliveryEnabled ? 'delivery-open' : ''}}">
            <view class="param-row">
              <text class="param-label">地点</text>
              <view class="picker-trigger" bindtap="onToggleDeliveryPicker">
                <text>{{deliveryLocation}}</text>
                <text class="picker-arrow">›</text>
              </view>
            </view>
          </view>
          <view class="picker-sheet {{showDeliveryPicker ? 'picker-expanded' : ''}}">
            <view wx:for="{{deliveryLocations}}" wx:key="*this" class="picker-option {{deliveryLocation === item ? 'picker-selected' : ''}}" bindtap="onSelectDeliveryLocation" data-loc="{{item}}">
              <text>{{item}}</text>
              <text class="picker-pct">{{deliveryPercentages[item]}}%</text>
            </view>
          </view>
        </view>

        <!-- 备注（第三个卡片，与打印文件/附加服务同级；高度随行数平滑变化） -->
        <view class="card remark-card {{entranceDone ? '' : (entered.remark ? 'entrance-play' : 'card-preload')}}">
          <view class="section-header inline-header">
            <view class="section-header-bar"></view>
            <text class="section-header-title">备注</text>
            <text class="remark-count {{remark.length > 100 ? 'remark-over' : ''}}">{{remark.length}}/100</text>
          </view>
          <view class="remark-box">
            <textarea class="remark-textarea" style="height: {{remarkBoxHeight}}rpx;" value="{{remark}}"
                      bindinput="onRemarkInput" maxlength="100"
                      placeholder="给订单添加备注（选填，最多 100 字）" placeholder-class="remark-placeholder"></textarea>
          </view>
        </view>

        <!-- 无障碍打印开关（仅管理员可见） -->
        <view wx:if="{{userRole === 'admin'}}" class="auto-print-switch-row {{entranceDone ? '' : (entered.autoPrint ? 'entrance-play' : 'card-preload')}}">
          <view class="auto-print-label">
            <view class="lightning-burst {{autoPrintGlow ? 'striking' : ''}} {{glowPhase === 'fading' ? 'fading' : ''}} {{glowPhase === 'reset' ? 'reset' : ''}} {{autoPrintEnabled ? 'active' : ''}}">
              <canvas type="2d" id="boltCanvas" class="bolt-canvas"></canvas>
              <text class="auto-print-icon" style="{{glowStyle}}">⚡</text>
            </view>
            <text class="auto-print-title">无障碍打印</text>
            <text class="auto-print-desc">提交后自动开始打印，无需手动确认</text>
          </view>
          <view class="ios-switch ios-switch-lg {{autoPrintEnabled ? 'switch-on' : ''}} {{swDrag['autoPrint'] >= 0 ? 'sw-dragging' : ''}}" data-sw="autoPrint" bindtap="onAutoPrintToggle"
                bindtouchstart="onSwTouchStart" bindtouchmove="onSwTouchMove" bindtouchend="onSwTouchEnd" bindtouchcancel="onSwTouchEnd">
            <view class="switch-thumb" style="{{swDrag['autoPrint'] >= 0 ? ('--sw-px:' + swDrag['autoPrint'] + 'px;') : ''}}"></view>
          </view>
        </view>

        <!-- 无障碍打印开始方式（仅管理员，开关开启时展开 / 关闭时收起动画） -->
        <view wx:if="{{userRole === 'admin' && scheduleVisible}}" class="schedule-section {{scheduleAnim}}">
          <view class="schedule-title">开始方式</view>
          <view class="schedule-modes">
            <view class="schedule-mode {{scheduleMode === 'now' ? 'active' : ''}}" data-mode="now" bindtap="onScheduleMode">立即开始</view>
            <view class="schedule-mode {{scheduleMode === 'at' ? 'active' : ''}}" data-mode="at" bindtap="onScheduleMode">指定时间</view>
            <view class="schedule-mode {{scheduleMode === 'countdown' ? 'active' : ''}}" data-mode="countdown" bindtap="onScheduleMode">倒计时</view>
          </view>

          <!-- 模式选项行：指定时间 / 倒计时（切换模式时平滑展开/收起） -->
          <view wx:if="{{scheduleOptionsVisible}}" class="schedule-options {{scheduleOptionsAnim}}">
            <block wx:if="{{scheduleMode === 'at'}}">
              <!-- 指定时间：日期（今天~后天）+ 时间（精确到分）——自定义玻璃选择弹窗 -->
              <view class="schedule-picker" bindtap="onOpenScheduleDayPicker">
                <view class="schedule-picker-value">{{scheduleDays[scheduleDayIndex]}}</view>
              </view>
              <view class="schedule-picker" bindtap="onOpenScheduleTimePicker">
                <view class="schedule-picker-value {{scheduleTime ? '' : 'placeholder'}}">{{scheduleTime || '选择时间'}}</view>
              </view>
            </block>
            <block wx:elif="{{scheduleMode === 'countdown'}}">
              <!-- 倒计时：分 + 秒（点击弹出数字滚轮，复用"指定时间"同款选择方式） -->
              <view class="schedule-picker" bindtap="onOpenScheduleCountdownPicker">
                <view class="schedule-picker-value">{{countdownMin < 10 ? '0' + countdownMin : countdownMin}}<text class="countdown-unit">分</text></view>
              </view>
              <view class="schedule-picker" bindtap="onOpenScheduleCountdownPicker">
                <view class="schedule-picker-value">{{countdownSec < 10 ? '0' + countdownSec : countdownSec}}<text class="countdown-unit">秒</text></view>
              </view>
            </block>
          </view>
        </view>

        <!-- 管理员自行打印开关（仅管理员可见） -->
        <view wx:if="{{userRole === 'admin'}}" class="admin-print-switch-row {{entranceDone ? '' : (entered.adminPrint ? 'entrance-play' : 'card-preload')}}">
          <view class="admin-print-label">
            <text class="admin-print-icon">🖨️</text>
            <text class="admin-print-title">管理员自行打印</text>
            <text class="admin-print-desc">自己的订单不计入收益，归属自己</text>
          </view>
          <view class="ios-switch ios-switch-lg admin-print-sw {{adminPrintEnabled ? 'switch-on' : ''}} {{swDrag['adminPrint'] >= 0 ? 'sw-dragging' : ''}}" data-sw="adminPrint" bindtap="onAdminPrintToggle"
                bindtouchstart="onSwTouchStart" bindtouchmove="onSwTouchMove" bindtouchend="onSwTouchEnd" bindtouchcancel="onSwTouchEnd">
            <view class="switch-thumb" style="{{swDrag['adminPrint'] >= 0 ? ('--sw-px:' + swDrag['adminPrint'] + 'px;') : ''}}"></view>
          </view>
        </view>

        <!-- 文件保留与隐私（S2-08 / 2026-10-26 用户要求）：告知只在首次使用弹一次并永久记住，
             不再常驻整张卡片、也不每单重新勾选；日常只留这一行低存在感入口（点开可改保留期 / 重看说明） -->
        <view class="privacy-entry-row" bindtap="onOpenPrivacySheet" hover-class="privacy-entry-hover" hover-start-time="30" hover-stay-time="80">
          <text class="privacy-entry-icon">🔒</text>
          <text class="privacy-entry-label">文件保留</text>
          <text class="privacy-entry-value">{{retentionEntryText}}</text>
          <text class="privacy-entry-arrow">›</text>
        </view>

        <!-- Submit Button -->
        <view class="submit-area {{entranceDone ? '' : (entered.submit ? 'entrance-play' : 'card-preload')}}">
          <button class="btn-primary" bindtap="onSubmit" hover-class="tap-active" loading="{{submitting}}" disabled="{{submitting}}">
            提交打印任务
          </button>
        </view>

      </view>
      <!-- 垫片（scrollPadHeight 现恒为 0）：容器自带底部 padding，文件列表为有界滚动，无需额外撑高 -->
      <view style="height: {{scrollPadHeight}}px; width: 100%; pointer-events: none;"></view>
    </view>
  </view>
</view>

<!-- 文件保留与隐私小弹层：首次使用自动弹一次（确认后永久记住），之后从「文件保留」一行进入 -->
<view wx:if="{{privacySheetVisible}}" class="modal-mask {{privacySheetClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" catchtap="onClosePrivacySheet">
  <view class="modal-sheet privacy-sheet" catchtap="noop">
    <text class="title-medium" style="margin-bottom: 16rpx;">文件保留与隐私</text>
    <view class="privacy-retention-row">
      <text class="privacy-retention-label">文件保留</text>
      <view class="privacy-chips">
        <view wx:for="{{retentionChoices}}" wx:key="hours"
              class="privacy-chip {{retentionHours === item.hours ? 'privacy-chip-active' : ''}}"
              bindtap="onSelectRetention" data-hours="{{item.hours}}">{{item.label}}</view>
      </view>
    </view>
    <view class="privacy-retention-hint">
      <text class="privacy-retention-hint-line">立即删除：打印完成后立即从服务器删除。</text>
      <text class="privacy-retention-hint-line">遵从服务器管理：遵从服务器当前设置，当前设置为“{{serverRetentionLabel}}”。</text>
      <text class="privacy-retention-hint-line">你也可以在「我 → 我的文件」提前删除（正在打印或排队的文件需等订单结束）。</text>
    </view>
    <view class="privacy-sheet-link-row">
      <text class="privacy-link" catchtap="onOpenPrivacyNotice">查看《文件使用与隐私说明》</text>
    </view>
    <view class="privacy-sheet-actions">
      <button wx:if="{{!privacyAgreed}}" class="btn-primary privacy-agree-btn" bindtap="onAgreePrivacy" hover-class="tap-active">我已阅读并同意</button>
      <button wx:else class="btn-primary privacy-agree-btn" bindtap="onClosePrivacySheet" hover-class="tap-active">完成</button>
    </view>
    <text wx:if="{{!privacyAgreed}}" class="privacy-sheet-footnote">同意后不再重复询问，也不会每单重新勾选。</text>
  </view>
</view>

<!-- Page Count Warning Modal -->
<view wx:if="{{showPrivacyNotice}}" class="modal-mask {{privacyNoticeClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" catchtap="onClosePrivacyNotice">
  <view class="modal-sheet privacy-notice-sheet" catchtap="noop">
    <text class="title-medium" style="margin-bottom: 16rpx;">文件使用与隐私说明</text>
    <scroll-view scroll-y class="privacy-notice-body">
      <view class="privacy-notice-section">
        <text class="privacy-notice-title">用途</text>
        <text class="body-small">你上传的文件只用于本次打印：由本店打印终端下载后直接打印，不做其他用途。</text>
      </view>
      <view class="privacy-notice-section">
        <text class="privacy-notice-title">保留期限</text>
        <text class="body-small privacy-notice-copy">立即删除：打印完成后立即从服务器删除。</text>
        <text class="body-small privacy-notice-copy">遵从服务器管理：遵从服务器当前设置，当前设置为“{{serverRetentionLabel}}”。</text>
        <text class="body-small privacy-notice-copy">你也可以在「我 → 我的文件」提前删除（正在打印或排队的文件需等订单结束）。</text>
      </view>
      <view class="privacy-notice-section">
        <text class="privacy-notice-title">第三方</text>
        <text class="body-small">登录使用微信（openid）；APP 更新安装包经腾讯云 COS 分发。除完成打印所必需的上述环节外，文件不会主动提供给第三方。</text>
      </view>
      <view class="privacy-notice-section">
        <text class="privacy-notice-title">你的权利</text>
        <text class="body-small">可随时查看并删除自己的文件；删除后不可恢复。</text>
      </view>
    </scroll-view>
    <view class="modal-buttons">
      <button class="btn-primary modal-half-btn" bindtap="onClosePrivacyNotice" hover-class="tap-active">我知道了</button>
    </view>
  </view>
</view>

<!-- Page Count Warning Modal -->
<view wx:if="{{showPageCountWarning}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-icon-wrap" style="background-color: rgba(255, 149, 0, 0.1); color: #FF9500;">⚠</view>
    <text class="title-medium" style="margin-bottom: 8rpx;">页数未经验证</text>
    <text class="body-small" style="margin-bottom: 6rpx;">部分文档的页数尚未经本地打印工具确认，</text>
    <text class="body-small">页码范围可能超出文档实际页数。</text>
    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCancelForceSubmit" hover-class="tap-active">返回等待</button>
      <button class="btn-primary modal-half-btn" style="background-color: #FF9500;" bindtap="onConfirmForceSubmit" hover-class="tap-active" disabled="{{submitting}}">继续提交</button>
    </view>
  </view>
</view>

<!-- 跳过不支持格式（Excel/PPT/CAD）确认弹窗 -->
<view wx:if="{{showUnsupportedSkipModal}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-icon-wrap" style="background-color: rgba(255, 149, 0, 0.1); color: #FF9500;">⚠</view>
    <text class="title-medium" style="margin-bottom: 8rpx;">存在不支持的文件格式</text>
    <text class="body-small" style="margin-bottom: 6rpx;">任务中存在 {{unsupportedSkipCount}} 个不支持的文件格式（Excel/PPT/CAD），</text>
    <text class="body-small">提交时将自动跳过，仅打印其余文件。</text>
    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCancelSkipUnsupported" hover-class="tap-active">取消</button>
      <button class="btn-primary modal-half-btn" bindtap="onConfirmSkipUnsupported" hover-class="tap-active" disabled="{{submitting}}">自动跳过并提交</button>
    </view>
  </view>
</view>

<!-- 文件预览（文本类：txt/csv/md 本地读取后自绘；图片/PDF/Word/Excel 走微信原生能力，不经过本层） -->
<view wx:if="{{showPreview}}" class="preview-mask {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onClosePreview">
  <view class="preview-sheet" catchtap="noop">
    <view class="preview-header">
      <text class="preview-title">{{previewName}}</text>
      <view class="preview-close" bindtap="onClosePreview" hover-class="tap-active">✕</view>
    </view>
    <scroll-view class="preview-body" scroll-y>
      <text class="preview-text" user-select="true">{{previewText}}</text>
    </scroll-view>
    <text wx:if="{{previewTruncated}}" class="preview-truncated">文件较大，仅预览前面部分内容</text>
  </view>
</view>

<!-- Success Modal -->
<view wx:if="{{showSuccessModal}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onCloseModal">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-icon-wrap">✓</view>
    <text class="title-medium" style="margin-bottom: 8rpx;">任务提交成功</text>
    <text wx:if="{{lastOrderNumber}}" class="order-number-modal">{{lastOrderNumber}}</text>
    <text wx:if="{{lastScheduleText}}" class="body-small schedule-success-text">{{lastScheduleText}}</text>
    <text wx:elif="{{lastAdminPrintText}}" class="body-small admin-print-success-text">{{lastAdminPrintText}}</text>
    <text wx:else class="body-small">文件已上传，打印任务已创建</text>
    <!-- 页数未完成计算（Word/md 等需本地转换的类型，接管设备离线时等不到）→ 价格无效 -->
    <text wx:if="{{priceInvalidHint}}" class="body-small price-invalid-hint">⚠ {{priceInvalidHint}}</text>
    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCopyPrice" hover-class="tap-active">复制价格</button>
      <button class="btn-primary modal-half-btn" bindtap="onCopyDetailPrice" hover-class="tap-active">复制详细价格</button>
    </view>
  </view>
</view>

<!-- Access Denied Modal -->
<view wx:if="{{showAccessDeniedModal}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onAccessDeniedConfirm">
  <view class="modal-sheet" catchtap="noop">
    <view class="modal-icon-wrap" style="background-color: rgba(255, 59, 48, 0.1); color: var(--red);">!</view>
    <text class="title-medium" style="margin-bottom: 8rpx;">需要许可</text>
    <text class="body-small">请先出示管理员许可</text>
    <view class="modal-buttons">
      <button class="btn-primary" bindtap="onAccessDeniedConfirm" hover-class="tap-active">前往获取</button>
    </view>
  </view>
</view>

<!-- 自定义日期选择弹窗（玻璃风格，替代微信原生 picker） -->
<view wx:if="{{showScheduleDayPicker}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onCloseScheduleDayPicker">
  <view class="modal-sheet schedule-modal-sheet" catchtap="noop">
    <view class="sheet-title">选择日期</view>
    <view class="sheet-option-list">
      <view wx:for="{{scheduleDays}}" wx:key="*this"
            class="sheet-option {{index === scheduleDayIndex ? 'sheet-option-selected' : ''}}"
            bindtap="onSelectScheduleDay" data-index="{{index}}">
        <text>{{item}}</text>
        <text wx:if="{{index === scheduleDayIndex}}" class="sheet-option-check">✓</text>
      </view>
    </view>
    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCloseScheduleDayPicker">取消</button>
    </view>
  </view>
</view>

<!-- 自定义时间选择弹窗（玻璃双列滚轮，替代微信原生 picker） -->
<view wx:if="{{showScheduleTimePicker}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onCloseScheduleTimePicker">
  <view class="modal-sheet schedule-modal-sheet" catchtap="noop">
    <view class="sheet-title">选择时间</view>
    <view class="time-wheel-row">
      <!-- 官方 picker-view 滚轮（系统 picker 底层引擎）：贴合/惯性/边界全部原生，
           value 指定选中索引，渲染层精确居中 → 零漂移、不过度滚动 -->
      <picker-view class="time-picker-view" value="{{timeWheelValue}}" immediate-change
                   mask-class="wheel-mask"
                   indicator-style="background: rgba(255,149,0,0.10); box-shadow: inset 0 1rpx 0 rgba(255,149,0,0.35), inset 0 -1rpx 0 rgba(255,149,0,0.35); border-radius: 12rpx;"
                   bindchange="onTimeWheelChange">
        <!-- 动态列：今天已过的时间直接从数组中删除（小时列从当前小时起，
             当前小时仅显示可用分钟；选中小时变化时分钟列级联重建） -->
        <picker-view-column>
          <view wx:for="{{hourItems}}" wx:key="*this"
                class="wheel-item {{index === hourWheelIndex ? 'wheel-item-active' : ''}}">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{minuteItems}}" wx:key="*this"
                class="wheel-item {{index === minuteWheelIndex ? 'wheel-item-active' : ''}}">{{item}}</view>
        </picker-view-column>
      </picker-view>
      <text class="wheel-colon">:</text>
    </view>
    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCloseScheduleTimePicker">取消</button>
      <button class="btn-primary modal-half-btn" bindtap="onConfirmScheduleTime">确定</button>
    </view>
  </view>
</view>

<!-- 倒计时选择弹窗（玻璃双列滚轮：分 + 秒，复用指定时间同款滚轮引擎，范围 00-59） -->
<view wx:if="{{showScheduleCountdownPicker}}" class="modal-mask {{modalClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onCloseScheduleCountdownPicker">
  <view class="modal-sheet schedule-modal-sheet" catchtap="noop">
    <view class="sheet-title">选择倒计时</view>
    <view class="time-wheel-row">
      <picker-view class="time-picker-view" value="{{countdownWheelValue}}" immediate-change
                   mask-class="wheel-mask"
                   indicator-style="background: rgba(255,149,0,0.10); box-shadow: inset 0 1rpx 0 rgba(255,149,0,0.35), inset 0 -1rpx 0 rgba(255,149,0,0.35); border-radius: 12rpx;"
                   bindchange="onCountdownWheelChange">
        <picker-view-column>
          <view wx:for="{{countdownMinItems}}" wx:key="*this"
                class="wheel-item {{index === countdownMinWheelIndex ? 'wheel-item-active' : ''}}">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{countdownSecItems}}" wx:key="*this"
                class="wheel-item {{index === countdownSecWheelIndex ? 'wheel-item-active' : ''}}">{{item}}</view>
        </picker-view-column>
      </picker-view>
      <text class="wheel-unit" style="left: 40%;">分</text>
      <text class="wheel-unit" style="left: 90%;">秒</text>
    </view>
    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCloseScheduleCountdownPicker">取消</button>
      <button class="btn-primary modal-half-btn" bindtap="onConfirmScheduleCountdown">确定</button>
    </view>
  </view>
</view>

<!-- 页数网格选择弹窗（玻璃风格：1..N 数字网格 + 全部/单页/双页一键） -->
<view wx:if="{{showRangePicker}}" class="modal-mask {{rangePickerClosing ? 'modal-closing' : ''}} {{isDarkMode ? 'theme-dark' : ''}}" bindtap="onCloseRangePicker">
  <view class="modal-sheet schedule-modal-sheet range-picker-sheet" catchtap="noop">
    <view class="sheet-title">选择页数<text class="range-picker-total">共 {{rangePickerTotal}} 页</text></view>

    <!-- 一键选择：全部 / 单页(奇) / 双页(偶) -->
    <view class="range-picker-actions">
      <view class="range-picker-action {{rangePickerSelAll ? 'active' : ''}}" bindtap="onRangePickerAll" hover-class="tap-active">全部</view>
      <view class="range-picker-action {{rangePickerSelOdd ? 'active' : ''}}" bindtap="onRangePickerOdd" hover-class="tap-active">单页</view>
      <view class="range-picker-action {{rangePickerSelEven ? 'active' : ''}}" bindtap="onRangePickerEven" hover-class="tap-active">双页</view>
    </view>

    <!-- 数字网格（点击选中/取消） -->
    <view class="range-picker-grid">
      <view
        wx:for="{{rangePickerPages}}"
        wx:key="n"
        class="range-picker-cell {{item.sel ? 'selected' : ''}}"
        bindtap="onRangePickerCell"
        data-n="{{item.n}}"
      >{{item.n}}</view>
    </view>

    <view class="modal-buttons">
      <button class="btn-secondary modal-half-btn" bindtap="onCloseRangePicker" hover-class="tap-active">取消</button>
      <button class="btn-primary modal-half-btn" bindtap="onConfirmRangePicker" hover-class="tap-active">确定</button>
    </view>
  </view>
</view>
