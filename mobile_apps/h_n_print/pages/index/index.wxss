/** Apple-style Index Page Styles **/

/* ── Root & Container ── */
.page-root {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: transparent;
  min-height: 0;
}

/* 深浅切换过渡：只作用于需要主题过渡的具名元素，不覆盖 auto-print-switch-row 等自身 transition */
.page-root,
.page-root .card,
.page-root .card-elevated,
.page-root .file-card,
.page-root .ext-params-card,
.page-root .file-section,
.page-root .status-bar,
.page-root .picker-trigger,
.page-root .add-file-btn {
  transition: background 0.45s ease, color 0.35s ease, border-color 0.45s ease, box-shadow 0.45s ease;
}

/* 主题切换过渡期：禁用所有 CSS transition，防止缓存页面 show() 时 isDarkMode 变更触发旧→新值动画 */
.page-root.theme-switching,
.page-root.theme-switching .card,
.page-root.theme-switching .card-elevated,
.page-root.theme-switching .file-card,
.page-root.theme-switching .ext-params-card,
.page-root.theme-switching .file-section,
.page-root.theme-switching .status-bar,
.page-root.theme-switching .picker-trigger,
.page-root.theme-switching .add-file-btn {
  transition: none !important;
}

/* 初始隐藏态：防止页面首次渲染时闪烁 */
.page-init {
  opacity: 0;
  pointer-events: none;
}

/* 入场：从左滑入 + 淡入（强 Ease-Out：先快后慢） */
.page-enter-left {
  animation: enterLeft 0.24s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes enterLeft {
  from { opacity: 0; transform: translateX(-260rpx); }
  to   { opacity: 1; transform: translateX(0); }
}
/* 首次加载：页面容器淡入（仅透明度，垂直移动由各元素"向上淡入"负责，避免双重位移） */
.page-fade-in {
  animation: fadeIn 0.25s ease-out both;
}
@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
/* 首次加载：延迟 0.5s 再播放入场动画，为界面加载预留时间，保证动画完整播放 */
.page-fade-in.page-fade-in-delayed {
  animation-delay: 0.5s;
}

/* 退出动画：左滑淡出（强 Ease-Out：先快后慢） */
.page-exit-left {
  animation: exitLeft 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes exitLeft {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(-260rpx); }
}
.page-exit-right {
  animation: exitRight 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@keyframes exitRight {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(260rpx); }
}

.scroller {
  flex: 1;
  overflow: hidden;
  position: relative;
  min-height: 0;
}

.scroll-content {
  /* will-change 移除：避免微信预分配固定尺寸 GPU 层截断动态内容 */
}

.container {
  padding: 24rpx 32rpx;
  padding-bottom: 48rpx;  /* 底部留白；tabBar 遮挡由滚动范围 _tabOverlayPx 显式处理，不再用大 padding 兜底 */
  box-sizing: border-box;
}

/* ── Header: Logo ── */
.header-area {
  text-align: center;
  padding: 32rpx 0;
}

.logo-wrap {
  display: inline-block;
}

.logo {
  width: 320rpx;
}

/* ── Entrance: non-list section (upward fade-in, no expand) ── */
@keyframes sectionSlideIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.section-entering {
  animation: sectionSlideIn 0.45s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}

/* ── Entrance: file-section card expand (same as card-entering, delay via inline style) ── */
.section-card-entering {
  animation:
    cardExpand 0.35s ease-out both,
    cardFadeIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

/* ── Printer Status ── */
.status-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 28rpx;
  gap: 10rpx;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.status-active .status-dot {
  background-color: var(--green);
  animation: statusPulse 2s infinite;
}

.status-inactive .status-dot {
  background-color: var(--gray3);
}

.status-text {
  font-size: 22rpx;
  font-weight: 500;
}

.status-active .status-text { color: var(--green); }
.status-inactive .status-text { color: var(--gray); }

/* ── File Section ── */
.file-section {
  margin-bottom: 20rpx;
}

/* 文件卡片列表：显式高度驱动（index.js 按每文件类型实测常量累加设置 fileListHeight，上限 ≈ 85vh / 3~4 个卡片）。
   scroll-view 需要显式高度才能真正裁剪溢出卡片并内部滚动；仅 max-height 在微信中会把溢出卡片
   画到下方元素上，导致与“添加文件”按钮重叠。 */
.file-list-scroll {
  box-sizing: border-box;
}

.inline-header {
  padding: 0 0 20rpx 0;
  border-bottom: 0.5px solid var(--separator);
  margin-bottom: 20rpx;
}

/* ── File Cards ── */
.file-card {
  background: var(--glass-regular);
  border-radius: var(--radius-md);
  padding: 20rpx 22rpx;
  margin-bottom: 12rpx;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  border: var(--glass-border-dark);
}

.file-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.file-name-area {
  flex: 1;
  min-width: 0;
}

.file-name {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-size {
  display: block;
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
}

.file-remove {
  width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  background: var(--glass-light);
  color: var(--text-tertiary);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-left: 12rpx;
  border: var(--glass-border-dark);
  box-shadow: var(--glass-rim);
  transition: transform 0.1s ease, background-color 0.15s ease, color 0.15s ease;
}

.file-remove:active {
  transform: scale(0.92);
  background-color: var(--red);
  color: #fff;
  border-color: var(--red);
  box-shadow: none;
}

/* Upload Status */
.file-status-area {
  margin-top: 14rpx;
  min-height: 28rpx;
}

.status-label {
  font-size: 22rpx;
  font-weight: 500;
}
.status-label.uploading { color: var(--blue); }
.status-label.done      { color: var(--green); }
.status-label.failed    { color: var(--red); }
.status-label.warn      { color: var(--orange); font-size: 20rpx; }

.upload-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.upload-pct {
  font-size: 22rpx;
  font-family: var(--font-mono);
  color: var(--blue);
}

/* Progress bar */
.progress-track {
  width: 100%;
  height: 8rpx;
  background-color: rgba(60, 60, 67, 0.1);
  border-radius: 4rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: var(--blue);
  border-radius: 4rpx;
  transition: width 0.4s ease-out;
}

/* ── File Controls (per-file) ── */
.file-controls {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 0.5px solid var(--separator);
}

.control-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
  gap: 14rpx;
}
.control-row:last-child {
  margin-bottom: 0;
}

.control-label {
  font-size: 24rpx;
  color: var(--text-tertiary);
  width: 56rpx;
  flex-shrink: 0;
}

.range-control-row {
  align-items: flex-start;
}
/* 多行范围输入（对齐本地工具 RangeListWidget） */
.range-control-multi {
  align-items: flex-start;
}
.range-lines-wrap {
  flex: 1;
  min-width: 0;
}
.range-line-row {
  margin-bottom: 4rpx;
}
.range-line-input {
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 14rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--gray4);
  border-radius: var(--radius-sm);
  color: var(--text-primary);
}
.range-line-input.range-input-err {
  border-color: var(--red);
  background-color: rgba(255, 59, 48, 0.05);
}
.range-line-err {
  display: block;
  font-size: 20rpx;
  color: var(--red);
  margin-top: 4rpx;
  padding-left: 4rpx;
  line-height: 1.4;
}

/* 页数已知：范围网格摘要触发按钮 */
.range-summary-trigger {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20rpx;
  background: var(--bg-card);
  border: 1rpx solid var(--gray4);
  border-radius: var(--radius-sm);
  transition: opacity 0.12s ease;
}
.range-summary-text {
  font-size: 24rpx;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.range-summary-text.range-summary-all {
  color: var(--text-tertiary);
}
.range-summary-arrow {
  font-size: 30rpx;
  color: var(--text-tertiary);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 页数未知：黄色警告（页数确认后收起：淡出 + 上移，避免突变） */
.range-unknown-warn {
  font-size: 20rpx;
  color: #FF9500;
  line-height: 1.35;
  margin-bottom: 8rpx;
  overflow: hidden;
  max-height: 56rpx;
  opacity: 1;
  transition: max-height 0.25s ease, opacity 0.25s ease,
              margin-bottom 0.25s ease, transform 0.25s ease;
}
.range-unknown-warn.range-warn-collapsed {
  max-height: 0;
  opacity: 0;
  margin-bottom: 0;
  transform: translateY(-8rpx);
}

/* 范围多行输入：页数确认后收起(淡出+上移)，与黄色警告同步过渡。
   max-height 由 WXML 内联按行数匹配（此处仅定义过渡与收起态） */
.range-inputs-state {
  overflow: hidden;
  opacity: 1;
  transition: max-height 0.25s ease, opacity 0.25s ease;
}
.range-inputs-state.state-collapsed {
  max-height: 0 !important;  /* 覆盖内联 max-height */
  opacity: 0;
}

/* 模式行：有效选择 1 页时收起(淡出+上移) */
.mode-row {
  max-height: 80rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
}
.mode-row.mode-row-collapsed {
  max-height: 0;
  opacity: 0;
  transform: translateY(-6rpx);
}

/* 状态区元素出现动画：仅透明度淡入（不影响几何 → 不干扰卡片高度探测） */
@keyframes statusFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.page-analysis-bar,
.file-retry-row,
.status-label.done,
.status-label.warn,
.range-summary-trigger {
  animation: statusFadeIn 0.25s ease;
}

/* 新增范围行弹出动画 */
.range-line-entering {
  animation: rangeLineIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes rangeLineIn {
  from { opacity: 0; transform: translateY(-10rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}

/* ── 页数分析进度条 ── */
.page-analysis-bar {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: var(--bg-card);
  border-radius: var(--radius-sm);
  border: 1rpx solid var(--gray4);
}
.page-analysis-bar.confirmed {
  border-color: var(--green);
  background: rgba(52, 199, 89, 0.06);
}
.page-analysis-bar.offline {
  border-color: #FF9500;
  background: rgba(255, 149, 0, 0.06);
}
.analysis-dot-pulse {
  width: 14rpx;
  height: 14rpx;
  border-radius: 7rpx;
  background: #007AFF;
  margin-right: 10rpx;
  flex-shrink: 0;
  animation: analysisPulse 1.2s ease-in-out infinite;
}
@keyframes analysisPulse {
  0%, 100% { opacity: 0.3; transform: scale(0.8); }
  50% { opacity: 1; transform: scale(1); }
}
.analysis-dot-done {
  font-size: 22rpx;
  color: var(--green);
  margin-right: 10rpx;
  flex-shrink: 0;
}
.analysis-dot-warn {
  font-size: 22rpx;
  color: #FF9500;
  margin-right: 10rpx;
  flex-shrink: 0;
}
.analysis-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.3;
}

/* 旧版单行样式保留兼容 */
.range-input-wrap {
  flex: 1;
  min-width: 0;
}
.range-input {
  height: 56rpx;
  font-size: 24rpx;
  padding: 0 14rpx;
}
.range-input.range-input-err {
  border-color: var(--red);
  background-color: rgba(255, 59, 48, 0.05);
}
.range-err-msg {
  display: block;
  font-size: 20rpx;
  color: var(--red);
  margin-top: 6rpx;
  line-height: 1.4;
}

/* ── Duplex Toggle (per-file, compact) ── */
.duplex-toggle {
  flex: 1;
  position: relative;
  display: flex;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: rgba(60, 60, 67, 0.08);
  height: 56rpx;
}

.duplex-slider {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: calc(50% - 3rpx);
  height: calc(100% - 6rpx);
  border-radius: 12rpx;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.88) 0%,
    rgba(0, 105, 220, 0.94) 100%);
  box-shadow:
    0 2rpx 8rpx rgba(0, 122, 255, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 0;
}

.duplex-slider.slider-right {
  transform: translateX(100%);
}

.duplex-slider.dragging {
  transition: none;
}

.duplex-opt {
  flex: 1;
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: color 0.25s ease;
}

.duplex-opt.opt-active {
  color: #fff;
  font-weight: 600;
}

/* 单页文件固定单面：整体灰化、禁点 */
.duplex-toggle.duplex-disabled {
  opacity: 0.55;
  pointer-events: none;
}

/* ── 图片方向三段开关（自动/横向/竖向，对应本地工具三模式渲染）── */
.img-ori-toggle {
  flex: 1;
  position: relative;
  display: flex;
  border-radius: 14rpx;
  overflow: hidden;
  background-color: rgba(60, 60, 67, 0.08);
  height: 56rpx;
}

.img-ori-slider {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: calc(33.33% - 3rpx);
  height: calc(100% - 6rpx);
  border-radius: 12rpx;
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.88) 0%,
    rgba(0, 105, 220, 0.94) 100%);
  box-shadow:
    0 2rpx 8rpx rgba(0, 122, 255, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.35);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  z-index: 0;
}

.img-ori-slider.slider-landscape {
  transform: translateX(100%);
}

.img-ori-slider.slider-portrait {
  transform: translateX(200%);
}

.img-ori-slider.dragging {
  transition: none;
}

.img-ori-opt {
  flex: 1;
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: color 0.25s ease;
}

.img-ori-opt.opt-active {
  color: #fff;
  font-weight: 600;
}

/* ── Add File Button ── */
.add-file-btn {
  width: 375rpx;   /* 50% 屏幕宽度（750rpx 设计稿），显式固定避免微信 button 默认宽度限制导致宽度不一 */
  margin-left: auto;
  margin-right: auto;
  margin-top: 16rpx;   /* 与文件列表保持间距，避免紧贴/重叠 */
  background: var(--glass-light);
  color: var(--blue);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-md);
  padding: 22rpx;
  text-align: center;
  border: 2rpx dashed rgba(0, 122, 255, 0.20);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-shadow: var(--glass-rim);
  transition: transform 0.12s cubic-bezier(0.4, 0, 0.2, 1),
              background-color 0.12s ease;
}
.add-file-btn.pulsing {
  animation: btnPulse 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}
@keyframes btnPulse {
  0%   { transform: scale(1); }
  35%  { transform: scale(0.96); }
  70%  { transform: scale(1.015); }
  100% { transform: scale(1); }
}
.add-file-btn:active {
  transform: scale(0.97);
  background-color: rgba(0, 122, 255, 0.12);
}

.add-icon {
  font-size: 30rpx;
  font-weight: 300;
  line-height: 1;
}

/* ── Submit ── */
/* ── 无障碍打印开关（仅管理员可见，入场由 card-entering-fade 向上淡入控制）── */
.auto-print-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 149, 0, 0.06);
  border: 1rpx solid rgba(255, 149, 0, 0.2);   /* 与下方"开始方式"卡片统一为有边框形式 */
  border-radius: var(--radius-md);
  box-sizing: border-box;
  overflow: hidden;   /* 裁剪闪电 canvas 溢出部分 */
}
.auto-print-label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
/* ── ⚡ 闪电图标 + Canvas 电流射线 ── */
.lightning-burst {
  position: relative;
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
}
.bolt-canvas {
  position: absolute;
  top: 50%; left: 50%;
  width: 240rpx;
  height: 240rpx;
  margin-left: -120rpx;
  margin-top: -120rpx;
  pointer-events: none;
  background: transparent;
  border: none;
  outline: none;
}
.auto-print-icon {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  z-index: 1;
}

/* 浮动动画（无障碍打印开启期间常驻，无光晕） */
.lightning-burst.active .auto-print-icon {
  animation: iconFloat 3s ease-in-out infinite;
}
/* 闪电爆发瞬间：闪白 + 抖动 */
.lightning-burst.striking .auto-print-icon {
  animation: iconFlash 0.5s ease-out, iconShake 0.3s 0.02s ease-out;
}
/* JS 渐隐完成后强制复位（打断任何残留的 GPU 合成层） */
.lightning-burst.reset .auto-print-icon {
  animation: none !important;
}
/* 环形冲击波 */
.lightning-burst::before {
  content: '';
  position: absolute;
  top: 50%; left: 50%;
  width: 0; height: 0;
  border: 2rpx solid rgba(255, 230, 0, 0);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.lightning-burst.striking::before {
  animation: shockRing 0.5s 0.02s ease-out forwards;
}

@keyframes iconFlash {
  0%   { text-shadow: 0 0 0 #fff; }
  15%  { text-shadow: 0 0 30rpx #fff, 0 0 12rpx #ffe500; }
  100% { text-shadow: 0 0 0 #fff; }
}
@keyframes iconShake {
  0%   { margin-left: 0;    margin-top: 0; }
  10%  { margin-left: 3rpx; margin-top: -2rpx; }
  20%  { margin-left: -3rpx; margin-top: 1rpx; }
  30%  { margin-left: 2rpx; margin-top: 2rpx; }
  40%  { margin-left: -2rpx; margin-top: -1rpx; }
  50%  { margin-left: 1rpx; margin-top: -1rpx; }
  70%  { margin-left: -1rpx; margin-top: 1rpx; }
  100% { margin-left: 0;    margin-top: 0; }
}
@keyframes shockRing {
  0%   { width: 4rpx; height: 4rpx; border-color: rgba(255,230,0,0.8); border-width: 3rpx; }
  100% { width: 90rpx; height: 90rpx; border-color: rgba(255,200,0,0); border-width: 1rpx; }
}
@keyframes iconFloat {
  0%, 100% { transform: translate(-50%, -50%); }
  50%      { transform: translate(-50%, calc(-50% - 4rpx)); }
}
.auto-print-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF9500;
}
.auto-print-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ── 管理员自行打印开关（仅管理员可见，蓝色主题区分于橙色无障碍打印）── */
.admin-print-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(30, 102, 245, 0.06);
  border: 1rpx solid rgba(30, 102, 245, 0.22);
  border-radius: var(--radius-md);
  box-sizing: border-box;
}
.admin-print-label {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.admin-print-icon {
  font-size: 32rpx;
  line-height: 1;
  margin-bottom: 2rpx;
}
.admin-print-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--blue);
}
.admin-print-desc {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.admin-print-success-text {
  margin-bottom: 12rpx;
  color: var(--blue);
  font-weight: 500;
}

/* ── 无障碍打印预约（开始方式：立即/指定时间/倒计时，仅管理员）── */
/* 展开/收起动画：开关联动，max-height + opacity + transform 过渡（收起由 JS 在 320ms 后卸载面板） */
.schedule-section {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 149, 0, 0.06);
  border: 1rpx solid rgba(255, 149, 0, 0.2);
  border-radius: var(--radius-md);
  box-sizing: border-box;
  overflow: hidden;
  max-height: 420rpx;
  opacity: 1;
  transform: translateY(0);
  transition: max-height 0.3s cubic-bezier(0.25, 0.8, 0.25, 1),
              opacity 0.25s ease,
              padding-top 0.3s ease, padding-bottom 0.3s ease,
              margin-top 0.3s ease,
              border-width 0.3s ease,
              transform 0.3s ease;
}
.schedule-section.collapsed {
  max-height: 0;
  padding-top: 0;
  padding-bottom: 0;
  margin-top: 0;
  opacity: 0;
  transform: translateY(-8rpx);
  border-width: 0;
}
.schedule-title {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}
.schedule-modes {
  display: flex;
  gap: 16rpx;
}
.schedule-mode {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: var(--gray6);
  border-radius: var(--radius-sm);
  border: 1rpx solid transparent;
  transition: all 0.2s ease;
}
.schedule-mode:active {
  opacity: 0.8;
}
.schedule-mode.active {
  background: rgba(255, 149, 0, 0.12);
  color: #FF9500;
  border-color: rgba(255, 149, 0, 0.45);
  font-weight: 600;
}
/* 模式选项行：指定时间/倒计时切换时展开/收起过渡（JS 在 260ms 后切换模式内容） */
.schedule-options {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  align-items: center;
  overflow: hidden;
  max-height: 140rpx;
  opacity: 1;
  transition: max-height 0.26s cubic-bezier(0.25, 0.8, 0.25, 1),
              opacity 0.22s ease,
              margin-top 0.26s ease;
}
.schedule-options.collapsed {
  max-height: 0;
  margin-top: 0;
  opacity: 0;
}

/* ── 自定义玻璃选择弹窗（日期列表 + 时间双列滚轮，替代微信原生 picker） ── */
.schedule-modal-sheet {
  width: 560rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: var(--glass-shadow-lg), var(--glass-rim);
  align-items: stretch;
}
.sheet-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  align-self: flex-start;
}
.sheet-option-list {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.sheet-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: var(--glass-light);
  border: var(--glass-border-dark);
  border-radius: var(--radius-md);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  transition: all 0.15s ease;
}
.sheet-option:active {
  opacity: 0.7;
}
.sheet-option-selected {
  background: rgba(255, 149, 0, 0.14);
  border-color: rgba(255, 149, 0, 0.40);
  color: #FF9500;
}
.sheet-option-check {
  font-size: 26rpx;
  font-weight: 700;
}

/* ── 页数网格选择弹窗（1..N 数字网格 + 全部/单页/双页一键） ── */
.range-picker-sheet {
  width: 600rpx;
  padding-bottom: 32rpx;
  max-height: 88vh;
  overflow: hidden;
}
.range-picker-total {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--text-tertiary);
  margin-left: 12rpx;
}
.range-picker-actions {
  display: flex;
  gap: 12rpx;
  width: 100%;
  margin-bottom: 20rpx;
}
.range-picker-action {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: var(--gray6);
  border-radius: var(--radius-sm);
  /* 按钮外观：描边 + 轻阴影（此前 border 透明、无阴影，在白底弹窗上像纯文本） */
  border: 1rpx solid var(--separator-strong);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  transition: all 0.15s ease;
}
.range-picker-action:active {
  opacity: 0.75;
}
.range-picker-action.active {
  background: rgba(0, 122, 255, 0.12);
  color: var(--blue);
  border-color: rgba(0, 122, 255, 0.45);
  font-weight: 600;
}
.range-picker-grid {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  max-height: 44vh;
  overflow-y: auto;
}
.range-picker-cell {
  width: calc((100% - 48rpx) / 5);   /* 每行 5 个，4 个 12rpx 间距 */
  height: 96rpx;                     /* 与内容区宽度一致，保持方形 */
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
  background: var(--glass-light);
  border: var(--glass-border-dark);
  border-radius: var(--radius-md);
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  transition: all 0.12s ease;
}
.range-picker-cell.selected {
  background: rgba(0, 122, 255, 0.16);
  border-color: rgba(0, 122, 255, 0.55);
  color: var(--blue);
  font-weight: 700;
}

/* 时间滚轮：官方 picker-view（系统 picker 同款引擎，原生贴合/惯性/边界）
   item 高 88rpx、可视区 440rpx（5 项）；贴合单元 = item 高度，指示框由 indicator-style 定制 */
.time-wheel-row {
  position: relative;
  width: 100%;
}
.time-picker-view {
  height: 440rpx;
  width: 100%;
}
picker-view-column {
  text-align: center;
}
.wheel-item {
  height: 88rpx;
  /* flex 居中：line-height 在 picker-view-column 内不可靠（column 自带布局样式干扰行盒），
     flex 是布局级居中，任何渲染环境都稳定 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
  transition: color 0.15s ease, font-size 0.15s ease;
}
.wheel-item-active {
  color: var(--text-primary);
  font-weight: 700;
  font-size: 34rpx;
  text-shadow: 0 0 20rpx rgba(255, 149, 0, 0.35);
}
/* picker-view 上下渐隐遮罩：默认是白色渐变，深色模式下发白 → 按主题定制
   （渐隐色与 modal-sheet 背景 --bg-card 一致，浅色 #FFF / 深色 #2C2C2E） */
.wheel-mask {
  background-image: linear-gradient(180deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0) 26%),
                    linear-gradient(0deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0) 26%);
}
.theme-dark .wheel-mask {
  background-image: linear-gradient(180deg, rgba(44,44,46,0.95) 0%, rgba(44,44,46,0) 28%),
                    linear-gradient(0deg, rgba(44,44,46,0.95) 0%, rgba(44,44,46,0) 28%);
}

/* 冒号：覆盖在双列指示框中间（picker-view 内部只能放 column，冒号画在容器层） */
.wheel-colon {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-secondary);
  pointer-events: none;
  z-index: 3;
}
/* 倒计时滚轮单位标签（分/秒）：垂直居中于各列数字右侧，不遮挡数字 */
.wheel-unit {
  position: absolute;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  pointer-events: none;
  z-index: 3;
}
.schedule-picker {
  flex: 1;
  background: var(--gray6);
  border-radius: var(--radius-sm);
  transition: opacity 0.1s ease;
}
.schedule-picker:active {
  opacity: 0.7;
}
.schedule-picker-value {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}
.schedule-picker-value.placeholder {
  color: var(--text-tertiary);
  font-weight: 400;
}
.countdown-unit {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 8rpx;
}
.schedule-success-text {
  margin-bottom: 12rpx;
  color: #FF9500;
  font-weight: 500;
}

.submit-area {
  padding: 16rpx 0;
}

/* 提交打印任务：50% 屏幕宽度（375rpx）居中（不对其他 btn-primary 生效，弹窗内按钮保持 flex 铺满） */
.submit-area .btn-primary {
  width: 375rpx;
  margin-left: auto;
  margin-right: auto;
}

/* ── Success Modal ── */
.order-number-modal {
  font-family: var(--font-mono);
  font-size: 24rpx;
  font-weight: 600;
  color: var(--blue);
  background: rgba(0, 122, 255, 0.08);
  border-radius: var(--radius-sm);
  padding: 6rpx 24rpx;
  margin-bottom: 12rpx;
  letter-spacing: 0.02em;
}

/* .modal-icon-wrap 已移至 app.wxss 全局定义（me 等页面弹窗共用） */

.modal-buttons {
  display: flex;
  width: 100%;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-half-btn {
  flex: 1;
  min-width: 0;   /* 强制两按钮严格等宽（50%），长文案不被 min-content 撑宽 */
  width: auto;
  padding: 22rpx 0;
  font-size: 26rpx;
}

/* ── v5: 附加服务参数卡 ── */
.ext-params-card {
  margin-bottom: 20rpx;
}

.param-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  gap: 16rpx;
  border-bottom: 0.5px solid var(--separator);
}
.param-row:last-child {
  border-bottom: none;
}

.param-label {
  font-size: 26rpx;
  color: var(--text-secondary);
  width: 120rpx;
  flex-shrink: 0;
}

.param-unit {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.control-input {
  flex: 1;
  height: 56rpx;
  background: var(--gray6);
  border-radius: var(--radius-sm);
  padding: 0 14rpx;
  font-size: 24rpx;
  color: var(--text-primary);
}

/* Read-only glass display value */
.param-value-glass {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  background: var(--glass-light);
  border: var(--glass-border-dark);
  border-radius: var(--radius-sm);
  padding: 8rpx 16rpx;
  box-shadow: var(--glass-rim);
}

/* iOS Toggle Switch */
.ios-switch {
  width: 88rpx;
  height: 52rpx;
  border-radius: 26rpx;
  background: rgba(60, 60, 67, 0.18);
  position: relative;
  transition: background 0.2s ease;
}
.ios-switch.switch-on {
  background: linear-gradient(180deg,
    rgba(52, 199, 89, 1) 0%,
    rgba(34, 180, 68, 1) 100%);
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
}

/* 无障碍打印：加大 + 黄色主题 */
.ios-switch-lg {
  width: 108rpx;
  height: 62rpx;
  border-radius: 31rpx;
}
.ios-switch-lg.switch-on {
  background: linear-gradient(180deg,
    rgba(255, 149, 0, 0.85) 0%,
    rgba(230, 120, 0, 0.92) 100%);
}
.ios-switch-lg .switch-thumb {
  top: 3rpx;
  left: 4rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 28rpx;
}
.ios-switch.ios-switch-lg.switch-on .switch-thumb {
  --sw-px: 47rpx;
}

.switch-thumb {
  position: absolute;
  top: 3rpx;
  left: 3rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  transform: translateX(var(--sw-px, 0rpx));
  background: linear-gradient(180deg,
    rgba(255, 255, 255, 1) 0%,
    rgba(248, 248, 248, 0.95) 100%);
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.18),
    0 1rpx 3rpx rgba(0, 0, 0, 0.10),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
  transition: transform 0.4s cubic-bezier(0.22, 1.85, 0.48, 1);
}
.ios-switch.switch-on .switch-thumb {
  --sw-px: 35rpx;
}
/* 拖动中禁用 transition，thumb 严格跟手 */
.ios-switch.sw-dragging .switch-thumb {
  transition: none !important;
}

/* 深色模式：开关轨道提亮（默认 rgba(60,60,67,0.18) 在深色背景上不可见） */
.theme-dark .ios-switch {
  background: rgba(120, 120, 130, 0.40);
}
.theme-dark .ios-switch.switch-on {
  background: linear-gradient(180deg,
    rgba(52, 199, 89, 0.95) 0%,
    rgba(34, 180, 68, 0.90) 100%);
}
.theme-dark .ios-switch-lg.switch-on {
  background: linear-gradient(180deg,
    rgba(255, 165, 10, 0.98) 0%,
    rgba(255, 135, 0, 0.95) 100%);
}

/* 管理员自行打印开关：加大尺寸 + 蓝色开启态（区别于无障碍打印的橙色） */
.ios-switch.admin-print-sw.switch-on {
  background: linear-gradient(180deg,
    rgba(0, 122, 255, 0.92) 0%,
    rgba(0, 88, 214, 0.96) 100%);
  box-shadow: inset 0 1rpx 2rpx rgba(0, 0, 0, 0.08);
}
.theme-dark .ios-switch.admin-print-sw.switch-on {
  background: linear-gradient(180deg,
    rgba(52, 132, 255, 0.96) 0%,
    rgba(0, 102, 255, 0.95) 100%);
}

.cover-price-tag {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-left: 12rpx;
  flex-shrink: 0;
}
.cover-price-tag.entering {
  animation: coverPriceIn 0.3s cubic-bezier(0.22, 0.61, 0.36, 1) both;
}
.cover-price-tag.exiting {
  animation: coverPriceOut 0.25s ease forwards;
}
/* 普通用户必选标签（打印首页锁定开启） */
.cover-required-tag {
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1;
  color: #fff;
  background: var(--orange);
  border-radius: 999rpx;
  padding: 6rpx 14rpx;
  flex-shrink: 0;
}
@keyframes coverPriceIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes coverPriceOut {
  from { opacity: 1; transform: translateX(0); }
  to   { opacity: 0; transform: translateX(-16rpx); }
}

/* 派送选项折叠动画 */
.delivery-collapse {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.25s ease;
}
.delivery-collapse.delivery-open {
  max-height: 200rpx;
  opacity: 1;
}

/* Picker trigger — glass chip */
.picker-trigger {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
  background: var(--glass-regular);
  border: var(--glass-border-dark);
  border-radius: var(--radius-sm);
  padding: 10rpx 16rpx;
  box-shadow: var(--glass-shadow-sm), var(--glass-rim);
  transition: transform 0.1s ease, background-color 0.1s ease;
}
.picker-arrow {
  font-size: 28rpx;
  color: var(--text-quaternary);
}

/* Picker dropdown — animated expand/collapse */
.picker-sheet {
  overflow: hidden;
  max-height: 0;
  opacity: 0;
  background: var(--gray6);
  border-radius: var(--radius-md);
  padding: 0 4rpx;
  margin: 0 0 0 136rpx;
  transition: max-height 0.35s cubic-bezier(0.25, 0.1, 0.25, 1),
              opacity 0.25s cubic-bezier(0.25, 0.1, 0.25, 1),
              margin 0.35s cubic-bezier(0.25, 0.1, 0.25, 1),
              padding 0.35s cubic-bezier(0.25, 0.1, 0.25, 1);
}
.picker-sheet.picker-expanded {
  max-height: 500rpx;
  opacity: 1;
  padding: 4rpx;
  margin: 4rpx 0 8rpx 136rpx;
}
.picker-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-primary);
  border-radius: var(--radius-sm);
  font-weight: 500;
}
.picker-option:active {
  background: rgba(0, 122, 255, 0.08);
}
.picker-selected {
  background: var(--blue);
  color: #fff;
  font-weight: 600;
}
.picker-pct {
  font-size: 24rpx;
  color: var(--text-tertiary);
}
.picker-selected .picker-pct {
  color: rgba(255,255,255,0.8);
}

/* Urgency colors */
.urgency-high { color: var(--red) !important; font-weight: 600; }
.urgency-mid  { color: var(--orange) !important; font-weight: 600; }

/* ═══════════════ Dark Mode ═══════════════ */
.theme-dark .duplex-toggle {
  background-color: rgba(255, 255, 255, 0.08);
}
.theme-dark .progress-track {
  background-color: rgba(255, 255, 255, 0.10);
}
.theme-dark .file-controls {
  border-top-color: rgba(84, 84, 88, 0.35);
}
.theme-dark .inline-header {
  border-bottom-color: rgba(84, 84, 88, 0.30);
}
.theme-dark .add-file-btn {
  background: var(--glass-regular);
  border-color: rgba(0, 122, 255, 0.20);
}
.theme-dark .add-file-btn:active {
  background: rgba(0, 122, 255, 0.12);
}
.theme-dark .range-line-input {
  background: rgba(255, 255, 255, 0.06);
  border-color: rgba(84, 84, 88, 0.40);
  color: var(--text-primary);
}
.theme-dark .range-line-input.range-input-err {
  background: rgba(255, 59, 48, 0.08);
}
.theme-dark .page-analysis-bar {
  background: var(--glass-regular);
  border-color: rgba(84, 84, 88, 0.35);
}
.theme-dark .page-analysis-bar.confirmed {
  background: rgba(52, 199, 89, 0.10);
  border-color: rgba(52, 199, 89, 0.20);
}
.theme-dark .page-analysis-bar.offline {
  background: rgba(255, 149, 0, 0.10);
  border-color: rgba(255, 149, 0, 0.20);
}
.theme-dark .picker-option:active {
  background: rgba(0, 122, 255, 0.14);
}
.theme-dark .param-row {
  border-bottom-color: rgba(84, 84, 88, 0.30);
}
