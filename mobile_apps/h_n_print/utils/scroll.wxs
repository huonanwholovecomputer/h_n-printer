// WXS 版 FlingEngine：视图层直驱滚动（全程 0 setData）
// 移植自 APP www/app.js 的 FlingEngine（真机调好手感的参数）：
//   事件响应 + requestAnimationFrame 物理循环 + setStyle 全部在视图层完成，
//   逻辑层只通过 scrollConfig（change:prop）低频同步滚动边界。
// 注意：WXS 是 ES5 子集 —— 只能 var/function，状态全部放 getState()。

var CFG = {
  power: 0.9,               // 摩擦幂次 p：dv/dt = -k*|v|^p，越接近 1 低速段拖尾越长
  friction: 0.0018,         // 摩擦系数 k（px/ms 量纲）
  lowSpeedThreshold: 0.12,  // 低于该速度进入低速段（px/ms）
  lowSpeedFactor: 0.6,      // 低速段摩擦乘数（越小低速溜得越久）
  releaseWindowMs: 50,      // 抬手初速的最远采样窗口 ms
  maxVelocity: 8,           // 单次甩动速度上限 px/ms
  boost: true,              // 连续同向甩动速度叠加（模拟 Chromium Fling Booster）
  boostMinSpeed: 0.35,      // 触发叠加的最低速度 px/ms
  boostWindow: 300,         // 可叠加的时间窗口 ms
  stopVelocity: 0.01,       // 低于此速度停止（px/ms）
  rubberMax: 80,            // 惯性撞边的最大形变 px
  edgeSpringOmega: 0.016,   // 弹簧自然角频率 rad/ms
  edgeSpringDamping: 0.5,   // 压入段阻尼比（减震器）
  edgeRecoverMsPerPx: 13,   // 恢复阶段时长 ms/px
  edgeRecoverAccel: 0.25,   // 恢复段加速占比（短加速、长减速）
  snapSpd: 0.4,             // 越界回弹速度
  dampMax: 130,             // 拖拽越界阻尼上限 px
  settleOmega: 0.012,       // 内容变短收尾：跟随弹簧角频率 rad/ms
  settleDamping: 0.9        // 内容变短收尾：阻尼比（接近临界，快速到位无过冲）
};

function sign(v) {
  if (v > 0) return 1;
  if (v < 0) return -1;
  return 0;
}

function ensureState(state) {
  if (!state.inited) {
    state.inited = true;
    state.y = 0;
    state.minY = 0;
    state.maxY = 0;
    state.scrollerH = 0;
    state.contentH = 0;
    state.padY = 0;            // 底部留白（逻辑层 _bottomPad + _tabOverlayPx，px）
    state.padYSet = false;     // false = 还没拿到可信的 padY（老页面配置里没有 padPx）
    state.vel = 0;
    state.inDecel = false;
    state.running = false;
    state.trackId = -1;
    state.lastY = 0;
    state.lastT = 0;
    state.moved = false;
    state.samples = [];
    state.startX = 0;
    state.startY = 0;
    state.dirLocked = false;
    state.horizontal = false;
    state.prevFlingVel = 0;
    state.lastFlingT = 0;
    state.spring = null;
    // 内层滚动框（订单详情的文件列表 / 打印页的文件列表）：由本文件直驱 translateY
    state.nbSel = '';          // 逻辑层下发：内层滚动框选择器（'' = 本页没有内层列表）
    state.nbTrackSel = '';     // 逻辑层下发：内层内容 track 选择器
    state.nb = null;           // 本次手势命中的内层框 { idx, box, track, y, maxY, v, active, lastT }
    state.nbRun = false;       // 内层惯性循环在跑
    state.touching = false;
    state.cbBucket = -1;
    state.closePicker = false;
  }
}

function dampShift(d) {
  var max = CFG.dampMax;
  var s = d >= 0 ? 1 : -1;
  return s * max * (1 - Math.exp(-Math.abs(d) / (max * 1.6)));
}

// 拖拽/回弹渲染：越界形变按阻尼曲线压缩显示
function renderY(state) {
  var y = state.y;
  if (y < state.minY) return state.minY - dampShift(state.minY - y);
  if (y > state.maxY) return state.maxY + dampShift(y - state.maxY);
  return y;
}

// 抬手速度采样：只保留最近 ~120ms，避免 Array.shift
function pushSample(state, t, y) {
  state.samples.push({ t: t, y: y });
  var keep = [];
  var n = state.samples.length;
  for (var i = n - 1; i >= 0; i--) {
    if (t - state.samples[i].t > 120) break;
    keep.push(state.samples[i]);
  }
  var out = [];
  for (var j = keep.length - 1; j >= 0; j--) out.push(keep[j]);
  state.samples = out;
}

function estimateReleaseVel(state) {
  var samples = state.samples;
  if (!samples || samples.length < 2) return;
  var last = samples[samples.length - 1];
  var best = 0;
  var start = samples.length - 1;
  for (var i = samples.length - 1; i >= 0; i--) {
    if (last.t - samples[i].t > CFG.releaseWindowMs) break;
    start = i;
  }
  var spanWin = last.t - samples[start].t;
  if (spanWin >= 8) best = -(last.y - samples[start].y) / spanWin;
  var prev = samples[samples.length - 2];
  var spanInst = last.t - prev.t;
  if (spanInst >= 8) {
    var inst = -(last.y - prev.y) / spanInst;
    if (Math.abs(inst) > Math.abs(best)) best = inst;
  }
  if (Math.abs(best) > Math.abs(state.vel)) state.vel = best;
  state.samples = [];
}

// 从**真实布局**校正滚动边界（滚动范围 = 内容高 - 视口高 + 底部留白）
//
// 为什么必须这样做（2026-10-25 现场：偶发的「最顶端内容位置不对 / 最底端一大块空白」）：
// 逻辑层 `_measure()` 推来的 maxY 是**某一瞬间的快照**，而这一页的内容高随时在变 ——
// 接单设备卡异步出现/消失、保留期文案由 /api/retention_config 回填、文件列表高度补间、
// 页数确认后卡片在「文本 ↔ 数字网格」之间换形态、logo 图片解码后 widthFix 才长出高度……
// 任何一次变化之后没来得及重测，maxY 就偏大（滚到底多出一块空白）或偏小（最后一段永远
// 滚不到）。以前只在逻辑层按事件补测，漏一个触发点就复现一次。
// 现在：**视图层在手势入口（touchstart）直接量真实节点**（两个 rect，成本可忽略），
// 量到就以它为准，量不到才沿用逻辑层的快照（桩环境/首帧渲染都能照常工作）。
// 同时把「超出范围的 state.y」钳回边界内，避免停在越界位置后表现为大块空白。
//
// ⚠ 只允许在 touch 事件里调用：微信的 `getBoundingClientRect()` 只在 touch 回调中保证
// 拿到当前布局值（本文件其它调用也都在 touchstart），在 change:prop 观察器里可能给旧帧/0。
function syncGeometry(state, owner) {
  var scroller = owner.selectComponent('.scroller');
  var content = owner.selectComponent('.scroll-content');
  if (!scroller || !content) return false;
  if (typeof scroller.getBoundingClientRect !== 'function') return false;
  if (typeof content.getBoundingClientRect !== 'function') return false;
  var r1 = scroller.getBoundingClientRect();
  var r2 = content.getBoundingClientRect();
  if (!r1 || !r2) return false;
  var vp = r1.height || 0;
  var ch = r2.height || 0;
  if (vp <= 0 || ch <= 0) return false;
  state.scrollerH = vp;
  state.contentH = ch;
  var pad = typeof state.padY === 'number' ? state.padY : 0;
  state.maxY = Math.max(0, ch - vp + pad);
  return true;
}

// 渲染：内容 transform + logo 缩放，全部 setStyle 直写视图层
// 内容用 2D translateY：微信对 will-change/translate3d 会预分配固定尺寸 GPU 层，
// 文件列表高度动态变化时可能截断内容（index.wxss 旧注释记录过该坑），2D 无此问题。
//
// ⚠ 不复写 `.header-area` 的 padding（旧实现在 ratio≥1 时把 padding 从 40rpx 改成 8rpx）：
// 那是在**滚动过程中改变内容总高**（64rpx≈36px），等于让 maxY 随滚动位置漂移 —— 上面
// syncGeometry 量到的高度也就跟着上下文变化，属于自找的几何不一致。logo 的缩放已经足够
// 表达"页头让位"，而那段 padding 在 y>400 时本来就在视口外（看不见），去掉零视觉损失。
function applyRender(state, owner, rawY) {
  var content = owner.selectComponent('.scroll-content');
  if (content) {
    content.setStyle({ transform: 'translateY(' + (-rawY) + 'px)' });
  }
  var real = state.maxY > 0 ? Math.min(Math.max(0, rawY), state.maxY) : 0;
  var ratio = state.maxY > 0 ? Math.min(real / 400, 1) : 0;
  var logo = owner.selectComponent('.logo-wrap');
  if (logo) {
    logo.setStyle({ transform: 'scale(' + (1 - ratio * 0.7) + ')' });
  }
  // 分桶节流通知逻辑层（每 100px 一次），供回顶按钮等阈值类 UI 使用
  var bucket = Math.floor(real / 100);
  if (bucket !== state.cbBucket) {
    state.cbBucket = bucket;
    owner.callMethod('onWxsScroll', { y: real, ratio: ratio });
  }
}

// ---- 边界弹簧：两段式（真实弹簧积分压入 + 非对称 S 曲线恢复）----

function startSpring(state, owner, target, dir, v0, x0) {
  state.running = false;
  state.inDecel = false;
  state.vel = 0;
  var vCap = CFG.rubberMax * CFG.edgeSpringOmega;
  var initV = Math.max(0, Math.min(vCap, v0 || 0));
  var givenX = Math.max(0, Math.min(CFG.rubberMax, x0 || 0));
  if (givenX > 0) {
    // 拖拽/滚动越界松手：直接从当前可见形变走 S 曲线恢复（无压入段）
    state.spring = {
      target: target,
      dir: dir,
      x: givenX,
      xMax: givenX,
      vx: 0,
      compressing: false,
      t0: getDate().getTime(),
      durR: Math.min(640, Math.max(180, givenX * CFG.edgeRecoverMsPerPx))
    };
  } else if (initV < 0.02) {
    state.y = target;
    state.spring = null;
    applyRender(state, owner, renderY(state));
    return;
  } else {
    // 惯性撞击：弹簧积分压入，初速 = 到达边界的速度
    state.spring = {
      target: target,
      dir: dir,
      x: 0,
      xMax: 0,
      vx: initV,
      compressing: true,
      t0: getDate().getTime(),
      durR: 0
    };
  }
  state.y = target + dir * state.spring.x;
  state.lastT = getDate().getTime();
  state.running = true;
  owner.requestAnimationFrame(function () { springTick(state, owner); });
}

function springTick(state, owner) {
  if (!state.running || !state.spring || state.spring.settle) return;
  var s = state.spring;
  var now = getDate().getTime();
  if (s.compressing) {
    var dt = Math.min(32, Math.max(1, now - s.t0));
    s.t0 = now;
    var w = CFG.edgeSpringOmega;
    var z = CFG.edgeSpringDamping;
    // x'' = -w^2*x - 2*z*w*x'，速度连续，不会"猛地缩进去"
    var a = -w * w * s.x - 2 * z * w * s.vx;
    s.vx += a * dt;
    s.x += s.vx * dt;
    if (s.x >= CFG.rubberMax) {
      s.x = CFG.rubberMax;
      s.vx = 0;
    }
    if (s.vx <= 0) {
      s.xMax = s.x;
      s.compressing = false;
      s.t0 = now;
      s.durR = Math.min(640, Math.max(180, s.xMax * CFG.edgeRecoverMsPerPx));
    }
  } else {
    // 非对称 S 曲线：前 edgeRecoverAccel 快速起速，后段长时间平滑减速到停
    var p = Math.min(1, (now - s.t0) / s.durR);
    var accel = CFG.edgeRecoverAccel;
    var eased;
    if (p < accel) {
      var u = p / accel;
      eased = accel * u * u * u;
    } else {
      var u2 = (p - accel) / (1 - accel);
      eased = accel + (1 - accel) * (1 - Math.pow(1 - u2, 3));
    }
    s.x = s.xMax * (1 - eased);
  }
  // 目标实时钳制到当前边界：内容变短（收尾弹簧）期间 maxY 会持续缩小，
  // 弹簧目标跟着走 → 单段平滑移动，不会停在旧目标上
  s.target = Math.max(state.minY, Math.min(s.target, state.maxY));
  state.y = s.target + s.dir * s.x;
  applyRender(state, owner, state.y); // 越界形变 1:1 渲染
  if (!s.compressing && (now - s.t0) >= s.durR) {
    // 防御：动画期间 maxY 可能已被更新（内容变短），旧目标会停在越界处 → 钳制到当前边界
    state.y = Math.min(state.y, state.maxY);
    state.spring = null;
    state.running = false;
    applyRender(state, owner, state.y);
    return;
  }
  owner.requestAnimationFrame(function () { springTick(state, owner); });
}

// ---- 内容变短收尾：阻尼弹簧实时跟随 maxY ----
// 对位置/速度做积分，目标每帧直接读当前 maxY：
// 目标持续变化只会改变加速度（位置与速度连续），任何时刻都不会出现离散跳变/闪现，
// 中间重测只更新 maxY，弹簧自行平滑收敛到新底部（单段移动，无两段式）。

function startSettleFollow(state, owner) {
  state.running = false;
  state.inDecel = false;
  state.vel = 0;
  state.spring = { settle: true, vel: 0, lastT: getDate().getTime() };
  state.running = true;
  owner.requestAnimationFrame(function () { settleTick(state, owner); });
}

function settleTick(state, owner) {
  if (!state.running || !state.spring || !state.spring.settle) return;
  var s = state.spring;
  var now = getDate().getTime();
  var dt = Math.min(32, Math.max(1, now - s.lastT));
  s.lastT = now;
  var target = state.maxY; // 目标实时读取（内容持续变短 → 弹簧持续跟随）
  var w = CFG.settleOmega;
  var z = CFG.settleDamping;
  var a = -w * w * (state.y - target) - 2 * z * w * s.vel;
  s.vel += a * dt;
  state.y += s.vel * dt;
  applyRender(state, owner, state.y);
  if (Math.abs(state.y - target) < 0.5 && Math.abs(s.vel) < 0.02) {
    state.y = target;
    state.spring = null;
    state.running = false;
    applyRender(state, owner, state.y);
    return;
  }
  owner.requestAnimationFrame(function () { settleTick(state, owner); });
}

// ---- 惯性（可调曲线：幂律摩擦 + 低速拖尾）----

function startDecel(state, owner) {
  state.inDecel = true;
  state.running = true;
  state.lastT = getDate().getTime();
  owner.requestAnimationFrame(function () { decelTick(state, owner); });
}

function decelTick(state, owner) {
  if (!state.running || !state.inDecel) return;
  var now = getDate().getTime();
  var dt = Math.max(1, now - state.lastT);
  state.lastT = now;
  var speed = Math.abs(state.vel);
  var k = CFG.friction;
  if (speed < CFG.lowSpeedThreshold) k *= CFG.lowSpeedFactor;
  var decel = k * Math.pow(speed, CFG.power);
  state.vel -= sign(state.vel) * decel * dt;
  state.y += state.vel * dt;
  if (state.y < state.minY) {
    startSpring(state, owner, state.minY, -1, Math.abs(state.vel), 0);
    return;
  }
  if (state.y > state.maxY) {
    startSpring(state, owner, state.maxY, 1, Math.abs(state.vel), 0);
    return;
  }
  if (Math.abs(state.vel) < CFG.stopVelocity) {
    state.inDecel = false;
    state.running = false;
    applyRender(state, owner, state.y);
    return;
  }
  applyRender(state, owner, state.y);
  owner.requestAnimationFrame(function () { decelTick(state, owner); });
}

function snapBack(state, owner) {
  state.running = false;
  state.inDecel = false;
  state.spring = null;
  state.running = true;
  owner.requestAnimationFrame(function () { snapTick(state, owner); });
}

function snapTick(state, owner) {
  if (!state.running) return;
  var target = state.y < state.minY ? state.minY : (state.y > state.maxY ? state.maxY : state.y);
  if (target === state.y) {
    state.running = false;
    applyRender(state, owner, state.y);
    return;
  }
  state.y += (target - state.y) * CFG.snapSpd;
  if (Math.abs(state.y - target) < 0.3) {
    state.y = target;
    state.running = false;
    applyRender(state, owner, state.y);
    return;
  }
  applyRender(state, owner, renderY(state));
  owner.requestAnimationFrame(function () { snapTick(state, owner); });
}

// ---- 程序化滚动（回顶 / 滚到指定区块），由逻辑层 scrollCmd 触发 ----

function scrollTo(state, owner, targetY, duration) {
  state.running = false;
  state.inDecel = false;
  state.spring = null;
  var target = Math.max(state.minY, Math.min(targetY, state.maxY));
  if (duration <= 0) {
    state.y = target;
    applyRender(state, owner, state.y);
    return;
  }
  var startY = state.y;
  var diff = target - startY;
  if (Math.abs(diff) < 1) {
    state.y = target;
    applyRender(state, owner, state.y);
    return;
  }
  var startT = getDate().getTime();
  state.running = true;
  owner.requestAnimationFrame(function () {
    scrollTick(state, owner, startY, diff, startT, duration);
  });
}

function scrollTick(state, owner, startY, diff, startT, duration) {
  if (!state.running) return;
  var p = Math.min(1, (getDate().getTime() - startT) / duration);
  var eased = 1 - Math.pow(1 - p, 3); // easeOutCubic
  state.y = startY + diff * eased;
  applyRender(state, owner, state.y);
  if (p < 1) {
    owner.requestAnimationFrame(function () {
      scrollTick(state, owner, startY, diff, startT, duration);
    });
  } else {
    state.running = false;
  }
}

function startPhysics(state, owner) {
  estimateReleaseVel(state);
  var maxV = CFG.maxVelocity;
  state.vel = Math.max(-maxV, Math.min(maxV, state.vel));
  var now = getDate().getTime();
  if (CFG.boost && state.prevFlingVel !== 0 && sign(state.prevFlingVel) === sign(state.vel)
      && Math.abs(state.prevFlingVel) >= CFG.boostMinSpeed && Math.abs(state.vel) >= CFG.boostMinSpeed
      && now - state.lastFlingT <= CFG.boostWindow) {
    state.vel += state.prevFlingVel;
    state.vel = Math.max(-maxV, Math.min(maxV, state.vel));
  }
  state.prevFlingVel = state.vel;
  state.lastFlingT = now;
  if (state.y < state.minY) {
    startSpring(state, owner, state.minY, -1, Math.abs(state.vel), dampShift(state.minY - state.y));
    return;
  }
  if (state.y > state.maxY) {
    startSpring(state, owner, state.maxY, 1, Math.abs(state.vel), dampShift(state.y - state.maxY));
    return;
  }
  if (Math.abs(state.vel) < CFG.stopVelocity) {
    snapBack(state, owner);
    return;
  }
  startDecel(state, owner);
}

// ---- 内层滚动框（订单详情的文件列表 / 打印页的文件列表）----
// 为什么内层不再交给原生 scroll-view 自己滚（2026-11-09 现场，用户报了一个月）：
//   ① 详情列表只有 max-height（高度随内容、到上限封顶），scroll-view 拿不到确定高度就不会
//      在内部滚动，只会被外层 `.order-card-detail` 的 overflow:hidden 裁掉 —— 第 6 个文件
//      永远看不到（旧版 hint 写着「列表可上下滑动」却滑不动）；
//   ② 原生框滚到边之后没有任何回调能「把事件交还外层」：加 catchtouchmove 会把 touchmove
//      整个吃掉（外层再也拿不到滚动），不 catch 又会在贴边后继续被内层吞掉。现场表现就是
//      「滑到底/顶，整个页面不跟着动」。
// 所以内层内容包一层 track，由本文件 setStyle 直驱 translateY（与页面同一套物理），
// 偏移与边界全部来自两个 rect，**不需要**逻辑层 bindscroll → setData → change:prop 的三跳同步。
// 规则（一次手势内）：内层先吃 → 内层贴边后余量立刻交给外层 → 反向外层贴边再交还内层。
// 末段由谁消费，抬手后的惯性就归谁；内层惯性撞边后余速交给外层继续翻页。
function rectBottom(r) {
  return typeof r.bottom === 'number' ? r.bottom : r.top + (r.height || 0);
}

function rectRight(r) {
  return typeof r.right === 'number' ? r.right : r.left + (r.width || 0);
}

// 命中内层滚动框：逐个量框与 track 的 rect
// （同一页可能同时展开多张订单卡，selectComponent 只能拿到第一个，必须用 selectAllComponents）
// 触点落在框内、且内容确实超框才算命中；命中后 y = 框顶 - 内容顶 = 当前的内部偏移。
function measureNested(state, owner, point) {
  if (!state.nbSel) return null;
  var boxes = null;
  if (typeof owner.selectAllComponents === 'function') {
    boxes = owner.selectAllComponents(state.nbSel);
  } else if (typeof owner.selectComponent === 'function') {
    var single = owner.selectComponent(state.nbSel);
    if (single) boxes = [single];
  }
  if (!boxes || !boxes.length) return null;
  for (var i = 0; i < boxes.length; i++) {
    var box = boxes[i];
    if (!box || typeof box.getBoundingClientRect !== 'function') continue;
    var br = box.getBoundingClientRect();
    if (!br || !(br.height > 0)) continue;
    if (point.clientY < br.top || point.clientY > rectBottom(br)) continue;
    if (point.clientX < br.left || point.clientX > rectRight(br)) continue;
    var track = null;
    if (state.nbTrackSel && typeof box.selectComponent === 'function') {
      track = box.selectComponent(state.nbTrackSel);
    }
    if (!track || typeof track.getBoundingClientRect !== 'function') continue;
    var tr = track.getBoundingClientRect();
    if (!tr || !(tr.height > 0)) continue;
    var maxY = tr.height - br.height;
    if (maxY < 1) return null;      // 内容没超框 → 本框不可滚，整页照常滚
    var o = br.top - tr.top;
    if (o !== o || o < 0) o = 0;    // NaN 防御
    if (o > maxY) o = maxY;
    return { idx: i, box: box, track: track, y: o, maxY: maxY, v: 0, active: true, lastT: 0 };
  }
  return null;
}

function nbApply(state, owner) {
  var nb = state.nb;
  if (!nb || !nb.track) return;
  nb.track.setStyle({ transform: 'translateY(' + (-nb.y) + 'px)' });
}

// 内层吃掉 need（>0 内容下移，<0 内容上移），返回实际吃掉的量
function nbEat(nb, need) {
  var room = need > 0 ? nb.maxY - nb.y : nb.y;
  if (room <= 0.0001) return 0;
  var take = need > 0 ? Math.min(need, room) : -Math.min(-need, room);
  nb.y += take;
  if (nb.y < 0) nb.y = 0;
  if (nb.y > nb.maxY) nb.y = nb.maxY;
  return take;
}

// 外层在该方向上是否已经到边（到边才允许把滚动交还内层，否则一次手势里会来回跳）
// need > 0 = 手指上滑（外层 y 增大，往底部走）；need < 0 = 手指下滑（外层 y 减小，往顶部走）
function outerAtEdge(state, need) {
  if (need > 0) return state.maxY > 0 && state.y >= state.maxY - 0.5;
  return state.y <= state.minY + 0.5;
}

// 内层自己的惯性（与页面同一套幂律摩擦）：撞到内层边界后，剩下的速度交给外层继续翻，
// 这样「短列表只有几十像素行程」的场合也不会出现"一抬手就整段停住"的断裂感。
function startNbDecel(state, owner, nb) {
  state.running = false;
  state.inDecel = false;
  state.spring = null;
  state.nbRun = true;
  nb.lastT = getDate().getTime();
  owner.requestAnimationFrame(function () { nbDecelTick(state, owner, nb); });
}

function nbDecelTick(state, owner, nb) {
  if (!state.nbRun) return;
  var now = getDate().getTime();
  var dt = Math.max(1, now - nb.lastT);
  nb.lastT = now;
  var speed = Math.abs(nb.v);
  var k = CFG.friction;
  if (speed < CFG.lowSpeedThreshold) k *= CFG.lowSpeedFactor;
  nb.v -= sign(nb.v) * k * Math.pow(speed, CFG.power) * dt;
  nb.y += nb.v * dt;
  if (nb.y < 0 || nb.y > nb.maxY) {
    nb.y = nb.y < 0 ? 0 : nb.maxY;
    nbApply(state, owner);
    var carry = nb.v;
    nb.v = 0;
    state.nbRun = false;
    state.nb = nb;
    // 余速交给外层（方向语义一致：nb.v > 0 = 内容上移 = 外层 y 增大）
    if (Math.abs(carry) >= CFG.stopVelocity && state.maxY > state.minY) {
      state.vel = carry;
      startDecel(state, owner);
    }
    return;
  }
  if (Math.abs(nb.v) < CFG.stopVelocity) {
    nb.v = 0;
    state.nbRun = false;
    nbApply(state, owner);
    return;
  }
  nbApply(state, owner);
  owner.requestAnimationFrame(function () { nbDecelTick(state, owner, nb); });
}

module.exports = {
  // 逻辑层 setData(scrollConfig) → 视图层同步滚动边界（低频，不走每帧）
  onConfig: function (newValue, oldValue, ownerInstance, instance) {
    var state = ownerInstance.getState();
    if (!state) return;
    ensureState(state);
    if (!newValue) return;
    state.minY = newValue.minY || 0;
    state.maxY = newValue.maxY || 0;
    state.scrollerH = newValue.scrollerH || 0;
    state.contentH = newValue.contentH || 0;
    // 内层滚动框选择器（订单详情 / 打印页的文件列表）：由视图层直驱，不再需要逻辑层
    // 用 bindscroll → setData → change:prop 三跳同步「贴顶/贴底」——那三跳就是贴边判定的死区：
    // 内层已经到底，视图层还拿到旧的「可滚」，于是这一帧谁都不动（用户说的「滑到底页面不跟着走」）。
    if (newValue.nestedSel !== undefined) state.nbSel = newValue.nestedSel || '';
    if (newValue.nestedTrackSel !== undefined) state.nbTrackSel = newValue.nestedTrackSel || '';
    state.closePicker = !!newValue.closePicker;
    // 底部留白（px）：逻辑层显式下发（_bottomPad + _tabOverlayPx）；老页面配置里没有这个
    // 字段时，从这一次的 maxY 反推一次（maxY = contentH - scrollerH + pad）并记住 ——
    // 之后 syncGeometry 才能用"真实内容高"重算出等价口径的 maxY。
    if (typeof newValue.padPx === 'number') {
      state.padY = Math.max(0, newValue.padPx);
      state.padYSet = true;
    } else if (!state.padYSet && state.contentH > state.scrollerH) {
      state.padY = Math.max(0, state.maxY - (state.contentH - state.scrollerH));
      state.padYSet = true;
    }
    // ⚠ 这里**不**调 syncGeometry：微信的 `getBoundingClientRect()` 只在 touch 事件的
    // 回调里保证拿到当前布局值（仓库原有用法都在 touchstart，见 scroll.wxs 内其它调用），
    // 在 change:prop 的观察器里可能返回旧帧/0。旧值会直接把 maxY 写错（0 无害、旧值有害），
    // 所以测量只放在手势入口（touchstart）做；配置路径只消费逻辑层推来的快照。
    // 负向越界（状态被重置/回弹残留）同样钳回边界，静止态不该停在 minY 之外。
    if (!state.touching && !state.inDecel && state.y < state.minY) {
      state.y = state.minY;
    }
    // 内容变短（maxY 减小）：阻尼弹簧实时跟随目标，平滑收到新底部。
    // 弹簧对位置/速度积分（无离散跳变）→ 无论何时收起（静止/滚动中/弹回中）
    // 都不会闪现，也不会出现两段式移动；中间重测只更新 maxY，弹簧自行跟随。
    if (state.y > state.maxY) {
      if (!state.touching && !state.inDecel) {
        if (!(state.spring && state.spring.settle)) {
          startSettleFollow(state, ownerInstance);
        }
      } else {
        // 触摸/惯性中：只钳制渲染（renderY 带阻尼），松手后由 snapBack/弹簧收尾
        applyRender(state, ownerInstance, renderY(state));
      }
    } else {
      // 内容重新变长：中止进行中的收尾弹簧（否则会继续向旧目标移动）
      if (state.spring && state.spring.settle) {
        state.spring = null;
        state.running = false;
      }
      applyRender(state, ownerInstance, renderY(state));
    }
  },
  touchstart: function (event, ownerInstance) {
    var state = ownerInstance.getState();
    if (!state) return;
    ensureState(state);
    var touches = event.touches || [];
    if (touches.length === 0) return;
    state.running = false;   // 停止一切惯性/回弹循环（下一次 rAF 自然退出）
    state.inDecel = false;
    state.spring = null;
    state.dirLocked = false;
    state.horizontal = false;
    state.moved = false;
    state.touching = true;
    // 手势开始前用真实布局刷新边界，并把 y 钳回 [minY, maxY]：
    // 上一次内容变化（删文件/设备卡消失/页数确认）之后没来得及重测的范围，
    // 在这一刻自愈 —— 否则手指会从"越界位置"开始，表现为顶端/底端位置不对。
    syncGeometry(state, ownerInstance);
    if (state.y > state.maxY) state.y = state.maxY;
    if (state.y < state.minY) state.y = state.minY;
    var t0 = touches[0];
    state.trackId = t0.identifier;
    state.lastY = t0.clientY;
    state.lastT = getDate().getTime();
    state.startX = t0.clientX;
    state.startY = t0.clientY;
    state.vel = 0;
    state.samples = [{ t: state.lastT, y: t0.clientY }];
    // me 页：触摸开始即收起 fixed 定位的分页下拉，避免滚动时错位
    if (state.closePicker) {
      ownerInstance.callMethod('onWxsTouchStart', {});
    }
    // 内层滚动框：触点落在框内且内容确实超框 → 本手势由内层先消费
    // （逐个量 rect；同一页可能同时展开多张订单卡，measureNested 会跳过不可滚的框）
    state.nbRun = false;
    state.nb = null;
    state.nb = measureNested(state, ownerInstance, t0);
  },
  touchmove: function (event, ownerInstance) {
    var state = ownerInstance.getState();
    if (!state || !state.inited) return true;
    var touches = event.touches || [];
    if (touches.length === 0) return true;
    if (state.trackId < 0) return true;
    var t0 = touches[0];
    // 方向锁定：横向手势让出（左滑卡片/滑块等）
    var dx = t0.clientX - state.startX;
    var dy = t0.clientY - state.startY;
    if (!state.dirLocked) {
      if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
        state.dirLocked = true;
        if (Math.abs(dx) > Math.abs(dy)) {
          state.horizontal = true;
          return true;
        }
      } else {
        return true;
      }
    }
    if (state.horizontal) return true;
    var now = getDate().getTime();
    var ddy = t0.clientY - state.lastY;
    var dt = Math.max(1, now - state.lastT);
    // ---- 嵌套滚动接力（内层文件列表 ↔ 外层页面）----
    // ddy < 0：手指上滑（内容上移：外层 y 增大 / 内层偏移增大）
    // ddy > 0：手指下滑（内容下移：外层 y 减小 / 内层偏移减小）
    // 逐帧规则：内层先吃本帧位移，吃不下（到边）的余量在同一帧交给外层；
    // 反过来，外层已经到边时把位移交还内层。两边位置都是精确量出来的，
    // 不依赖任何逻辑层同步的贴边状态 ⇒ 没有死区，也不会双倍位移。
    // 门槛用 ddy !== 0（不是 >0.5px）：慢速拖动单帧位移常常不到 1px，
    // 若把这些帧跳过，它们会整帧落进外层分支 ⇒ 内层还在滚、外层也动 = 双部位移。
    if (ddy === 0) {
      state.lastY = t0.clientY;
      state.lastT = now;
      return true;
    }
    if (state.nb) {
      var nb = state.nb;
      var need = -ddy;
      var take = 0;
      if (nb.active || outerAtEdge(state, need)) {
        take = nbEat(nb, need);
      }
      if (take !== 0) {
        nbApply(state, ownerInstance);
        nb.active = true;
      }
      var rest = need - take;
      if (rest === 0) {
        // 内层吃下整帧：外层一动不动（用户要的「先滚列表」）
        state.vel = state.vel * 0.6 + (-ddy / dt) * 0.4;
        state.lastY = t0.clientY;
        state.lastT = now;
        pushSample(state, now, t0.clientY);
        return true;
      }
      // 内层到边：余量交给外层续滚（只给余量，不是整帧）
      nb.active = false;
      ddy = -rest;
    }
    if (Math.abs(ddy) > 0.5) state.moved = true;
    state.y -= ddy;
    var inst = -ddy / dt;
    state.vel = state.vel * 0.6 + inst * 0.4;
    state.lastY = t0.clientY;
    state.lastT = now;
    pushSample(state, now, t0.clientY);
    applyRender(state, ownerInstance, renderY(state));
    return false; // preventDefault + stopPropagation
  },
  touchend: function (event, ownerInstance) {
    var state = ownerInstance.getState();
    if (!state || !state.inited) return;
    state.dirLocked = false;
    state.horizontal = false;
    state.touching = false;
    var touches = event.touches || [];
    if (touches.length > 0) {
      state.trackId = -1; // 还有手指按住，等全部抬起再启动惯性
      return;
    }
    state.trackId = -1;
    // 谁吃下最后一帧，抬手后的惯性就归谁（内层自己滑，外层不动）
    var nb = state.nb;
    if (nb && nb.active) {
      estimateReleaseVel(state);
      nb.v = Math.max(-CFG.maxVelocity, Math.min(CFG.maxVelocity, state.vel));
      state.vel = 0;
      if (Math.abs(nb.v) >= CFG.stopVelocity) {
        startNbDecel(state, ownerInstance, nb);
      }
      return;
    }
    startPhysics(state, ownerInstance);
  },
  onCmd: function (newValue, oldValue, ownerInstance, instance) {
    var state = ownerInstance.getState();
    if (!state) return;
    ensureState(state);
    if (!newValue) return;
    var dur = newValue.dur || 280;
    if (newValue.mode === 'section') {
      // 滚到指定区块：内容坐标 = 区块可视位置 - 容器可视位置 + 当前滚动量
      var scroller = ownerInstance.selectComponent('.scroller');
      var section = ownerInstance.selectComponent(newValue.section);
      if (scroller && section) {
        var r1 = scroller.getBoundingClientRect();
        var r2 = section.getBoundingClientRect();
        if (r1 && r2) {
          var offset = newValue.offset || 0;
          var targetY = (r2.top - r1.top) + state.y + offset;
          scrollTo(state, ownerInstance, targetY, dur);
        }
      }
    } else if (newValue.mode === 'to') {
      scrollTo(state, ownerInstance, newValue.y, dur);
    }
  }
};
